  "_noticeComment": "Phase 18C PKG-003: every file matching noticeFilePatterns must be at least minimumNoticeFileBytes long and contain none of noticePlaceholderTokens (case-sensitive). Every required file must be non-empty, and a ZIP must not contain duplicate entries.",
  "noticeFilePatterns": ["THIRD-PARTY-NOTICES.txt", "LatoFont/OFL.txt", "licenses/*"],
  "minimumNoticeFileBytes": 100,
  "noticePlaceholderTokens": ["TODO", "TBD", "FIXME", "XXX", "PLACEHOLDER", "{{", "}}", "<insert", "<version>", "<license>", "<copyright>"],
