<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Phase 7A: one authoritative version source for every project (AGENT_BUILD_SPEC.md Phase 7,
    "avoid duplicating version numbers across many scripts"). No official product version has been
    assigned yet, so this is an explicit pre-release development version, not a product release
    number — do not read "0.1.0-dev" as a claim about how much of the product is complete. The SDK
    derives AssemblyVersion/FileVersion (numeric only, e.g. 0.1.0.0) and InformationalVersion
    (includes the "-dev" suffix) from this single <Version> value; bump it by hand when a real
    release is cut. <Product> names the built exe's file-properties "Product name" field as the
    user-facing "Carowinds Operations" (Phase 13G rename) without renaming the
    Carowinds.Passdown.Desktop.exe binary itself — the internal project/assembly identity stays
    Carowinds.Passdown throughout (docs/release-strategy.md "Application name";
    docs/phase13-hardening.md "Phase 13G").

    Phase 18E: release candidates are numbered 0.1.0-rc.1, 0.1.0-rc.2, … — every artifact build that
    ships changed code gets the next number, so ZIP/folder names, About this build and Explorer's
    file properties differ between candidates (docs/release-strategy.md "Release candidate
    versioning"). <FileVersion> is set explicitly because the SDK would otherwise give every
    candidate the same numeric 0.1.0.0: its fourth part is the RC number and must be bumped together
    with <Version> (guarded by ReleaseVersionTests). AssemblyVersion intentionally stays 0.1.0.0.
  -->
  <PropertyGroup>
    <Version>0.1.0-rc.7</Version>
    <FileVersion>0.1.0.7</FileVersion>
    <Product>Carowinds Operations</Product>
  </PropertyGroup>

  <!--
    Phase 18A PKG-001: Release binaries are distributed to other people, so they must not embed the
    build machine's absolute source path (the PE debug directory's PDB path otherwise records e.g.
    /Users/<developer>/Documents/... — a username and folder layout disclosure, and a non-reproducible
    byte difference between two machines building the same commit). PathMap rewrites the repository
    root to "/_/" in Release only; Debug keeps real paths so local debugging/breakpoints are unaffected.
    See docs/phase18-comprehensive-audit.md.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
  </PropertyGroup>
</Project>
