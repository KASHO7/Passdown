# Windows batch launchers must keep CRLF line endings regardless of the
# committer's platform/core.autocrlf setting (target platform is Windows 11 x64 —
# CLAUDE.md "Platform"). This is the nontechnical double-click setup helpers from
# Phase 7C (packaging/windows/*.cmd).
*.cmd text eol=crlf

# Third-party license texts are shipped byte-for-byte as their packages provide them
# (Phase 18C PKG-003) - never line-ending-normalized.
packaging/windows/licenses/** -text

# Phase 29A: the Windows test kit's expected clipboard outputs are byte-exact (CF_HTML byte offsets, CRLF
# plain text) and must never be line-ending-normalized.
tools/phase29a-windows-kit/expected/** -text
