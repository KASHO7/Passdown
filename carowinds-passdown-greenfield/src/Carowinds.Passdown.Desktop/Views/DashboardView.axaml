<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.DashboardView"
             x:DataType="vm:OperationsDashboardViewModel">

  <!-- Phase 10A: the Operations Dashboard foundation — a summary/control surface answering "what do
       I need to know today?", not another editing form. Shared typography, surface, button and status styles
       come from Themes/PassdownStyles.axaml (Phase 22A); only this screen's own deltas live below. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.hoursHeadline">
      <Setter Property="Margin" Value="0,4,0,6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <!-- Phase 15E: the title column is "*" (not Auto) so the right-hand status group (a fixed Auto
           column) always stays fully visible at the 960×640 minimum window size — a long real
           operating-day label ("Wednesday, September 30, 2026") previously could push it partially off
           the window since two Auto columns cannot both shrink to fit.
           Phase 19A: the header "Refresh" button is gone — the Dashboard now reloads itself whenever local
           data changes — and its place holds the shared, subtle official-data freshness line. -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="TODAY" Classes="sectionTitle" Margin="0" />
          <TextBlock Text="{Binding Presentation.OperatingDayLabel}" Classes="pageTitle"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                    IsVisible="{Binding OfficialDataStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock x:Name="OfficialDataStatusText" Text="{Binding OfficialDataStatus.Presentation.Text}" Classes="muted"
                     HorizontalAlignment="Right" TextWrapping="NoWrap"
                     AutomationProperties.Name="{Binding OfficialDataStatus.Presentation.AutomationText}"
                     AutomationProperties.LiveSetting="Polite"
                     ToolTip.Tip="{Binding OfficialDataStatus.Presentation.DetailText}" />
          <TextBlock Text="{Binding OfficialDataStatus.Presentation.DetailText}" Classes="muted" FontSize="11"
                     HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="420"
                     IsVisible="{Binding OfficialDataStatus.Presentation.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="24,20,24,24">
      <StackPanel Spacing="16">

        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" />

        <StackPanel Orientation="Horizontal" Spacing="12"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Classes="fieldError" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Content="Try again" Classes="secondaryAction" Command="{Binding ReloadCommand}"
                  AutomationProperties.Name="Try loading today's operations summary again"
                  AutomationProperties.HelpText="Reloads today's summary from your saved local information. Does not check the website." />
        </StackPanel>

        <StackPanel Spacing="16" IsVisible="{Binding HasSnapshot}">

          <!-- Today's Operation / Passdown Status (spec Part M's top row). -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

            <Border Grid.Column="0" Classes="panel heroPanel" AutomationProperties.Name="Today's Operation">
              <StackPanel Spacing="2">
                <TextBlock Text="Today's Operation" Classes="sectionTitle" />
                <TextBlock Text="{Binding Presentation.ParkHours.HeadlineText}" Classes="hoursHeadline" />
                <Border Classes="chip" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Presentation.ParkStatusBadgeText}" />
                </Border>
                <TextBlock Text="{Binding Presentation.ParkHours.VerificationText}" Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Presentation.ParkHours.StaleNoteText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.ParkHours.StaleNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="panel heroPanel" AutomationProperties.Name="Passdown Status">
              <StackPanel Spacing="2">
                <TextBlock Text="Passdown Status" Classes="sectionTitle" />
                <TextBlock Text="{Binding Presentation.PassdownStatusText}" Classes="hoursHeadline" />
                <TextBlock Text="{Binding Presentation.PassdownStatusDetailText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.PassdownStatusDetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Content="Open Passdown" Classes="primaryAction" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding OpenPassdownCommand}"
                        IsVisible="{Binding Presentation.ShowOpenPassdownAction}"
                        AutomationProperties.Name="Open Passdown"
                        AutomationProperties.HelpText="Opens today's Associate Passdown for editing." />
              </StackPanel>
            </Border>

          </Grid>

          <!-- Daily snapshot region (spec Part M): attendance/pre-solds/Early Ride Time/Daily
               Feature as compact stat tiles, not full editing controls. -->
          <Border Classes="panel" AutomationProperties.Name="Today at a Glance">
            <StackPanel Spacing="10">
              <TextBlock Text="Today at a Glance" Classes="sectionTitle" Margin="0" />
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="20">
                <StackPanel Grid.Column="0" Spacing="0">
                  <TextBlock Text="PROJECTED ATTENDANCE" Classes="statLabel" />
                  <TextBlock Text="{Binding Presentation.AttendanceText}" Classes="statValue" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="0">
                  <TextBlock Text="PRE-SOLDS" Classes="statLabel" />
                  <TextBlock Text="{Binding Presentation.PreSoldsText}" Classes="statValue" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="0">
                  <TextBlock Text="EARLY RIDE TIME" Classes="statLabel" />
                  <TextBlock Text="{Binding Presentation.EarlyRideTimeText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="0">
                  <TextBlock Text="{Binding Presentation.DailyFeatureLabel}" Classes="statLabel" />
                  <TextBlock Text="{Binding Presentation.DailyFeatureText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Phase 21C: Today's Shows — the official schedule's upcoming performances, compact rows
               (name · times · venue), never a large table. Empty/unpublished/failed states are one
               quiet line; only a confirmed empty schedule says "No shows scheduled". -->
          <Border Classes="panel" AutomationProperties.Name="Today's shows" IsVisible="{Binding ShowsPresentation, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding ShowsPresentation.Heading}" Classes="sectionTitle" Margin="0" />
              <TextBlock Text="{Binding ShowsPresentation.StatusText}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding ShowsPresentation.HasStatusText}" />
              <ItemsControl ItemsSource="{Binding ShowsPresentation.Rows}" IsVisible="{Binding ShowsPresentation.HasRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="presentation:ShowRowPresentation">
                    <Grid ColumnDefinitions="2*,3*,1.5*" ColumnSpacing="16" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TimesText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EarlierText}" Classes="muted" IsVisible="{Binding HasEarlierText}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Venue}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasVenue}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ShowsPresentation.StartedEarlierText}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding ShowsPresentation.HasStartedEarlierText}" />
              <TextBlock Text="{Binding ShowsPresentation.FreshnessText}" Classes="muted" FontSize="12"
                         IsVisible="{Binding ShowsPresentation.HasFreshnessText}" />
            </StackPanel>
          </Border>

          <!-- Data Status (Phase 10D Part K): the Dashboard's compact data-confidence surface —
               "are today's displayed values current enough to trust operationally?", never absolute
               correctness. Given its own full-width row (rather than squeezed into half of a
               two-column row) because Phase 10D gave it a source breakdown and the explicit Check
               Online action, making it the page's most information-dense panel after the hero row. -->
          <Border Classes="panel" AutomationProperties.Name="Data status">
            <StackPanel Spacing="8">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="DATA STATUS" Classes="sectionTitle" Margin="0" />
                  <TextBlock Text="{Binding Presentation.DataHealth.OverallHeadline}" FontSize="17" FontWeight="Bold" />
                  <TextBlock Text="{Binding Presentation.DataHealth.OverallDetailText}" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Presentation.DataHealth.LastVerifiedText}" Classes="muted" Margin="0,2,0,0"
                             IsVisible="{Binding Presentation.DataHealth.LastVerifiedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                  <Button Content="Check Online" Classes="primaryAction" HorizontalAlignment="Right"
                          Command="{Binding CheckOnlineCommand}"
                          AutomationProperties.Name="Check Online"
                          AutomationProperties.HelpText="Checks official Carowinds/Six Flags sources now and updates today's information." />
                  <!-- Phase 10E Part R: a subtle, dedicated busy indicator for Check Online, distinct
                       from the header's IsLoading ProgressBar — the local reload and the online check
                       are two different kinds of "busy" and must not look like the same one to a
                       screen reader or at a glance. -->
                  <ProgressBar x:Name="CheckOnlineBusyBar" IsIndeterminate="True" Height="3" Width="140" HorizontalAlignment="Right"
                               IsVisible="{Binding IsCheckingOnline}" />
                  <TextBlock Text="{Binding CheckOnlineStatusMessage}" Classes="muted" HorizontalAlignment="Right"
                             TextWrapping="Wrap" MaxWidth="230" TextAlignment="Right"
                             IsVisible="{Binding CheckOnlineStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding CheckOnlineResultMessage}" Classes="muted" FontWeight="SemiBold"
                             TextWrapping="Wrap" MaxWidth="230" TextAlignment="Right"
                             IsVisible="{Binding CheckOnlineResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Grid>

              <!-- WrapPanel (not a fixed horizontal StackPanel) so up to six count chips reflow
                   instead of clipping at the 960px fallback width (Part L/C). -->
              <ItemsControl ItemsSource="{Binding Presentation.DataHealth.Counts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="presentation:DashboardCountChip">
                    <Border Classes="chip" Margin="0,0,8,4">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding CountText}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Label}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="TODAY'S OPERATION" Classes="statLabel" />
                  <ItemsControl ItemsSource="{Binding Presentation.DataHealth.OperationalSources}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="presentation:DashboardSourceStatusPresentation">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2"
                              ToolTip.Tip="{Binding TimestampText}"
                              AutomationProperties.Name="{Binding CategoryLabel}"
                              AutomationProperties.HelpText="{Binding TimestampText}">
                          <TextBlock Grid.Column="0" Text="{Binding CategoryLabel}" />
                          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="PRODUCTS / OFFERS" Classes="statLabel" />
                  <ItemsControl ItemsSource="{Binding Presentation.DataHealth.ProductSources}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="presentation:DashboardSourceStatusPresentation">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2"
                              ToolTip.Tip="{Binding TimestampText}"
                              AutomationProperties.Name="{Binding CategoryLabel}"
                              AutomationProperties.HelpText="{Binding TimestampText}">
                          <TextBlock Grid.Column="0" Text="{Binding CategoryLabel}" />
                          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <!-- Phase 13D Part U/V: Deep Refresh status + the always-available manual action —
                   distinct from Check Online (Part X: Last Deep Refresh / Last Check Online / Last
                   Verified are three different concepts). Kept compact — one headline line, one
                   optional detail line, one optional coverage line, and the button — never a second
                   Alerts-style panel (Part V). -->
              <Border Height="1" Background="{DynamicResource PassdownDividerBrush}" Margin="0,2,0,0" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="DEEP REFRESH" Classes="sectionTitle" Margin="0" />
                  <TextBlock Text="{Binding DeepRefreshPresentation.HeadlineText}" FontWeight="SemiBold"
                             AutomationProperties.Name="Deep Refresh status"
                             AutomationProperties.HelpText="{Binding DeepRefreshPresentation.AutomationText}" />
                  <TextBlock Text="{Binding DeepRefreshPresentation.DetailText}" Classes="muted" TextWrapping="Wrap"
                             IsVisible="{Binding DeepRefreshPresentation.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding DeepRefreshPresentation.CoverageText}" Classes="muted" TextWrapping="Wrap"
                             IsVisible="{Binding DeepRefreshPresentation.CoverageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                  <Button Content="Run Deep Refresh" Classes="secondaryAction" HorizontalAlignment="Right"
                          Command="{Binding RunDeepRefreshCommand}"
                          AutomationProperties.Name="Run Deep Refresh"
                          AutomationProperties.HelpText="Restores upcoming Park Hours coverage and refreshes every supported product/pricing source, regardless of when it last ran." />
                  <ProgressBar x:Name="DeepRefreshBusyBar" IsIndeterminate="True" Height="3" Width="140" HorizontalAlignment="Right"
                               IsVisible="{Binding IsRunningDeepRefresh}" />
                  <TextBlock Text="{Binding DeepRefreshStatusMessage}" Classes="muted" HorizontalAlignment="Right"
                             TextWrapping="Wrap" MaxWidth="230" TextAlignment="Right"
                             IsVisible="{Binding DeepRefreshStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding DeepRefreshResultMessage}" Classes="muted" FontWeight="SemiBold" HorizontalAlignment="Right"
                             TextWrapping="Wrap" MaxWidth="230" TextAlignment="Right"
                             IsVisible="{Binding DeepRefreshResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Grid>

            </StackPanel>
          </Border>

          <!-- Passdown Notes (today's Associate draft, unchanged from Phase 10) beside Active
               Operational Notes (Phase 11C: persistent, supervisor-managed notes relevant today) —
               kept as two clearly separate panels/headings so the two concepts can never be confused
               (spec Part A/AF). The panel was renamed from "Operational Notes" to "Passdown Notes"
               specifically because Phase 11C introduces a second, differently-scoped "operational
               notes" concept next to it. -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

            <Border Grid.Column="0" Classes="panel" AutomationProperties.Name="Passdown Notes">
              <StackPanel Spacing="6">
                <TextBlock Text="Passdown Notes" Classes="sectionTitle" Margin="0" />
                <TextBlock Text="Today's notes entered for the Associate Passdown" Classes="muted" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Presentation.NotesSummaryText}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Presentation.NotesPreviewLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Open Notes" Classes="secondaryAction" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding OpenNotesCommand}"
                        AutomationProperties.Name="Open Notes"
                        AutomationProperties.HelpText="Opens Associate Passdown's Notes section, where operational notes can be reviewed and edited." />
              </StackPanel>
            </Border>

            <!-- Phase 11C: persistent Operational Notes relevant to today's Eastern date (spec Part
                 B/D/E) — read-only, no editor controls, no "Include"/"Add to Passdown" affordance
                 (Part T). Bounded to the first 3 relevant notes (Part H) with an overflow line when
                 more exist; Important notes sort first via the shared OperationalNoteOrdering.ByRelevance
                 rule (Part F/J), communicated with text, never color-only. -->
            <Border Grid.Column="1" Classes="panel" AutomationProperties.Name="Active operational notes">
              <StackPanel Spacing="6">
                <TextBlock Text="Active Operational Notes" Classes="sectionTitle" Margin="0" />
                <TextBlock Text="Persistent notes relevant today" Classes="muted" Margin="0,0,0,4" />

                <TextBlock Text="Unable to load operational notes." Classes="fieldError"
                           IsVisible="{Binding Presentation.ActiveOperationalNotes.LoadFailed}" />

                <TextBlock Text="No active operational notes for today." Classes="muted"
                           IsVisible="{Binding Presentation.ActiveOperationalNotes.ShowEmptyState}" />

                <ItemsControl ItemsSource="{Binding Presentation.ActiveOperationalNotes.Items}"
                              IsVisible="{Binding Presentation.ActiveOperationalNotes.HasNotes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:DashboardOperationalNoteItemPresentation">
                      <StackPanel Spacing="1" Margin="0,0,0,8"
                                  AutomationProperties.Name="{Binding AccessibleSummary}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Classes="priorityText important" Text="Important" IsVisible="{Binding IsImportant}" />
                          <TextBlock Classes="priorityText important" Text="·" IsVisible="{Binding IsImportant}" />
                          <TextBlock Text="{Binding CategoryLabel}" Classes="muted" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DateRangeText}" Classes="muted" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Presentation.ActiveOperationalNotes.OverflowText}" Classes="muted"
                           IsVisible="{Binding Presentation.ActiveOperationalNotes.HasOverflow}" />

                <Button Content="Open Operational Notes" Classes="secondaryAction" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding OpenOperationalNotesCommand}"
                        AutomationProperties.Name="Open operational notes"
                        AutomationProperties.HelpText="Opens the Operational Notes manager." />
              </StackPanel>
            </Border>

          </Grid>

          <!-- Latest Finalized (spec Phase 10C Part B/P) now spans full width on its own row — moved
               out of the two-column row above to make space for Active Operational Notes (spec Part
               AE), the most recent finalized passdown's metadata only, never the frozen snapshot or PDF. -->
          <Border Classes="panel" AutomationProperties.Name="Latest finalized passdown">
            <StackPanel Spacing="6">
              <TextBlock Text="Latest Finalized" Classes="sectionTitle" Margin="0" />

              <StackPanel Spacing="2" IsVisible="{Binding Presentation.LatestFinalized, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Presentation.LatestFinalized.PassdownDateText}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding Presentation.LatestFinalized.FinalizedText}" Classes="muted" />
                <TextBlock Text="{Binding Presentation.LatestFinalized.OriginText}" Classes="muted" />
              </StackPanel>
              <TextBlock Text="No finalized passdowns yet." Classes="muted"
                         IsVisible="{Binding Presentation.LatestFinalized, Converter={x:Static ObjectConverters.IsNull}}" />

              <Button Content="Open History" Classes="secondaryAction" Margin="0,6,0,0" HorizontalAlignment="Left"
                      Command="{Binding OpenHistoryCommand}"
                      AutomationProperties.Name="Open History"
                      AutomationProperties.HelpText="Opens the read-only Passdown History screen." />
            </StackPanel>
          </Border>

        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
