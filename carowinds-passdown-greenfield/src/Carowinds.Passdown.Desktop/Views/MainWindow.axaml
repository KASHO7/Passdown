<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
        xmlns:views="using:Carowinds.Passdown.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Carowinds.Passdown.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="Carowinds Operations"
        Width="1280" Height="860" MinWidth="960" MinHeight="640"
        Classes.motion="{Binding IsInterfaceMotionEnabled}"
        Classes.noMotion="{Binding IsInterfaceMotionDisabled}">

    <!-- Phase 35A shell (docs/phase35-unified-ui-modernization.md §6). The compact title area is the native
         Windows title bar: the original app icon (Icon above, byte-identical to the supplied .ico) and
         "Carowinds Operations" only — so minimize, maximize, restore, close, Snap Layouts, drag and DPI stay
         native, and the name is not repeated inside the window. The Phase 22B photo banner and horizontal
         strip are replaced by a left sidebar. Styles live in Themes/PassdownStyles.axaml ("App shell" and
         "Motion"); the window's "motion" class gates every cosmetic transition. -->

    <Grid>
    <Grid x:Name="AppShell" ColumnDefinitions="Auto,*">

        <!-- The sidebar. Destinations, commands, order and selection flags are unchanged from Phase 22C
             (Dashboard · Calendar · Passdown · Operational Notes · History, Settings pinned at the bottom); no
             Manager/Alerts entry (CLAUDE.md "current scope decision") and no decorative section heading. Each
             section command's CanExecute still blocks leaving Operational Notes mid-edit. Collapsing only
             changes this column: no page, date, draft or refresh is touched. -->
        <Border x:Name="AppNavigation" Grid.Column="0" Classes="navSidebar"
                Classes.collapsed="{Binding IsNavigationShownCollapsed}">
            <Grid x:Name="AppNavigationLayout" RowDefinitions="Auto,*,Auto"
                  AutomationProperties.Name="Application sections" AutomationProperties.LandmarkType="Navigation">

                <Button x:Name="NavigationToggle" Grid.Row="0" Classes="iconAction" Margin="12,0,0,8"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleNavigationCommand}"
                        AutomationProperties.Name="{Binding NavigationToggleName}"
                        ToolTip.Tip="{Binding NavigationToggleName}">
                    <PathIcon Data="{StaticResource PassdownSidebarToggleIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                </Button>

                <StackPanel x:Name="AppNavigationItems" Grid.Row="1">
                    <Button Classes="navItem" Classes.active="{Binding IsDashboardSectionSelected}"
                            Command="{Binding ShowDashboardSectionCommand}"
                            AutomationProperties.Name="Dashboard section"
                            ToolTip.Tip="Dashboard" ToolTip.ServiceEnabled="{Binding IsNavigationShownCollapsed}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="navIndicator" />
                            <StackPanel Grid.Column="1" Classes="navContent" Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource PassdownDashboardIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Classes="navLabel" Text="Dashboard" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsOperationsCalendarSectionSelected}"
                            Command="{Binding ShowOperationsCalendarSectionCommand}"
                            AutomationProperties.Name="Operations Calendar section"
                            ToolTip.Tip="Calendar" ToolTip.ServiceEnabled="{Binding IsNavigationShownCollapsed}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="navIndicator" />
                            <StackPanel Grid.Column="1" Classes="navContent" Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource PassdownCalendarIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Classes="navLabel" Text="Calendar" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsAssociateSectionSelected}"
                            Command="{Binding ShowAssociateSectionCommand}"
                            AutomationProperties.Name="Associate Passdown section"
                            ToolTip.Tip="Passdown" ToolTip.ServiceEnabled="{Binding IsNavigationShownCollapsed}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="navIndicator" />
                            <StackPanel Grid.Column="1" Classes="navContent" Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource PassdownPassdownIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Classes="navLabel" Text="Passdown" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsOperationalNotesSectionSelected}"
                            Command="{Binding ShowOperationalNotesSectionCommand}"
                            AutomationProperties.Name="Operational Notes section"
                            ToolTip.Tip="Operational Notes" ToolTip.ServiceEnabled="{Binding IsNavigationShownCollapsed}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="navIndicator" />
                            <StackPanel Grid.Column="1" Classes="navContent" Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource PassdownNotesIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Classes="navLabel" Text="Operational Notes" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="navItem" Classes.active="{Binding IsHistorySectionSelected}"
                            Command="{Binding ShowHistorySectionCommand}"
                            AutomationProperties.Name="History section"
                            ToolTip.Tip="History" ToolTip.ServiceEnabled="{Binding IsNavigationShownCollapsed}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="navIndicator" />
                            <StackPanel Grid.Column="1" Classes="navContent" Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource PassdownHistoryIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Classes="navLabel" Text="History" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Settings, pinned to the bottom. Phase 23D's update dot sits on the gear's corner (decorative;
                     the help text says "Update available" for Narrator). -->
                <Button x:Name="SettingsNavigationItem" Grid.Row="2" Classes="navItem"
                        Classes.active="{Binding IsSettingsSectionSelected}"
                        Command="{Binding ShowSettingsSectionCommand}"
                        AutomationProperties.Name="Settings" ToolTip.Tip="Settings"
                        ToolTip.ServiceEnabled="{Binding IsNavigationShownCollapsed}"
                        AutomationProperties.HelpText="{Binding SettingsNavigationHelpText}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="navIndicator" />
                        <StackPanel Grid.Column="1" Classes="navContent" Orientation="Horizontal" Spacing="12">
                            <Panel>
                                <PathIcon Data="{StaticResource PassdownSettingsIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                                <Ellipse x:Name="UpdateIndicatorDot" Width="8" Height="8"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                         Fill="{DynamicResource PassdownAccentBrush}"
                                         IsVisible="{Binding HasUpdateNotification}" IsHitTestVisible="False"
                                         AutomationProperties.AccessibilityView="Raw" />
                            </Panel>
                            <TextBlock Classes="navLabel" Text="Settings" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- All six sections are constructed once and stay alive for the app's lifetime (spec Part T): switching
             which one is visible — or collapsing the sidebar — never recreates the Associate screen's in-progress
             edits/autosave state and never touches AssociateViewModel.SelectedDate. IsVisible is bound on the
             wrapping Border (MainViewModel's DataContext), not on the element whose DataContext changes. -->
        <Grid x:Name="SectionHost" Grid.Column="1">
            <Border IsVisible="{Binding IsDashboardSectionSelected}">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </Border>
            <Border IsVisible="{Binding IsOperationsCalendarSectionSelected}">
                <views:OperationsCalendarView DataContext="{Binding Calendar}" />
            </Border>
            <Border IsVisible="{Binding IsAssociateSectionSelected}">
                <views:AssociateView DataContext="{Binding Associate}" />
            </Border>
            <Border IsVisible="{Binding IsOperationalNotesSectionSelected}">
                <views:OperationalNotesView DataContext="{Binding Notes}" />
            </Border>
            <Border IsVisible="{Binding IsHistorySectionSelected}">
                <views:HistoryView DataContext="{Binding History}" />
            </Border>
            <Border IsVisible="{Binding IsSettingsSectionSelected}">
                <views:PersonalSyncSettingsView DataContext="{Binding Settings}" />
            </Border>
        </Grid>

    </Grid>

    <!-- Phase 20A: the read-only Season Price History screen, opened from Associate → Products. An
         overlay over the whole shell (not a section): closing it returns to exactly what was showing,
         with no Associate state touched. -->
    <Border IsVisible="{Binding IsPriceHistoryOpen}" Background="{DynamicResource PassdownOverlayScrimBrush}">
        <views:PriceHistoryView DataContext="{Binding PriceHistory}" />
    </Border>

    <!-- Phase 31C: View details for a product or official deal, opened from Associate → Products. -->
    <Border IsVisible="{Binding Associate.OfficialDetails.IsOpen}" Background="{DynamicResource PassdownOverlayScrimBrush}">
        <views:OfficialDetailsView DataContext="{Binding Associate.OfficialDetails}" />
    </Border>

    <!-- Phase 23D: What's New — opened once after a confirmed in-app update, or from Settings → About this build. -->
    <Border IsVisible="{Binding IsWhatsNewOpen}" Background="{DynamicResource PassdownOverlayScrimBrush}">
        <views:WhatsNewView DataContext="{Binding WhatsNew}" />
    </Border>
    </Grid>

</Window>
