<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
        xmlns:views="using:Carowinds.Passdown.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Carowinds.Passdown.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="Carowinds Operations"
        Width="1280" Height="860" MinWidth="960" MinHeight="640">

    <!-- Phase 22B: the banner and section-navigation styles (Border.brandBanner,
         TextBlock.brandWordmark, Border.appNavigation, Button.appSectionItem[.active]) live in
         Themes/PassdownStyles.axaml with the rest of the shared styles. -->

    <Grid>
    <DockPanel LastChildFill="True">

        <!-- Brand banner (Phase 22B, "Option A — Minimal Fury Banner"; replaces the Phase 13G navy
             band): a compact, theme-invariant panoramic crop of Fury 325 under a charcoal-navy
             left-to-right scrim, with one "CAROWINDS OPERATIONS" wordmark. The photo is a bundled
             avares resource (offline, no network fetch) cropped UniformToFill around the camelback
             crest; it is decorative, so it is hidden from assistive technology and hit testing.
             Associate Passdown is the only workflow this release — no Manager entry point is added
             as a placeholder (CLAUDE.md "current scope decision"). -->
        <Border x:Name="BrandBanner" DockPanel.Dock="Top" Classes="brandBanner">
            <Panel>
                <Image x:Name="BrandBannerImage" Source="/Assets/Branding/fury325-banner.jpg"
                       Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Border Background="{DynamicResource PassdownBannerOverlayBrush}" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="24,0">
                    <!-- The small original ascending-track mark (spec §10.1), kept from the Phase 13G band. -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Height="18"
                                AutomationProperties.AccessibilityView="Raw">
                        <Rectangle Width="5" Height="8" Fill="{DynamicResource PassdownHeaderForegroundBrush}" VerticalAlignment="Bottom" />
                        <Rectangle Width="5" Height="13" Fill="{DynamicResource PassdownHeaderForegroundBrush}" VerticalAlignment="Bottom" />
                        <Rectangle Width="5" Height="18" Fill="{DynamicResource PassdownHeaderForegroundBrush}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="BrandWordmark" Classes="brandWordmark" Text="CAROWINDS OPERATIONS"
                               AutomationProperties.Name="Carowinds Operations" />
                </StackPanel>
            </Panel>
        </Border>

        <!-- App-shell section strip (spec Phase 9D Part A; extended Phase 10A Part A, Phase 11B Part A,
             Phase 12A Part B): the only top-level navigation this app has — Dashboard (Phase 10A's
             supervisor summary/control surface and the default startup section), Operations Calendar
             (Phase 12A's month-grid planning/routing surface), Associate Passdown (the only editable
             daily workflow), Operational Notes (Phase 11B's persistent supervisor-managed notes manager
             — distinct from Associate's own daily Notes entry), and History (Phase 9D's read-only
             archive). No Manager/Alerts entry (CLAUDE.md "current scope decision"). Each button's
             CanExecute (every section except Operational Notes itself, which is always reachable) is
             disabled while Notes.IsEditing is true (spec Part X), so its own IsEnabled need not be
             bound separately here. -->
        <Border x:Name="AppNavigation" DockPanel.Dock="Top" Classes="appNavigation">
            <!-- Phase 15E: WrapPanel, not a fixed-width StackPanel — if the labels ever do not fit (very
                 large text scaling), they wrap to a second row instead of pushing a section off the
                 window. Phase 22C: short visible labels (Dashboard · Calendar · Passdown · Notes ·
                 History) and Settings as a trailing gear; the accessible names keep the full section
                 names (each contains its visible label), and the six destinations, commands, order and
                 selection flags are unchanged. The Grid is the one "Application sections" landmark, so
                 the gear stays inside it and Tab still runs Dashboard → … → History → Settings. -->
            <Grid x:Name="AppNavigationLayout" ColumnDefinitions="*,Auto"
                  AutomationProperties.Name="Application sections" AutomationProperties.LandmarkType="Navigation">
                <WrapPanel x:Name="AppNavigationItems" Grid.Column="0" Orientation="Horizontal">
                    <Button Classes="appSectionItem" Classes.active="{Binding IsDashboardSectionSelected}"
                            Content="Dashboard" Command="{Binding ShowDashboardSectionCommand}"
                            AutomationProperties.Name="Dashboard section" />
                    <Button Classes="appSectionItem" Classes.active="{Binding IsOperationsCalendarSectionSelected}"
                            Content="Calendar" Command="{Binding ShowOperationsCalendarSectionCommand}"
                            AutomationProperties.Name="Operations Calendar section" />
                    <Button Classes="appSectionItem" Classes.active="{Binding IsAssociateSectionSelected}"
                            Content="Passdown" Command="{Binding ShowAssociateSectionCommand}"
                            AutomationProperties.Name="Associate Passdown section" />
                    <Button Classes="appSectionItem" Classes.active="{Binding IsOperationalNotesSectionSelected}"
                            Content="Notes" Command="{Binding ShowOperationalNotesSectionCommand}"
                            AutomationProperties.Name="Operational Notes section" />
                    <Button Classes="appSectionItem" Classes.active="{Binding IsHistorySectionSelected}"
                            Content="History" Command="{Binding ShowHistorySectionCommand}"
                            AutomationProperties.Name="History section" />
                </WrapPanel>
                <Button x:Name="SettingsNavigationItem" Grid.Column="1" VerticalAlignment="Top"
                        Classes="appSectionItem iconItem" Classes.active="{Binding IsSettingsSectionSelected}"
                        Command="{Binding ShowSettingsSectionCommand}"
                        AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
                    <PathIcon Data="{StaticResource PassdownSettingsIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>
        </Border>

        <!-- All five sections are constructed once and stay alive for the app's lifetime (spec Part
             T): switching which one is visible never recreates the Associate screen's in-progress
             edits/autosave state and never touches AssociateViewModel.SelectedDate. -->
        <Grid>
            <!-- IsVisible is bound on the wrapping Border (still MainViewModel's own DataContext) —
                 the inner view's DataContext reassignment below changes the compiled-binding type for
                 its own subtree, so IsDashboardSectionSelected/IsOperationsCalendarSectionSelected/
                 IsAssociateSectionSelected/IsOperationalNotesSectionSelected/IsHistorySectionSelected
                 must not be bound on the same element as that DataContext switch. -->
            <Border IsVisible="{Binding IsDashboardSectionSelected}">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </Border>
            <Border IsVisible="{Binding IsOperationsCalendarSectionSelected}">
                <views:OperationsCalendarView DataContext="{Binding Calendar}" />
            </Border>
            <Border IsVisible="{Binding IsAssociateSectionSelected}">
                <views:AssociateView DataContext="{Binding Associate}" />
            </Border>
            <Border IsVisible="{Binding IsOperationalNotesSectionSelected}">
                <views:OperationalNotesView DataContext="{Binding Notes}" />
            </Border>
            <Border IsVisible="{Binding IsHistorySectionSelected}">
                <views:HistoryView DataContext="{Binding History}" />
            </Border>
            <Border IsVisible="{Binding IsSettingsSectionSelected}">
                <views:PersonalSyncSettingsView DataContext="{Binding Settings}" />
            </Border>
        </Grid>

    </DockPanel>

    <!-- Phase 20A: the read-only Season Price History screen, opened from Associate → Products. An
         overlay over the whole shell (not a section): closing it returns to exactly what was showing,
         with no Associate state touched. -->
    <Border IsVisible="{Binding IsPriceHistoryOpen}" Background="{DynamicResource PassdownOverlayScrimBrush}">
        <views:PriceHistoryView DataContext="{Binding PriceHistory}" />
    </Border>
    </Grid>

</Window>
