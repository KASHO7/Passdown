<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
        xmlns:views="using:Carowinds.Passdown.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Carowinds.Passdown.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="Carowinds Operations"
        Width="1280" Height="860" MinWidth="960" MinHeight="640">

    <Window.Styles>
        <!-- Top-level app-shell section switcher (spec Phase 9D Part A): a slim horizontal strip
             below the brand band, not a subsection inside AssociateView's own rail — History is a
             sibling app section, not something that could be mistaken for an editable Associate
             subsection (spec Part E). Plain Button + a data-bound "active" class, deliberately not
             ToggleButton: nothing here needs two-way IsChecked state, and one-way Classes binding to
             MainViewModel.IsAssociateSectionSelected/IsHistorySectionSelected can never drift out of
             sync the way a ToggleButton's own click-toggled IsChecked could. -->
        <Style Selector="Button.appSectionItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.appSectionItem.active">
            <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.appSectionItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.appSectionItem.active:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
        </Style>
    
    </Window.Styles>

    <Grid>
    <DockPanel LastChildFill="True">

        <!-- Brand identity band (spec §10.2): a constant, theme-invariant deep-navy strip so the app
             reads as "Carowinds Operations" the instant it opens, independent of the light/dark
             surfaces underneath (Phase 13G rename). Associate Passdown is the only workflow this
             release — no mode selector/nav rail is needed for one item, and no Manager entry point is
             added as a placeholder (CLAUDE.md "current scope decision"). -->
        <Border DockPanel.Dock="Top" Padding="24,10" Background="{DynamicResource PassdownBrandDarkBrush}"
                ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,*">

                <!-- Faint trackline motif: a couple of low-opacity coaster-hill strokes, not an image
                     asset — kept subtle so it reads as texture, not decoration competing with the text. -->
                <Canvas Grid.Column="0" Grid.ColumnSpan="2" Opacity="0.10" IsHitTestVisible="False">
                    <Polyline Points="640,46 690,-4 740,46 800,-14 900,50 980,-10 1120,46"
                              Stroke="{DynamicResource PassdownHeaderForegroundBrush}" StrokeThickness="2.5" />
                </Canvas>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- A small original ascending-track mark (spec §10.1) — plain geometric bars, not a
                         reskin of any existing asset. -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" Height="20">
                        <Rectangle Width="6" Height="9" Fill="{DynamicResource PassdownHeaderForegroundBrush}" VerticalAlignment="Bottom" />
                        <Rectangle Width="6" Height="14" Fill="{DynamicResource PassdownHeaderForegroundBrush}" VerticalAlignment="Bottom" />
                        <Rectangle Width="6" Height="20" Fill="{DynamicResource PassdownHeaderForegroundBrush}" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="CAROWINDS" FontSize="15" FontWeight="Bold" LetterSpacing="1.5"
                                   Foreground="{DynamicResource PassdownHeaderForegroundBrush}" />
                        <TextBlock Text="OPERATIONS" FontSize="10.5" FontWeight="Medium" LetterSpacing="1.5"
                                   Foreground="{DynamicResource PassdownHeaderMutedForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- App-shell section strip (spec Phase 9D Part A; extended Phase 10A Part A, Phase 11B Part A,
             Phase 12A Part B): the only top-level navigation this app has — Dashboard (Phase 10A's
             supervisor summary/control surface and the default startup section), Operations Calendar
             (Phase 12A's month-grid planning/routing surface), Associate Passdown (the only editable
             daily workflow), Operational Notes (Phase 11B's persistent supervisor-managed notes manager
             — distinct from Associate's own daily Notes entry), and History (Phase 9D's read-only
             archive). No Manager/Alerts entry (CLAUDE.md "current scope decision"). Each button's
             CanExecute (every section except Operational Notes itself, which is always reachable) is
             disabled while Notes.IsEditing is true (spec Part X), so its own IsEnabled need not be
             bound separately here. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PassdownSurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
            <!-- Phase 15E: WrapPanel, not a fixed-width StackPanel — at the documented 960×640 minimum
                 window size, five section labels plus padding exceed 960px and a plain StackPanel would
                 push "History" fully off the visible window with no way to reach it. Wrapping to a
                 second line keeps every section reachable at any supported width instead of silently
                 clipping the least-recently-added item. -->
            <WrapPanel Orientation="Horizontal">
                <Button Classes="appSectionItem" Classes.active="{Binding IsDashboardSectionSelected}"
                        Content="Dashboard" Command="{Binding ShowDashboardSectionCommand}"
                        AutomationProperties.Name="Dashboard section" />
                <Button Classes="appSectionItem" Classes.active="{Binding IsOperationsCalendarSectionSelected}"
                        Content="Operations Calendar" Command="{Binding ShowOperationsCalendarSectionCommand}"
                        AutomationProperties.Name="Operations Calendar section" />
                <Button Classes="appSectionItem" Classes.active="{Binding IsAssociateSectionSelected}"
                        Content="Associate Passdown" Command="{Binding ShowAssociateSectionCommand}"
                        AutomationProperties.Name="Associate Passdown section" />
                <Button Classes="appSectionItem" Classes.active="{Binding IsOperationalNotesSectionSelected}"
                        Content="Operational Notes" Command="{Binding ShowOperationalNotesSectionCommand}"
                        AutomationProperties.Name="Operational Notes section" />
                <Button Classes="appSectionItem" Classes.active="{Binding IsHistorySectionSelected}"
                        Content="History" Command="{Binding ShowHistorySectionCommand}"
                        AutomationProperties.Name="History section" />
                <Button Classes="appSectionItem" Classes.active="{Binding IsSettingsSectionSelected}"
                        Content="Settings" Command="{Binding ShowSettingsSectionCommand}"
                        AutomationProperties.Name="Settings section" />
            </WrapPanel>
        </Border>

        <!-- All five sections are constructed once and stay alive for the app's lifetime (spec Part
             T): switching which one is visible never recreates the Associate screen's in-progress
             edits/autosave state and never touches AssociateViewModel.SelectedDate. -->
        <Grid>
            <!-- IsVisible is bound on the wrapping Border (still MainViewModel's own DataContext) —
                 the inner view's DataContext reassignment below changes the compiled-binding type for
                 its own subtree, so IsDashboardSectionSelected/IsOperationsCalendarSectionSelected/
                 IsAssociateSectionSelected/IsOperationalNotesSectionSelected/IsHistorySectionSelected
                 must not be bound on the same element as that DataContext switch. -->
            <Border IsVisible="{Binding IsDashboardSectionSelected}">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </Border>
            <Border IsVisible="{Binding IsOperationsCalendarSectionSelected}">
                <views:OperationsCalendarView DataContext="{Binding Calendar}" />
            </Border>
            <Border IsVisible="{Binding IsAssociateSectionSelected}">
                <views:AssociateView DataContext="{Binding Associate}" />
            </Border>
            <Border IsVisible="{Binding IsOperationalNotesSectionSelected}">
                <views:OperationalNotesView DataContext="{Binding Notes}" />
            </Border>
            <Border IsVisible="{Binding IsHistorySectionSelected}">
                <views:HistoryView DataContext="{Binding History}" />
            </Border>
            <Border IsVisible="{Binding IsSettingsSectionSelected}">
                <views:PersonalSyncSettingsView DataContext="{Binding Settings}" />
            </Border>
        </Grid>

    </DockPanel>

    <!-- Phase 20A: the read-only Season Price History screen, opened from Associate → Products. An
         overlay over the whole shell (not a section): closing it returns to exactly what was showing,
         with no Associate state touched. -->
    <Border IsVisible="{Binding IsPriceHistoryOpen}" Background="{DynamicResource PassdownOverlayScrimBrush}">
        <views:PriceHistoryView DataContext="{Binding PriceHistory}" />
    </Border>
    </Grid>

</Window>
