<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
        xmlns:views="using:Carowinds.Passdown.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Carowinds.Passdown.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Carowinds Passdown"
        Width="1280" Height="860" MinWidth="960" MinHeight="640">

    <DockPanel LastChildFill="True">

        <!-- App shell header (spec §10.2): a clean top-level identity bar. Associate Passdown is
             the only workflow this release — no mode selector/nav rail is needed for one item, and
             no Manager entry point is added as a placeholder (CLAUDE.md "current scope decision"). -->
        <Border DockPanel.Dock="Top" Padding="20,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- A small original ascending-track mark (spec §10.1) — plain geometric bars, not a reskin of any existing asset. -->
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" Height="20">
                    <Rectangle Width="6" Height="9" Fill="{DynamicResource PassdownAccentBrush}" VerticalAlignment="Bottom" />
                    <Rectangle Width="6" Height="14" Fill="{DynamicResource PassdownAccentBrush}" VerticalAlignment="Bottom" />
                    <Rectangle Width="6" Height="20" Fill="{DynamicResource PassdownAccentBrush}" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="Carowinds Passdown" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <views:AssociateView DataContext="{Binding Associate}" />

    </DockPanel>

</Window>
