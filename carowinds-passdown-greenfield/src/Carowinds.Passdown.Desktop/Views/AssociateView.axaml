<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:converters="using:Carowinds.Passdown.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.AssociateView"
             x:DataType="vm:AssociateViewModel">

  <UserControl.Resources>
    <converters:ParkHoursBadgeBrushConverter x:Key="BadgeBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- Typography -->
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.fieldHint">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.fieldWarning">
      <Setter Property="Foreground" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.fieldError">
      <Setter Property="Foreground" Value="{DynamicResource PassdownErrorBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Panels: one restrained container style used everywhere instead of nested cards. -->
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource PassdownSubtleSurfaceBrush}" />
    </Style>

    <!-- Compact status chip: text-first, never color-only (spec §10.4/Part G). -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Hours headline: large when hours are known, quiet when not (Part D — "Not checked yet" must never be a giant headline). -->
    <Style Selector="TextBlock.hoursHeadline">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,2,0,6" />
    </Style>
    <Style Selector="TextBlock.hoursHeadline.subtle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
    </Style>

    <Style Selector="Border.productRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Padding" Value="0,9" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Action bar (spec §10.2/Part B/C): identity, date navigation, primary actions, and save/refresh
         status all live together instead of a separate floating date bar or a developer-style footer. -->
    <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Associate Passdown" Classes="pageTitle" VerticalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="chip" AutomationProperties.Name="Save status">
              <TextBlock Text="{Binding SaveStatusText, FallbackValue='Not saved yet'}" />
            </Border>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
          <Button Grid.Column="0" Content="◀" Width="34"
                  Command="{Binding PreviousDayCommand}"
                  AutomationProperties.Name="Previous day"
                  ToolTip.Tip="Previous day" />
          <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDateOffset}"
                      Margin="8,0,0,0"
                      AutomationProperties.Name="Operating date" />
          <Button Grid.Column="2" Content="▶" Width="34"
                  Margin="8,0,0,0"
                  Command="{Binding NextDayCommand}"
                  AutomationProperties.Name="Next day"
                  ToolTip.Tip="Next day" />

          <Button Grid.Column="3" Content="Check Online"
                  Margin="16,0,0,0"
                  Command="{Binding CheckOnlineCommand}"
                  Classes="accent"
                  AutomationProperties.Name="Check this date online"
                  AutomationProperties.HelpText="Checks official Carowinds sources for this date. Does not run automatically." />

          <Button Grid.Column="4" Content="Create PDF" HorizontalAlignment="Right"
                  Command="{Binding CreatePdfCommand}"
                  AutomationProperties.Name="Create PDF"
                  AutomationProperties.HelpText="Builds today's Associate Passdown PDF and lets you choose where to save it." />
        </Grid>

        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsBusy}" />

        <TextBlock Text="{Binding RefreshStatusMessage}"
                   IsVisible="{Binding RefreshStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes="muted" />

        <TextBlock Text="{Binding RefreshResultMessage}"
                   IsVisible="{Binding RefreshResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="{Binding PdfExportMessage}"
                   IsVisible="{Binding PdfExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="{Binding LoadErrorMessage}"
                   IsVisible="{Binding LoadErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource PassdownErrorBrush}" />
      </StackPanel>
    </Border>

    <!-- Main content: uses the full desktop width via a mixed-column layout (spec Part C) rather
         than one narrow centered stack. -->
    <ScrollViewer Grid.Row="1" Padding="24,20,24,24">
      <StackPanel Spacing="16">

        <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="16">

          <!-- Park hours (Part D): the strongest single operational summary on the page. -->
          <Border Grid.Column="0" Classes="panel">
            <StackPanel Spacing="2">
              <TextBlock Text="Park Hours" Classes="sectionTitle" />

              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9"
                         Fill="{Binding ParkHours.BadgeKind, Converter={StaticResource BadgeBrushConverter}}" />
                <Border Classes="chip">
                  <TextBlock Text="{Binding ParkHours.BadgeText, FallbackValue='Not checked yet'}" />
                </Border>
              </StackPanel>

              <TextBlock Text="{Binding ParkHours.HeadlineText}"
                         Classes="hoursHeadline"
                         IsVisible="{Binding !ParkHours.IsHoursUnknown}" />
              <TextBlock Text="{Binding ParkHours.HeadlineText, FallbackValue='Hours not checked yet'}"
                         Classes="hoursHeadline subtle"
                         IsVisible="{Binding ParkHours.IsHoursUnknown}" />

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="North Gate" Classes="muted" Margin="0,0,12,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParkHours.NorthGateText, FallbackValue='—'}" FontWeight="Medium" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Avenue" Classes="muted" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParkHours.AvenueText, FallbackValue='—'}" FontWeight="Medium" />
              </Grid>

              <TextBlock Text="{Binding ParkHours.VerificationText}"
                         IsVisible="{Binding ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Classes="muted" />

              <TextBlock Text="{Binding ParkHours.StaleNoteText}"
                         IsVisible="{Binding ParkHours.StaleNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Classes="fieldWarning" TextWrapping="Wrap" />

              <!-- Manual hours override + private buyout (Part D): one shared, compact override
                   area instead of two oversized standalone bordered blocks. -->
              <Border Classes="inset">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <CheckBox Content="Manual hours override"
                                IsChecked="{Binding ManualHoursOverrideEnabled}"
                                AutomationProperties.Name="Use a manual hours override" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ManualHoursOverrideEnabled}">
                        <TimePicker SelectedTime="{Binding ManualOpeningTime}" MinWidth="0"
                                    AutomationProperties.Name="Manual override opening time" />
                        <TextBlock Text="–" VerticalAlignment="Center" />
                        <TimePicker SelectedTime="{Binding ManualClosingTime}" MinWidth="0"
                                    AutomationProperties.Name="Manual override closing time" />
                      </StackPanel>
                      <TextBlock Text="{Binding ManualHoursWarningText}"
                                 IsVisible="{Binding ManualHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldWarning" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="16,0,0,0">
                      <CheckBox Content="Private buyout / custom hours"
                                IsChecked="{Binding PrivateBuyoutEnabled}"
                                AutomationProperties.Name="Private buyout or custom hours" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PrivateBuyoutEnabled}">
                        <TimePicker SelectedTime="{Binding PrivateBuyoutOpeningTime}" MinWidth="0"
                                    AutomationProperties.Name="Private buyout opening time" />
                        <TextBlock Text="–" VerticalAlignment="Center" />
                        <TimePicker SelectedTime="{Binding PrivateBuyoutClosingTime}" MinWidth="0"
                                    AutomationProperties.Name="Private buyout closing time" />
                      </StackPanel>
                      <TextBox Text="{Binding PrivateBuyoutDetails}"
                               IsVisible="{Binding PrivateBuyoutEnabled}"
                               PlaceholderText="Group name, contact, or other details"
                               AutomationProperties.Name="Private buyout details" />
                      <TextBlock Text="{Binding PrivateBuyoutHoursWarningText}"
                                 IsVisible="{Binding PrivateBuyoutHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldWarning" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Right column: Attendance, Early Ride Time, Daily Fun (Part E). -->
          <StackPanel Grid.Column="1" Spacing="16">

            <Border Classes="panel">
              <StackPanel Spacing="6">
                <TextBlock Text="Attendance" Classes="sectionTitle" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="0">
                    <TextBlock Text="Projected attendance" Classes="fieldLabel" />
                    <TextBox Text="{Binding ProjectedAttendanceText}"
                             PlaceholderText="Not entered"
                             AutomationProperties.Name="Projected attendance" />
                    <TextBlock Text="{Binding ProjectedAttendanceError}"
                               IsVisible="{Binding ProjectedAttendanceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Text="Pre-solds" Classes="fieldLabel" />
                    <TextBox Text="{Binding PreSoldsText}"
                             PlaceholderText="Not entered"
                             AutomationProperties.Name="Pre-solds" />
                    <TextBlock Text="{Binding PreSoldsError}"
                               IsVisible="{Binding PreSoldsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Early Ride Time" Classes="sectionTitle" />
                <CheckBox Content="Early Ride Time is happening today"
                          IsChecked="{Binding IsEarlyRideTimeEnabled}"
                          AutomationProperties.Name="Early Ride Time is happening today" />
                <StackPanel Spacing="8" IsVisible="{Binding IsEarlyRideTimeEnabled}">
                  <TextBox Text="{Binding EarlyRideTimeDetailsText}"
                           PlaceholderText="e.g. 9:00 AM – 10:00 AM, first two rows only"
                           AutomationProperties.Name="Early Ride Time details" />
                  <StackPanel Spacing="0">
                    <TextBox Text="{Binding ParticipatingAttractionsText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="64"
                             PlaceholderText="Participating attractions, one per line"
                             AutomationProperties.Name="Participating attractions" />
                    <TextBlock Text="One attraction per line." Classes="fieldHint" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Daily Fun" Classes="sectionTitle" />
                <ComboBox ItemsSource="{Binding DailyFunTypeOptions}"
                          SelectedItem="{Binding SelectedDailyFunTypeOption}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Daily Fun type">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="presentation:DailyFunTypeOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Text="{Binding DailyFunText}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="56"
                         PlaceholderText="Enter the question, fact, or quote"
                         AutomationProperties.Name="Daily Fun text" />
              </StackPanel>
            </Border>

          </StackPanel>
        </Grid>

        <!-- Operational notes (Part E): full width, comfortable multiline entry. -->
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Operational Notes" Classes="sectionTitle" />
            <TextBox Text="{Binding OperationalNotesText}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="110"
                     PlaceholderText="Important operational notes, one line per note"
                     AutomationProperties.Name="Operational notes" />
          </StackPanel>
        </Border>

        <!-- Products (Part F): editable, data-driven per-category product sections. No product
             names or category counts are hard-coded — sections and rows come straight from the
             composed workspace. -->
        <ItemsControl ItemsSource="{Binding ProductSections}"
                      IsVisible="{Binding HasProductSections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProductCategorySectionViewModel">
              <Border Classes="panel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding CategoryDisplayName}" Classes="sectionTitle" />

                  <Border Classes="inset" IsVisible="{Binding HasStatus}" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Status.StatusText}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Status.DetailText}"
                                 IsVisible="{Binding Status.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="muted" />
                    </StackPanel>
                  </Border>

                  <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProductRowViewModel">
                        <Border Classes="productRow">
                          <Grid ColumnDefinitions="Auto,*,200">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IncludeOnPdf}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,10,0"
                                      AutomationProperties.Name="{Binding DisplayName, StringFormat='Include {0} on the PDF'}" />

                            <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding OfficialPriceText, StringFormat='Official {0}'}" Classes="muted" />
                                <TextBlock Text="{Binding ComparisonPriceText, StringFormat='Compare at {0}'}"
                                           IsVisible="{Binding ComparisonPriceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Classes="muted" />
                              </StackPanel>
                              <TextBlock Text="{Binding PriceQualifier}"
                                         IsVisible="{Binding HasPriceQualifier}"
                                         Classes="muted" FontStyle="Italic" />
                              <TextBlock Text="{Binding VerificationNoteText}"
                                         IsVisible="{Binding VerificationNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         Classes="fieldWarning" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2">
                              <TextBox Text="{Binding DisplayPriceOverrideText}"
                                       PlaceholderText="{Binding OverridePlaceholderText}"
                                       AutomationProperties.Name="{Binding DisplayName, StringFormat='Display price override for {0}'}" />
                              <TextBlock Text="{Binding DisplayPriceOverrideError}"
                                         IsVisible="{Binding DisplayPriceOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         Classes="fieldError" />
                              <Button Content="Use official price"
                                      Command="{Binding ResetToOfficialCommand}"
                                      IsVisible="{Binding HasOverride}"
                                      Margin="0,2,0,0"
                                      AutomationProperties.Name="{Binding DisplayName, StringFormat='Use official price for {0}'}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Custom / internal products (Part F): draft-local only, never backed by an official id;
             visually distinct from source-verified official products via the "Custom" tag on each row. -->
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Custom &amp; Internal Items" Classes="sectionTitle" />
              <Button Grid.Column="1"
                      Content="Add custom item"
                      Command="{Binding AddCustomProductCommand}"
                      AutomationProperties.Name="Add a custom or internal product" />
            </Grid>

            <TextBlock Text="Add group rates, buyouts, or other items not sold through the normal ticket site."
                       Classes="muted"
                       IsVisible="{Binding !HasCustomProducts}" />

            <ItemsControl ItemsSource="{Binding CustomProducts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomProductRowViewModel">
                  <Border Classes="inset" Margin="0">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IncludeOnPdf}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Include {0} on the PDF'}" />
                        <Border Grid.Column="1" Classes="chip" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="Custom" />
                        </Border>
                        <TextBox Grid.Column="2"
                                 Text="{Binding DisplayNameText}"
                                 PlaceholderText="Item name"
                                 AutomationProperties.Name="Custom item name" />
                        <Button Grid.Column="3"
                                Content="Remove"
                                Command="{Binding RemoveCommand}"
                                Margin="10,0,0,0"
                                AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Remove {0}'}" />
                      </Grid>
                      <Grid ColumnDefinitions="200,*">
                        <StackPanel Grid.Column="0" Spacing="0">
                          <TextBlock Text="Price" Classes="fieldLabel" />
                          <TextBox Text="{Binding PriceText}"
                                   PlaceholderText="Optional"
                                   AutomationProperties.Name="Custom item price" />
                          <TextBlock Text="{Binding PriceError}"
                                     IsVisible="{Binding PriceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="fieldError" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="0" Margin="16,0,0,0">
                          <TextBlock Text="Notes" Classes="fieldLabel" />
                          <TextBox Text="{Binding NotesText}"
                                   PlaceholderText="Optional"
                                   AutomationProperties.Name="Custom item notes" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
