<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:spell="using:Carowinds.Passdown.Desktop.Spelling"
             xmlns:controls="using:Carowinds.Passdown.Desktop.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:converters="using:Carowinds.Passdown.Desktop.Converters"
             xmlns:documents="using:Carowinds.Passdown.Documents.Associate"
             xmlns:preferences="using:Carowinds.Passdown.Application.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.AssociateView"
             x:DataType="vm:AssociateViewModel">

  <UserControl.Resources>
    <converters:ParkHoursBadgeBrushConverter x:Key="BadgeBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Associate deltas on the shared styles (Themes/PassdownStyles.axaml, Phase 22A): compact,
         single-line labels and slightly smaller inline validation for the dense editor grid. -->
    <Style Selector="TextBlock.subsectionTitle">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.fieldError">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.priorityText">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.copyError">
      <Setter Property="Foreground" Value="{DynamicResource PassdownErrorBrush}" />
    </Style>

    <!-- Phase 13D Part Z/AA/AT: a conspicuous, persistent warning shown near Create PDF whenever the
         most recently generated PDF exceeded one page — deliberately not the small "fieldWarning"
         helper-text style (spec: "do not use a subtle helper-text style"). Text alone states the
         fact (never color-only); the amber border/tint is a supplement. -->
    <Style Selector="Border.multiPageWarning">
      <Setter Property="Background" Value="{DynamicResource PassdownWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusCard}" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.multiPageWarning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Phase 21B: date header + toolbar. Quiet, outlined controls in the app's divider/accent
         colors; one height (34px) for every control on the bar so the row reads as one unit. -->
    <Style Selector="Button.dateNavIcon, Button.dateButton, Button.toolbarButton">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Phase 21D: the Daily Feature "∑ Math" picker — a small quiet outlined control, same family as the toolbar. -->
    <Style Selector="Button.mathPicker">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.mathPicker:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.mathPicker:flyout-open /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownSelectedForegroundBrush}" />
    </Style>
    <Style Selector="Button.dateNavIcon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dateButton">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinWidth" Value="360" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.toolbarButton">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dateNavIcon:pointerover /template/ ContentPresenter, Button.dateButton:pointerover /template/ ContentPresenter, Button.toolbarButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.dateNavIcon:pressed /template/ ContentPresenter, Button.dateButton:pressed /template/ ContentPresenter, Button.toolbarButton:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownPressedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.dateButton:flyout-open /template/ ContentPresenter, Button.toolbarButton:flyout-open /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Path.navGlyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stroke" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.navGlyph.small">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Path.calendarGlyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stroke" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.selectedDate">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Today/Yesterday/Tomorrow next to the date: the word carries the meaning; "Today" additionally
         gets the accent chip. -->
    <Style Selector="Border.relativeDayChip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.relativeDayChip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.relativeDayChip.today">
      <Setter Property="Background" Value="{DynamicResource PassdownChipAccentBrush}" />
    </Style>
    <Style Selector="Border.relativeDayChip.today TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownChipAccentForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.buttonDetail">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Calendar popup: compact (Fluent's default day text is 20px), selected day
         as a filled accent tile with bold text, today as an accent ring — so the two never rely on
         the same cue, and a selected today shows both. Adjacent-month days stay muted (Fluent). -->
    <Style Selector="FlyoutPresenter.datePopup">
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusPopup}" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar /template/ CalendarItem /template/ Border#BackgroundLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar /template/ CalendarItem /template/ Grid#PART_YearView">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar /template/ CalendarItem /template/ Button#PART_HeaderButton">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton, Calendar.datePopupCalendar CalendarButton">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton">
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton /template/ Border#Root, Calendar.datePopupCalendar CalendarDayButton /template/ Border#Border">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <!-- Phase 22F: adjacent-month days are muted text on the popup surface. Fluent's out-of-scope fill made
         them read as emphasized gray tiles in both themes — the opposite of "muted". -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:inactive /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextMutedBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
    </Style>
    <!-- Today: accent ring + bold accent text (no fill). -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:today /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:today /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:today /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Selected: filled accent tile + bold white text. -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextOnAccentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Selected and today: the fill plus a light inner ring. -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected:today /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownFocusBorderBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarButton:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- One height for every action on the bar. -->
    <Style Selector="StackPanel#PassdownActions > Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Glance-panel column divider (Today at a Glance). -->
    <Style Selector="Rectangle.glanceDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Margin" Value="16,2" />
    </Style>

    <!-- Section rail (Parts 2/3; Phase 10C Part F): a compact left navigation strip so the Associate
         page reads as an app-shell with sections (Overview / Products / Notes) instead of one long
         scrolling form. Only in-page section switching — not a workflow/mode selector (Manager
         remains deferred per CLAUDE.md; MainWindow.axaml). Plain Button + a view-model-bound "active"
         class, the same pattern MainWindow.axaml's own top-level section strip already uses — not
         ToggleButton: AssociateViewModel.SelectedSection is now the single source of truth (so
         MainViewModel can drive a Dashboard "Open Notes" deep link, spec Part F), and a one-way
         Classes binding to Is*SectionSelected can never drift out of sync the way ToggleButton's own
         click-toggled IsChecked required explicit code-behind mutual exclusion to prevent. Not
         TabControl: it eagerly populates its Items collection during XAML load (requires dispatcher
         access, breaks headless construction tests). -->
    <Style Selector="Button.railItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.railItem.active">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownSelectedForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <!-- Phase 22F: the same convention as the app's section strip (Button.appSectionItem.active) —
           screen readers hear which Associate section is showing, not only sighted users. -->
      <Setter Property="AutomationProperties.ItemStatus" Value="Current section" />
    </Style>
    <Style Selector="Button.railItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button.railItem.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownSelectedForegroundBrush}" />
    </Style>

    <!-- Phase 22D: rail count (Notes) — secondary to the label, never the only cue. -->
    <Style Selector="Button.railItem TextBlock.railCount">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Phase 22D: where a value comes from, in words. "Official" (from Carowinds sources) uses the
         accent chip; "Entered here" (typed in this passdown) and "Your setting" use the neutral chip.
         The word carries the meaning; the tint only reinforces it. -->
    <Style Selector="Border.sourceTag">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusSmall}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sourceTag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeTableHeader}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.sourceTag.official">
      <Setter Property="Background" Value="{DynamicResource PassdownChipAccentBrush}" />
    </Style>
    <Style Selector="Border.sourceTag.official TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownChipAccentForegroundBrush}" />
    </Style>

    <!-- Group heading inside the Overview panel: small uppercase label + source tag on one line. -->
    <Style Selector="StackPanel.groupHeader">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="StackPanel.groupHeader > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeTableHeader}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Hairline between Overview groups (whitespace + one line, not nested boxes). -->
    <Style Selector="Rectangle.groupDivider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource PassdownDividerBrush}" />
    </Style>
    <!-- Separates Check Online from the passdown output actions on the toolbar. -->
    <Style Selector="Rectangle.toolbarDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource PassdownBorderBrush}" />
    </Style>

    <!-- Count entry (attendance, pre-solds): right-aligned digits so the two values line up. -->
    <Style Selector="TextBox.countInput">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Official price column on Products: right-aligned so amounts line up down a category. -->
    <Style Selector="TextBlock.officialPrice">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The math preview hangs off the bottom of the Daily Feature editor as one unit. -->
    <Style Selector="controls|DailyFeatureMathPreview.attachedPreview">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,4,4" />
      <Setter Property="Margin" Value="6,0,6,0" />
    </Style>

    <!-- One list row (persistent notes, shows): hairline-separated instead of a boxed card per row. -->
    <Style Selector="Border.listRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="0,8" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Action bar (spec §10.2/Part B/C): identity, date navigation, primary actions, and save/refresh
         status all live together as one coherent toolbar instead of a separate floating date bar or a
         developer-style footer. Phase 22D: the two status indicators sit on the title row, side by side
         but never merged — official-data freshness (from Carowinds sources) and the local draft's save
         state — and every transient message is collected in one feedback stack under the toolbar. -->
    <Border Grid.Row="0" Padding="24,12,24,12" Background="{DynamicResource PassdownSurfaceBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Grid.Column="0" Text="Associate Passdown" Classes="pageTitle" VerticalAlignment="Center" />

          <!-- Phase 19A: quiet status only — the shared app-wide official-data freshness line, plus a note
               while this date's missing/stale data is being checked automatically. Neither blocks the
               screen or disables any action; Check Online stays the explicit way to check right now. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="AutoCheckStatusText" Text="Checking online for this date…" Classes="muted"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsAutoCheckingDate}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="AssociateOfficialDataStatusText" Text="{Binding OfficialDataStatus.Presentation.Text}" Classes="muted"
                       TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                       IsVisible="{Binding OfficialDataStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                       AutomationProperties.Name="{Binding OfficialDataStatus.Presentation.AutomationText}"
                       ToolTip.Tip="{Binding OfficialDataStatus.Presentation.DetailText}" />
          </StackPanel>

          <!-- The one primary save-state indicator (Unsaved / Saving / Saved / Save failed / Conflict),
               labeled "Draft" so a locally saved draft is never read as verified official data.
               Text-first, never color-only. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Rectangle Classes="toolbarDivider" Height="18" Margin="0,0,4,0" />
            <TextBlock Text="Draft" Classes="muted" VerticalAlignment="Center" />
            <Border x:Name="SaveStatusChip" Classes="chip" AutomationProperties.Name="Save status"
                    AutomationProperties.HelpText="{Binding SaveStatusDetailText}"
                    ToolTip.Tip="{Binding SaveStatusDetailText}">
              <Border.Background>
                <MultiBinding Converter="{x:Static converters:SaveStatusBrushConverter.Instance}">
                  <Binding Path="AutosaveState" />
                  <Binding Path="ActualThemeVariant" ElementName="SaveStatusChip" />
                </MultiBinding>
              </Border.Background>
              <TextBlock Text="{Binding SaveStatusText, FallbackValue='Not saved yet'}" />
            </Border>
            <!-- Phase 23A: one explicit retry per press after a failed save; hidden otherwise. -->
            <Button x:Name="RetrySaveButton" Content="Retry Save" Classes="secondaryAction" VerticalAlignment="Center"
                    Command="{Binding RetrySaveCommand}"
                    IsVisible="{Binding IsSaveFailed}"
                    AutomationProperties.Name="Retry Save"
                    AutomationProperties.HelpText="{Binding SaveStatusDetailText}"
                    ToolTip.Tip="Try saving the changes on screen again" />
          </StackPanel>
        </Grid>

        <!-- Phase 21B: date navigation (left) and passdown actions (right). A WrapPanel, as in Phase
             15E, so at the 960×640 minimum or at 125–150% scaling the action group drops to its own
             line instead of clipping — no horizontal scrolling, no overlap, every action reachable. -->
        <WrapPanel x:Name="AssociateActionBar" Orientation="Horizontal" ItemSpacing="20" LineSpacing="8">

          <!-- Date navigation: ‹ [date ▾] › Today. Every change goes through AssociateViewModel's one
               SelectedDate path (flush unsaved edits → local load; never online retrieval on its own). -->
          <StackPanel x:Name="DateNavigator" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="dateNavIcon" Command="{Binding PreviousDayCommand}"
                    AutomationProperties.Name="Previous day"
                    ToolTip.Tip="Previous day">
              <Path Classes="navGlyph" Data="M 10,2 L 4,8 L 10,14" />
            </Button>

            <Button x:Name="DateButton" Classes="dateButton"
                    AutomationProperties.Name="Operating date"
                    AutomationProperties.HelpText="{Binding DateNavigation.AutomationText}"
                    ToolTip.Tip="Choose date">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft"
                        Opening="DateFlyout_OnOpening" FlyoutPresenterClasses="datePopup">
                  <StackPanel Spacing="6">
                    <!-- Built-in Calendar: arrow keys move the highlighted day, Page Up/Down change
                         month, and the month heading opens month → year views for fast jumping.
                         Not bound to SelectedDate directly: a day is committed only by a click or
                         Enter/Space (code-behind), so browsing never loads a date and Escape/clicking
                         outside closes without changing anything. -->
                    <Calendar x:Name="DateCalendar" Classes="datePopupCalendar"
                              SelectionMode="SingleDate"
                              FirstDayOfWeek="Sunday"
                              IsTodayHighlighted="{Binding IsCalendarTodayHighlighted}"
                              AutomationProperties.Name="Choose operating date"
                              AutomationProperties.HelpText="Arrow keys move between days, Enter selects. Select the month heading to jump to another month or year." />
                    <Grid ColumnDefinitions="Auto,*" Margin="6,0,6,4">
                      <Button Grid.Column="0" x:Name="CalendarTodayButton" Content="Today" Classes="linkAction"
                              Command="{Binding GoToTodayCommand}" Click="CalendarTodayButton_OnClick"
                              AutomationProperties.Name="Go to today"
                              ToolTip.Tip="Jump to today (Eastern time)" />
                      <TextBlock Grid.Column="1" Text="Select the month name to jump" Classes="fieldHint"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <!-- Fixed minimum width so stepping through dates doesn't shift the controls beside it. -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="9">
                <Path Grid.Column="0" Classes="calendarGlyph" Data="M 1.5,3.5 H 14.5 V 14.5 H 1.5 Z M 1.5,6.5 H 14.5 M 5,1.5 V 4.5 M 11,1.5 V 4.5" />
                <TextBlock Grid.Column="1" x:Name="SelectedDateText" Classes="selectedDate" Text="{Binding DateNavigation.DateText}" />
                <Border Grid.Column="2" Classes="relativeDayChip" Classes.today="{Binding DateNavigation.IsToday}"
                        IsVisible="{Binding DateNavigation.RelativeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding DateNavigation.RelativeText}" />
                </Border>
                <Path Grid.Column="4" Classes="navGlyph small" Data="M 2,5 L 8,11 L 14,5" />
              </Grid>
            </Button>

            <Button Classes="dateNavIcon" Command="{Binding NextDayCommand}"
                    AutomationProperties.Name="Next day"
                    ToolTip.Tip="Next day">
              <Path Classes="navGlyph" Data="M 6,2 L 12,8 L 6,14" />
            </Button>

            <Button Content="Today" Classes="toolbarButton" Margin="6,0,0,0"
                    Command="{Binding GoToTodayCommand}"
                    AutomationProperties.Name="Today"
                    AutomationProperties.HelpText="Selects today's date in Eastern time."
                    ToolTip.Tip="Jump to today" />
          </StackPanel>

          <!-- Passdown actions. Phase 22D hierarchy: Check Online is a quiet outlined control (always
               visible, never automatic), a divider, then the passdown outputs — Create PDF is the one
               accent button, Copy sits beside it, occasional actions live in More. Administrative
               actions (Export Diagnostics) stay in Settings → Diagnostics. -->
          <StackPanel x:Name="PassdownActions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Check Online"
                    Command="{Binding CheckOnlineCommand}"
                    Classes="toolbarButton"
                    AutomationProperties.Name="Check this date online"
                    AutomationProperties.HelpText="Checks official Carowinds sources for this date. Does not run automatically." />

            <Rectangle Classes="toolbarDivider" />

            <!-- The PDF style in use is always shown on the button itself; it is changed under
                 More → PDF Style (same saved preference as before — never changed silently). -->
            <Button Command="{Binding CreatePdfCommand}"
                    Classes="primaryAction"
                    AutomationProperties.Name="Create PDF"
                    AutomationProperties.HelpText="Builds this date's Associate Passdown PDF in the selected PDF style and lets you choose where to save it."
                    ToolTip.Tip="{Binding SelectedTemplateOption.Label, StringFormat='Uses the {0} PDF style (change under More)'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Create PDF" />
                <TextBlock Text="·" Classes="buttonDetail" />
                <TextBlock Text="{Binding SelectedTemplateOption.Label}" Classes="buttonDetail" />
              </StackPanel>
            </Button>

            <!-- Phase 18F: one compact Copy menu for pasting into Microsoft Teams. Enter/Space opens it,
                 arrow keys move between items; nothing is hover-only. Copies only what is already on
                 screen — never checks online, saves, or changes the date. -->
            <Button Content="Copy ▾"
                    Classes="secondaryAction"
                    IsEnabled="{Binding HasWorkspace}"
                    AutomationProperties.Name="Copy for Teams"
                    AutomationProperties.HelpText="Opens a menu to copy the operations summary, today's selected pricing, or both for Microsoft Teams, or to build the full morning message.">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Operations Summary"
                            Command="{Binding CopyForTeamsCommand}"
                            CommandParameter="{x:Static documents:AssociateTeamsCopyKind.OperationsSummary}"
                            AutomationProperties.Name="Copy operations summary"
                            AutomationProperties.HelpText="Copies park hours, gate times, attendance, pre-solds, and Early Ride Time." />
                  <MenuItem Header="Today's Pricing"
                            Command="{Binding CopyForTeamsCommand}"
                            CommandParameter="{x:Static documents:AssociateTeamsCopyKind.TodaysPricing}"
                            AutomationProperties.Name="Copy today's pricing"
                            AutomationProperties.HelpText="Copies only the products and sections selected for the PDF." />
                  <MenuItem Header="Operations + Pricing"
                            Command="{Binding CopyForTeamsCommand}"
                            CommandParameter="{x:Static documents:AssociateTeamsCopyKind.OperationsAndPricing}"
                            AutomationProperties.Name="Copy operations summary and pricing" />
                  <!-- Phase 29: the full morning message (composer) and OD Notes, which are always their own copy. -->
                  <Separator />
                  <MenuItem Header="Morning Message…"
                            Command="{Binding OpenMorningMessageCommand}"
                            AutomationProperties.Name="Open the morning message composer"
                            AutomationProperties.HelpText="Builds the whole Teams morning message from this passdown, with a preview and formatted or plain-text copy." />
                  <MenuItem Header="OD Notes"
                            Command="{Binding CopyOdNotesCommand}"
                            AutomationProperties.Name="Copy OD Notes"
                            AutomationProperties.HelpText="Copies this date's OD Notes on their own, to post after the morning message." />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <!-- More: occasional passdown actions, each clearly labeled. Nothing destructive lives
                 here (Associate has no delete/reset-all/finalize button — finalization stays
                 automatic, Phase 9). -->
            <Button Content="More ▾" Classes="toolbarButton"
                    AutomationProperties.Name="More passdown actions"
                    ToolTip.Tip="More passdown actions">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <!-- Flat items, not a nested submenu: a MenuItem with child MenuItems fills an
                       ItemCollection during XAML load, which needs dispatcher access and breaks
                       headless construction (the same reason this view avoids TabControl). -->
                  <MenuItem Header="PDF Style: Classic" ToggleType="Radio" GroupName="PdfStyle"
                            IsChecked="{Binding IsClassicTemplateSelected, Mode=OneWay}"
                            Command="{Binding SelectTemplateCommand}"
                            CommandParameter="{x:Static preferences:AssociatePassdownTemplate.Classic}"
                            AutomationProperties.Name="Classic PDF style"
                            AutomationProperties.HelpText="Uses the Classic template for Create PDF and the next finalized PDF. Never changes passdown data." />
                  <MenuItem Header="PDF Style: Compact" ToggleType="Radio" GroupName="PdfStyle"
                            IsChecked="{Binding IsCompactTemplateSelected, Mode=OneWay}"
                            Command="{Binding SelectTemplateCommand}"
                            CommandParameter="{x:Static preferences:AssociatePassdownTemplate.Compact}"
                            AutomationProperties.Name="Compact PDF style"
                            AutomationProperties.HelpText="Uses the Compact template for Create PDF and the next finalized PDF. Never changes passdown data." />
                  <MenuItem Header="PDF Style: Modern" ToggleType="Radio" GroupName="PdfStyle"
                            IsChecked="{Binding IsModernTemplateSelected, Mode=OneWay}"
                            Command="{Binding SelectTemplateCommand}"
                            CommandParameter="{x:Static preferences:AssociatePassdownTemplate.Modern}"
                            AutomationProperties.Name="Modern PDF style"
                            AutomationProperties.HelpText="Uses the Modern template for Create PDF and the next finalized PDF. Never changes passdown data." />
                  <Separator />
                  <MenuItem Header="Season Price History…"
                            Command="{Binding OpenPriceHistoryCommand}"
                            AutomationProperties.Name="Open Season Price History"
                            AutomationProperties.HelpText="Opens the read-only Season Price History screen. Does not change this passdown." />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </WrapPanel>

        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsBusy}" AutomationProperties.Name="Working" />

        <!-- Phase 22D: one feedback stack, visible on every section. Each line is present only while it
             has something to say (hidden lines take no space). Errors and conflicts stay full text in
             the error color; nothing critical is collapsed or hidden. -->
        <StackPanel x:Name="AssociateFeedback" Spacing="6">
          <!-- Phase 13D Part Z/AA/AT: persistent regardless of which section (Overview/Products/Notes)
               is active, and regardless of how many times Create PDF is pressed while content stays
               over one page — it only reflects the real, most recently generated page count, never a
               transient/reset-on-click state. -->
          <Border Classes="multiPageWarning" IsVisible="{Binding HasMultiPagePdfWarning}"
                  AutomationProperties.Name="{Binding MultiPageWarningText}">
            <TextBlock Text="{Binding MultiPageWarningText}" TextWrapping="Wrap" />
          </Border>

          <TextBlock Text="{Binding RefreshStatusMessage}"
                     IsVisible="{Binding RefreshStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes="muted" TextWrapping="Wrap" />

          <!-- A Check Online that could not reach every source (moved here from the Overview strip so it
               is visible on Products and Notes too). -->
          <TextBlock Text="{Binding RefreshResultMessage}"
                     IsVisible="{Binding RefreshHadFailures}"
                     Classes="fieldWarning" Margin="0" TextWrapping="Wrap" />

          <TextBlock Text="{Binding PdfExportMessage}"
                     IsVisible="{Binding PdfExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap" />

          <!-- Phase 18F: subtle Copy feedback — muted on success, error color on a clipboard failure. -->
          <TextBlock Text="{Binding CopyMessage}"
                     IsVisible="{Binding CopyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.muted="{Binding !CopyMessageIsError}"
                     Classes.copyError="{Binding CopyMessageIsError}"
                     AutomationProperties.LiveSetting="Polite" />

          <!-- Phase 23A: what was held back because the edits on screen could not be saved (date change,
               Check Online, a note change, PDF, or closing) — cleared by the next successful save. -->
          <TextBlock x:Name="SaveBlockedMessageText" Text="{Binding SaveBlockedMessage}"
                     IsVisible="{Binding SaveBlockedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PassdownErrorBrush}"
                     AutomationProperties.LiveSetting="Assertive" />

          <TextBlock Text="{Binding LoadErrorMessage}"
                     IsVisible="{Binding LoadErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PassdownErrorBrush}" />

          <!-- Phase 18B REL-004: an edit made here collided with a change from another device. Nothing
               was lost; the associate chooses which version to keep under Personal Sync conflicts. -->
          <TextBlock Text="{Binding SyncConflictMessage}"
                     IsVisible="{Binding SyncConflictMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PassdownErrorBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Main content: a section rail + section body (Parts 2/3) so the most important information
         (Park Hours, attendance, Early Ride, Daily Feature) sits above the fold on "Overview", while
         Products and full Notes editing live in their own sections instead of one long page scroll. -->
    <Grid Grid.Row="1" ColumnDefinitions="140,*">

      <Border Grid.Column="0" Background="{DynamicResource PassdownSurfaceBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PassdownDividerBrush}">
        <StackPanel Margin="0,8,0,0" Spacing="2">
          <Button Classes="railItem" Classes.active="{Binding IsOverviewSectionSelected}"
                  Content="Overview" Command="{Binding ShowOverviewSectionCommand}"
                  AutomationProperties.Name="Overview section" />
          <Button Classes="railItem" Classes.active="{Binding IsProductsSectionSelected}"
                  Content="Products" Command="{Binding ShowProductsSectionCommand}"
                  AutomationProperties.Name="Products section" />
          <!-- Phase 22D: the notes count (moved from the old Overview status strip) rides on the rail. -->
          <Button Classes="railItem" Classes.active="{Binding IsNotesSectionSelected}"
                  Command="{Binding ShowNotesSectionCommand}"
                  AutomationProperties.Name="Notes section"
                  AutomationProperties.HelpText="{Binding OperationalNotesCount, StringFormat='Operational notes: {0}'}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Text="Notes" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="railCount" Text="{Binding OperationalNotesCount}"
                         IsVisible="{Binding HasOperationalNotesCount}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Padding="20,16,20,20"
                    IsVisible="{Binding IsOverviewSectionSelected}">
          <StackPanel Spacing="12">

            <!-- Phase 22D Overview: one panel, grouped regions separated by whitespace and hairlines.
                 Each region says where its values come from: "Official" (Carowinds sources — park
                 hours) versus "Entered here" (typed into this passdown) or "Your setting" (Early Ride
                 configuration). Official values are read-only text; manual values are input boxes. -->
            <Border Classes="panel heroPanel">
            <StackPanel Spacing="10">

              <!-- Capped so on a wide window attendance stays next to the hours instead of drifting to the far edge. -->
              <Grid ColumnDefinitions="3*,28,2*" MaxWidth="1040" HorizontalAlignment="Left">

                <!-- Park hours and gates (official; gate overrides are manual and flagged). -->
                <StackPanel Grid.Column="0" Spacing="6" AutomationProperties.Name="Park hours">
                  <StackPanel Classes="groupHeader">
                    <TextBlock Text="PARK HOURS" />
                    <Border Classes="sourceTag official"><TextBlock Text="Official" /></Border>
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4">
                    <Ellipse x:Name="ParkHoursStatusDot" Width="8" Height="8" VerticalAlignment="Center">
                      <Ellipse.Fill>
                        <MultiBinding Converter="{StaticResource BadgeBrushConverter}">
                          <Binding Path="ParkHours.BadgeKind" />
                          <Binding Path="ActualThemeVariant" ElementName="ParkHoursStatusDot" />
                        </MultiBinding>
                      </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ParkHours.HeadlineText, FallbackValue='Hours not checked yet'}"
                               Classes="hoursHeadline" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center"
                               Classes.subtle="{Binding ParkHours.IsHoursUnknown}" />
                    <Border Classes="chip" VerticalAlignment="Center"
                            IsVisible="{Binding ParkHours.BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding ParkHours.BadgeText}" />
                    </Border>
                  </WrapPanel>

                  <!-- Waterpark hours / verification / stale note — collapse to zero space when absent. -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ParkHours.HasWaterparkHours}">
                      <TextBlock Text="Carolina Harbor" Classes="muted" />
                      <TextBlock Text="{Binding ParkHours.WaterparkHeadlineText}" FontWeight="Medium"
                                 AutomationProperties.Name="{Binding ParkHours.WaterparkHeadlineText, StringFormat='Carolina Harbor hours: {0}'}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ParkHours.VerificationText}"
                               IsVisible="{Binding ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ParkHours.StaleNoteText}"
                               IsVisible="{Binding ParkHours.StaleNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldWarning" TextWrapping="Wrap" />
                  </StackPanel>

                  <!-- Gates: North Gate | Avenue. Phase 18D: each shows its effective time, a subtle
                       "Override" chip while a per-date override is active, a compact override box
                       (blank = calculated default; the default is never copied in) and Reset. -->
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" Margin="0,4,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="North Gate" Classes="fieldLabel" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                        <TextBlock Text="{Binding ParkHours.NorthGateText, FallbackValue='—'}" FontWeight="Medium" VerticalAlignment="Center" MinWidth="64"
                                   AutomationProperties.Name="{Binding ParkHours.NorthGateText, StringFormat='North Gate opens {0}'}" />
                        <Border Classes="chip" IsVisible="{Binding NorthGateIsOverridden}" VerticalAlignment="Center">
                          <TextBlock Text="Override" />
                        </Border>
                        <TextBox Text="{Binding NorthGateOverrideText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="Override" MinWidth="96" VerticalAlignment="Center"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="North Gate override time" />
                        <Button Content="Reset" Classes="secondaryAction" VerticalAlignment="Center"
                                IsVisible="{Binding CanResetNorthGateOverride}"
                                Command="{Binding ResetNorthGateOverrideCommand}"
                                AutomationProperties.Name="Reset North Gate to default time" />
                      </WrapPanel>
                      <TextBlock Text="{Binding NorthGateOverrideError}"
                                 IsVisible="{Binding NorthGateOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldError" TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding NorthGateOverrideError}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Avenue" Classes="fieldLabel" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                        <TextBlock Text="{Binding ParkHours.AvenueText, FallbackValue='—'}" FontWeight="Medium" VerticalAlignment="Center" MinWidth="64"
                                   AutomationProperties.Name="{Binding ParkHours.AvenueText, StringFormat='Avenue opens {0}'}" />
                        <Border Classes="chip" IsVisible="{Binding AvenueIsOverridden}" VerticalAlignment="Center">
                          <TextBlock Text="Override" />
                        </Border>
                        <TextBox Text="{Binding AvenueOverrideText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="Override" MinWidth="96" VerticalAlignment="Center"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Avenue override time" />
                        <Button Content="Reset" Classes="secondaryAction" VerticalAlignment="Center"
                                IsVisible="{Binding CanResetAvenueOverride}"
                                Command="{Binding ResetAvenueOverrideCommand}"
                                AutomationProperties.Name="Reset Avenue to default time" />
                      </WrapPanel>
                      <TextBlock Text="{Binding AvenueOverrideError}"
                                 IsVisible="{Binding AvenueOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldError" TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding AvenueOverrideError}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <!-- Attendance and pre-solds (entered here). Phase 22D: shown with thousands separators
                     once the field loses focus ("38,500"); typing is never rewritten mid-entry. -->
                <StackPanel Grid.Column="2" Spacing="6" AutomationProperties.Name="Attendance">
                  <StackPanel Classes="groupHeader">
                    <TextBlock Text="ATTENDANCE" />
                    <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Projected" Classes="fieldLabel" Margin="0,7,0,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0">
                      <TextBox x:Name="ProjectedAttendanceTextBox" Classes="countInput"
                               Text="{Binding ProjectedAttendanceText}" PlaceholderText="Not entered"
                               LostFocus="CountTextBox_OnLostFocus"
                               AutomationProperties.Name="Projected attendance" />
                      <TextBlock Text="{Binding ProjectedAttendanceError}"
                                 IsVisible="{Binding ProjectedAttendanceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldError" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pre-solds" Classes="fieldLabel" Margin="0,7,0,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                      <TextBox x:Name="PreSoldsTextBox" Classes="countInput"
                               Text="{Binding PreSoldsText}" PlaceholderText="Not entered"
                               LostFocus="CountTextBox_OnLostFocus"
                               AutomationProperties.Name="Pre-solds" />
                      <TextBlock Text="{Binding PreSoldsError}"
                                 IsVisible="{Binding PreSoldsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldError" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>

              <Rectangle Classes="groupDivider" />

              <!-- Early Ride (Phase 17D §2: rides only, one compact Edit action — never a routine
                   start-time field, never a permanent pair of large buttons). -->
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" AutomationProperties.Name="Early Ride">
                <StackPanel Grid.Column="0" Classes="groupHeader" Margin="0" VerticalAlignment="Center">
                  <TextBlock Text="EARLY RIDE" />
                  <Border Classes="sourceTag"><TextBlock Text="Your setting" /></Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding EarlyRideTimeStatusText}"
                           FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding EarlyRideTimeStatusText, StringFormat='Early Ride: {0}'}" />
                <Button Grid.Column="2" Content="Edit" Classes="secondaryAction" VerticalAlignment="Center"
                        Command="{Binding OpenErtEditorCommand}"
                        AutomationProperties.Name="Edit Early Ride Time" />
              </Grid>

              <!-- Compact Early Ride Time editor (Phase 17D §3) — one panel with the Monthly Default
                   and Date Override sections together, opened by the single [Edit] action above. No
                   time controls anywhere in this editor. -->
              <Border Classes="inset" Margin="0" IsVisible="{Binding IsErtEditorOpen}">
                <StackPanel Spacing="8">
                  <TextBlock Text="MONTHLY DEFAULT" Classes="subsectionTitle" Margin="0" />
                  <TextBlock Text="{Binding SelectedMonthLabel}" Classes="fieldLabel" />
                  <CheckBox Content="No ERT this month"
                            IsChecked="{Binding MonthlyErtNoErt}"
                            AutomationProperties.Name="No Early Ride Time this month" />
                  <StackPanel Spacing="0" IsVisible="{Binding !MonthlyErtNoErt}">
                    <TextBox Text="{Binding MonthlyErtRidesText}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                             PlaceholderText="Participating rides, one per line"
                             AutomationProperties.Name="Monthly Early Ride Time rides" />
                    <TextBlock Text="One ride per line." Classes="fieldHint" />
                  </StackPanel>
                  <TextBox spell:SpellCheck.IsEnabled="True"
                           Text="{Binding MonthlyErtNoteText}"
                           PlaceholderText="Note (optional)"
                           AutomationProperties.Name="Monthly Early Ride Time note" />
                  <TextBlock Text="{Binding MonthlyErtSaveError}"
                             IsVisible="{Binding MonthlyErtSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldError" TextWrapping="Wrap" />
                  <Button Content="Save Monthly" Classes="primaryAction"
                          Command="{Binding SaveMonthlyErtCommand}"
                          AutomationProperties.Name="Save Monthly Early Ride Time" />

                  <Rectangle Height="1" Fill="{DynamicResource PassdownDividerBrush}" Margin="0,2,0,2" />

                  <TextBlock Text="DATE OVERRIDE" Classes="subsectionTitle" Margin="0" />
                  <CheckBox Content="{Binding UseOverrideForDateLabel}"
                            IsChecked="{Binding ErtUseOverrideForDate}"
                            AutomationProperties.Name="Use an Early Ride Time override for this date" />
                  <StackPanel Spacing="8" IsVisible="{Binding ErtUseOverrideForDate}">
                    <CheckBox Content="No ERT this date"
                              IsChecked="{Binding OverrideNoErt}"
                              AutomationProperties.Name="No Early Ride Time this date" />
                    <StackPanel Spacing="0" IsVisible="{Binding !OverrideNoErt}">
                      <TextBox Text="{Binding OverrideRidesText}"
                               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                               PlaceholderText="Override rides, one per line"
                               AutomationProperties.Name="Early Ride Time override rides" />
                      <TextBlock Text="One ride per line." Classes="fieldHint" />
                    </StackPanel>
                    <TextBox spell:SpellCheck.IsEnabled="True"
                             Text="{Binding OverrideReasonText}"
                             PlaceholderText="Reason (optional) — e.g. maintenance"
                             AutomationProperties.Name="Early Ride Time override reason" />
                    <TextBlock Text="{Binding OverrideSaveError}"
                               IsVisible="{Binding OverrideSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save Override" Classes="primaryAction"
                              Command="{Binding SaveOverrideCommand}"
                              AutomationProperties.Name="Save Early Ride Time override" />
                      <Button Content="Remove Override"
                              IsVisible="{Binding EarlyRideTimeIsOverride}"
                              Command="{Binding RemoveOverrideCommand}"
                              AutomationProperties.Name="Remove Early Ride Time override for this date" />
                    </StackPanel>
                  </StackPanel>

                  <Button Content="Close" HorizontalAlignment="Left"
                          Command="{Binding CancelErtEditorCommand}"
                          AutomationProperties.Name="Close Early Ride Time editor" />
                </StackPanel>
              </Border>

              <Rectangle Classes="groupDivider" />

              <!-- Daily Feature (entered here). Phase 21D: the editor stays plain source text; "∑ Math"
                   inserts symbols/templates at the caret; the preview appears only when the text contains
                   \( or \[ math. Phase 22D: the picker shares the type row (declared after the editor so
                   Tab order stays type → text → Math) and the preview hangs directly off the editor. -->
              <StackPanel Spacing="6" AutomationProperties.Name="Daily Feature">
                <StackPanel Classes="groupHeader">
                  <TextBlock Text="DAILY FEATURE" />
                  <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <ComboBox Grid.Row="0" Grid.Column="0"
                            ItemsSource="{Binding DailyFeatureTypeOptions}"
                            SelectedItem="{Binding SelectedDailyFeatureTypeOption}"
                            HorizontalAlignment="Left" MinWidth="220"
                            AutomationProperties.Name="Daily Feature type">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:DailyFeatureTypeOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="0">
                    <TextBox x:Name="DailyFeatureTextBox"
                             spell:SpellCheck.ExcludeMath="True"
                             spell:SpellCheck.IsEnabled="True"
                             Text="{Binding DailyFeatureText}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                             PlaceholderText="Enter the question, fact, or quote"
                             AutomationProperties.Name="Daily Feature text" />
                    <controls:DailyFeatureMathPreview Classes="attachedPreview"
                                                      Source="{Binding #DailyFeatureTextBox.Text}" />
                  </StackPanel>
                  <controls:MathSymbolPicker Grid.Row="0" Grid.Column="1" Classes="mathPicker" Margin="10,0,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Target="{Binding #DailyFeatureTextBox}" />
                </Grid>
              </StackPanel>

              <Rectangle Classes="groupDivider" />

              <!-- Manual hours override + private buyout (Part D/I/J, Phase 13E): one shared,
                   compact override area. Time entry is a typable TextBox (Phase 13E — replaces the
                   stock click-and-spin TimePicker) bound with UpdateSourceTrigger=LostFocus so
                   parsing/normalization commits once per Tab/click-away/Enter, not per keystroke
                   (Part O/P). Phase 22D: a plain group (no nested box), labeled as entered here. -->
              <StackPanel Spacing="6" AutomationProperties.Name="Hours overrides">
                <StackPanel Classes="groupHeader">
                  <TextBlock Text="HOURS OVERRIDES" />
                  <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <CheckBox Content="Manual hours override"
                              IsChecked="{Binding ManualHoursOverrideEnabled}"
                              AutomationProperties.Name="Use a manual hours override" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2"
                          IsVisible="{Binding ManualHoursOverrideEnabled}">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Open" Classes="fieldLabel" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0">
                        <TextBox Text="{Binding ManualOpeningTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="9:00 AM" MinWidth="110" HorizontalAlignment="Left"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Manual Hours Open" />
                        <TextBlock Text="{Binding ManualOpeningTimeError}"
                                   IsVisible="{Binding ManualOpeningTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding ManualOpeningTimeError}" />
                      </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Close" Classes="fieldLabel" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                        <TextBox Text="{Binding ManualClosingTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="10:00 PM" MinWidth="110" HorizontalAlignment="Left"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Manual Hours Close" />
                        <TextBlock Text="{Binding ManualClosingTimeError}"
                                   IsVisible="{Binding ManualClosingTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding ManualClosingTimeError}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ManualHoursWarningText}"
                               IsVisible="{Binding ManualHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldWarning" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="6">
                    <CheckBox Content="Private buyout / custom hours"
                              IsChecked="{Binding PrivateBuyoutEnabled}"
                              AutomationProperties.Name="Private buyout or custom hours" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2"
                          IsVisible="{Binding PrivateBuyoutEnabled}">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Open" Classes="fieldLabel" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0">
                        <TextBox Text="{Binding PrivateBuyoutOpeningTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="6:00 PM" MinWidth="110" HorizontalAlignment="Left"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Private Buyout Open" />
                        <TextBlock Text="{Binding PrivateBuyoutOpeningTimeError}"
                                   IsVisible="{Binding PrivateBuyoutOpeningTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding PrivateBuyoutOpeningTimeError}" />
                      </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Close" Classes="fieldLabel" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                        <TextBox Text="{Binding PrivateBuyoutClosingTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="11:00 PM" MinWidth="110" HorizontalAlignment="Left"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Private Buyout Close" />
                        <TextBlock Text="{Binding PrivateBuyoutClosingTimeError}"
                                   IsVisible="{Binding PrivateBuyoutClosingTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding PrivateBuyoutClosingTimeError}" />
                      </StackPanel>
                    </Grid>
                    <TextBox spell:SpellCheck.IsEnabled="True"
                             Text="{Binding PrivateBuyoutDetails}"
                             IsVisible="{Binding PrivateBuyoutEnabled}"
                             PlaceholderText="Group name, contact, or other details"
                             AutomationProperties.Name="Private buyout details" />
                    <TextBlock Text="{Binding PrivateBuyoutHoursWarningText}"
                               IsVisible="{Binding PrivateBuyoutHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldWarning" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
            </Border>

            <!-- Phase 21C: optional Shows section — the selected date's verified official shows, one
                 checkbox per show (all of a selected show's times print). New shows are never
                 pre-selected; selected shows the schedule no longer carries stay listed with a reason.
                 Phase 22D: compact two-line rows (name; times · venue) separated by hairlines. -->
            <Border Classes="panel" AutomationProperties.Name="Shows">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IncludeShows}" VerticalAlignment="Center"
                            AutomationProperties.Name="Include the Shows section in the Passdown">
                    <TextBlock Text="Shows" Classes="sectionTitle" Margin="0" />
                  </CheckBox>
                  <Border Grid.Column="1" Classes="sourceTag official"><TextBlock Text="Official schedule" /></Border>
                  <Button Grid.Column="3" Content="Select all" Classes="linkAction" VerticalAlignment="Center"
                          Command="{Binding SelectAllShowsCommand}"
                          AutomationProperties.Name="Select every show on the official schedule" />
                  <Button Grid.Column="4" Content="Clear" Classes="linkAction" VerticalAlignment="Center"
                          Command="{Binding ClearShowsCommand}"
                          AutomationProperties.Name="Clear the show selection" />
                </Grid>
                <TextBlock Text="{Binding ShowsFreshnessText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasShowsFreshnessText}" />
                <TextBlock Text="{Binding ShowsStatusText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasShowsStatusText}" />
                <ItemsControl ItemsSource="{Binding ShowRows}" IsVisible="{Binding HasShowRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssociateShowRowViewModel">
                      <Border Classes="listRow" Padding="0,6">
                        <StackPanel Spacing="0">
                          <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <WrapPanel Orientation="Horizontal" ItemSpacing="6">
                                <TextBlock Text="{Binding TimesText}" TextWrapping="Wrap" />
                                <TextBlock Text="·" Classes="muted" IsVisible="{Binding HasVenue}" />
                                <TextBlock Text="{Binding Venue}" Classes="muted" IsVisible="{Binding HasVenue}" />
                              </WrapPanel>
                            </StackPanel>
                          </CheckBox>
                          <TextBlock Text="{Binding StateNote}" Classes="fieldWarning" TextWrapping="Wrap" Margin="32,0,0,0"
                                     IsVisible="{Binding HasStateNote}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Passdown Builder section selection (Phase 8A; SCarowinds/Haunt added Phase 8B): Day
                 of week, Date, Park Hours, Attendance, and Early Ride Time above always print, and
                 Daily Feature prints whenever text is entered (Phase 18F); none has a checkbox
                 here — only these seven sections can be independently shown/hidden. -->
            <Border Classes="panel">
              <StackPanel Spacing="6">
                <TextBlock Text="Include in Passdown" Classes="sectionTitle" Margin="0" />
                <TextBlock Text="Day, date, park hours, attendance, Early Ride Time, and the Daily Feature always print. Choose which additional sections appear on the PDF."
                           Classes="muted" TextWrapping="Wrap" />
                <WrapPanel ItemSpacing="20" LineSpacing="0">
                  <CheckBox Content="Daily Admission" IsChecked="{Binding IncludeDailyAdmission}"
                            AutomationProperties.Name="Include Daily Admission in the Passdown" />
                  <CheckBox Content="Fast Lane" IsChecked="{Binding IncludeFastLane}"
                            AutomationProperties.Name="Include Fast Lane in the Passdown" />
                  <CheckBox Content="Promotions" IsChecked="{Binding IncludePromotions}"
                            AutomationProperties.Name="Include Promotions in the Passdown" />
                  <CheckBox Content="Season Passes" IsChecked="{Binding IncludeSeasonPasses}"
                            AutomationProperties.Name="Include Season Passes in the Passdown" />
                  <CheckBox Content="Add-Ons" IsChecked="{Binding IncludeAddOns}"
                            AutomationProperties.Name="Include Add-Ons in the Passdown" />
                  <CheckBox Content="SCarowinds / Haunt" IsChecked="{Binding IncludeHauntedAttractions}"
                            AutomationProperties.Name="Include SCarowinds / Haunt in the Passdown" />
                  <CheckBox Content="Operational Notes" IsChecked="{Binding IncludeOperationalNotes}"
                            AutomationProperties.Name="Include Operational Notes in the Passdown" />
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" Padding="20,16,20,20"
                    IsVisible="{Binding IsProductsSectionSelected}">
          <StackPanel Spacing="12">

            <!-- Phase 22D: one heading row — whose prices these are, and the entry point to the read-only
                 Season Price History screen (Phase 20A; also the way to reach retired products'
                 history; the same screen is under More). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Classes="groupHeader" VerticalAlignment="Center">
                <TextBlock Text="{Binding DateNavigation.DateText, StringFormat='Prices for {0}'}" />
                <Border Classes="sourceTag official"><TextBlock Text="Official" /></Border>
              </StackPanel>
              <Button Grid.Column="1" Content="Season pass price history"
                      Classes="secondaryAction"
                      Command="{Binding OpenPriceHistoryCommand}"
                      AutomationProperties.Name="Open season pass and add-on price history" />
            </Grid>

            <!-- Phase 21A: a past date shows only prices recorded for that exact date, never today's
                 catalog; this says so, and says plainly when nothing was recorded. -->
            <Border Classes="panel" IsVisible="{Binding HasHistoricalPricingNotice}">
              <TextBlock Text="{Binding HistoricalPricingNotice}" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding HistoricalPricingNotice}" />
            </Border>

            <!-- Products (Part F): editable, data-driven per-category product sections. No product
                 names or category counts are hard-coded — sections and rows come straight from the
                 composed workspace. Phase 22D: the official price has its own right-aligned column so
                 amounts line up; the display-price box (a manual override) stays in the last column. -->
            <ItemsControl ItemsSource="{Binding ProductSections}"
                          IsVisible="{Binding HasProductSections}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProductCategorySectionViewModel">
                  <Border Classes="panel">
                    <StackPanel Spacing="2">
                      <Border Classes="categoryBand">
                        <TextBlock Text="{Binding CategoryDisplayName}" />
                      </Border>

                      <!-- Category source status (freshness / not published / could not check): one
                           compact block, still never hidden. -->
                      <StackPanel Spacing="1" IsVisible="{Binding HasStatus}" Margin="2,0,0,6">
                        <TextBlock Text="{Binding Status.StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status.DetailText}"
                                   IsVisible="{Binding Status.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>

                      <!-- Phase 25: official-source attribution (Season Passes / Memberships only). -->
                      <TextBlock Text="{Binding SourceNoteText}" IsVisible="{Binding HasSourceNote}"
                                 Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,4"
                                 AutomationProperties.Name="{Binding SourceNoteText}" />

                      <!-- Phase 26: the verified official page, opened in the default browser. A real
                           Button (Tab/Enter/Space, visible focus); its text is the accessible name. -->
                      <StackPanel Spacing="2" IsVisible="{Binding HasSourceLink}" Margin="2,0,0,6">
                        <Button Classes="linkAction" HorizontalAlignment="Left"
                                Content="{Binding SourceLink.Label}"
                                Command="{Binding SourceLink.OpenCommand}"
                                AutomationProperties.Name="{Binding SourceLink.Label}"
                                AutomationProperties.HelpText="{Binding SourceLink.HelpText}"
                                ToolTip.Tip="{Binding SourceLink.HelpText}" />
                        <TextBlock Text="{Binding SourceLink.Message}" IsVisible="{Binding SourceLink.HasMessage}"
                                   Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>

                      <!-- Column headers (Part 4: denser, table-like product presentation). -->
                      <Grid ColumnDefinitions="Auto,*,120,180" IsVisible="{Binding HasProducts}" Margin="0,2,0,2">
                        <TextBlock Grid.Column="1" Text="ITEM" Classes="columnHeader" Margin="28,0,16,0" />
                        <TextBlock Grid.Column="2" Text="OFFICIAL" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="DISPLAY PRICE" Classes="columnHeader" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Border Classes="productRow">
                              <Grid ColumnDefinitions="Auto,*,120,180">
                                <!-- Phase 25: a fixed-width slot keeps a non-printable row's text aligned under ITEM. -->
                                <Panel Grid.Column="0" MinWidth="30">
                                  <CheckBox IsChecked="{Binding IncludeOnPdf}"
                                            IsVisible="{Binding CanIncludeOnPdf}"
                                            VerticalAlignment="Top"
                                            Margin="0,2,10,0"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Include {0} on the PDF'}" />
                                </Panel>

                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <!-- Phase 25: pass offers say "Reference price"; renewal offers and initiation
                                       fees are their own labeled amounts, never folded into the headline price. -->
                                  <TextBlock Text="{Binding ComparisonPriceText, StringFormat='Compare at {0}'}"
                                             IsVisible="{Binding HasCompareAtLine}"
                                             Classes="muted" />
                                  <TextBlock Text="{Binding ReferencePriceNoteText}" IsVisible="{Binding HasReferencePriceNote}"
                                             Classes="muted" AutomationProperties.Name="{Binding ReferencePriceNoteText}" />
                                  <TextBlock Text="{Binding RenewalNoteText}" IsVisible="{Binding HasRenewalNote}"
                                             Classes="muted" FontWeight="SemiBold"
                                             AutomationProperties.Name="{Binding RenewalNoteText}" />
                                  <TextBlock Text="{Binding InitiationFeeNoteText}" IsVisible="{Binding HasInitiationFeeNote}"
                                             Classes="muted" FontWeight="SemiBold"
                                             AutomationProperties.Name="{Binding InitiationFeeNoteText}" />
                                  <TextBlock Text="{Binding PriceQualifier}"
                                             IsVisible="{Binding HasPriceQualifier}"
                                             Classes="muted" FontStyle="Italic" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding BundleNoteText}"
                                             IsVisible="{Binding HasBundleNote}"
                                             Classes="muted" FontStyle="Italic" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding VerificationNoteText}"
                                             IsVisible="{Binding VerificationNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Classes="fieldWarning" TextWrapping="Wrap" />
                                  <!-- Phase 20A: only tracked Season Passes / Season Pass Add-Ons show this. -->
                                  <Button Content="Price history"
                                          Command="{Binding ViewPriceHistoryCommand}"
                                          IsVisible="{Binding HasPriceHistory}"
                                          Classes="linkAction"
                                          FontSize="12" HorizontalAlignment="Left"
                                          AutomationProperties.Name="{Binding DisplayName, StringFormat='View price history for {0}'}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding OfficialPriceText}" Classes="officialPrice"
                                           Margin="0,1,16,0" VerticalAlignment="Top"
                                           AutomationProperties.Name="{Binding OfficialPriceText, StringFormat='Official {0}'}" />

                                <TextBlock Grid.Column="3" Text="{Binding NotPrintedNoteText}" IsVisible="{Binding HasNotPrintedNote}"
                                           Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding CanIncludeOnPdf}">
                                  <TextBox Text="{Binding DisplayPriceOverrideText}"
                                           PlaceholderText="{Binding OverridePlaceholderText}"
                                           AutomationProperties.Name="{Binding DisplayName, StringFormat='Display price override for {0}'}" />
                                  <TextBlock Text="{Binding DisplayPriceOverrideError}"
                                             IsVisible="{Binding DisplayPriceOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Classes="fieldError" TextWrapping="Wrap" />
                                  <!-- Phase 22E: an override on a starting-price row still prints "From $x" (PDF semantics). -->
                                  <TextBlock Text="{Binding OverridePrintNoteText}" IsVisible="{Binding HasOverridePrintNote}"
                                             Classes="muted" TextWrapping="Wrap" />
                                  <Button Content="Use official price"
                                          Command="{Binding ResetToOfficialCommand}"
                                          IsVisible="{Binding HasOverride}"
                                          Classes="linkAction"
                                          AutomationProperties.Name="{Binding DisplayName, StringFormat='Use official price for {0}'}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom / internal products (Part F): draft-local only, never backed by an official id;
                 visually distinct from source-verified official products via the "Custom" tag on each row
                 and a neutral (non-brand-blue) accent, since these are internal entries, not verified
                 catalog items. -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="Custom &amp; Internal Items" Classes="sectionTitle" Margin="0" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                  <Button Grid.Column="3"
                          Content="Add custom item"
                          Classes="secondaryAction"
                          Command="{Binding AddCustomProductCommand}"
                          AutomationProperties.Name="Add a custom or internal product" />
                </Grid>

                <TextBlock Text="Add group rates, buyouts, or other items not sold through the normal ticket site."
                           Classes="muted"
                           IsVisible="{Binding !HasCustomProducts}" />

                <ItemsControl ItemsSource="{Binding CustomProducts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomProductRowViewModel">
                      <Border Classes="inset" Margin="0">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IncludeOnPdf}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Include {0} on the PDF'}" />
                            <Border Grid.Column="1" Classes="chip" Margin="0,0,10,0" VerticalAlignment="Center">
                              <TextBlock Text="Custom" />
                            </Border>
                            <TextBox Grid.Column="2"
                                     Text="{Binding DisplayNameText}"
                                     PlaceholderText="Item name"
                                     AutomationProperties.Name="Custom item name" />
                            <Button Grid.Column="3"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Remove {0}'}" />
                          </Grid>
                          <Grid ColumnDefinitions="200,*">
                            <StackPanel Grid.Column="0" Spacing="0">
                              <TextBlock Text="Price" Classes="fieldLabel" />
                              <TextBox Text="{Binding PriceText}"
                                       PlaceholderText="Optional"
                                       AutomationProperties.Name="Custom item price" />
                              <TextBlock Text="{Binding PriceError}"
                                         IsVisible="{Binding PriceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         Classes="fieldError" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="0" Margin="16,0,0,0">
                              <TextBlock Text="Notes" Classes="fieldLabel" />
                              <TextBox spell:SpellCheck.IsEnabled="True"
                                       Text="{Binding NotesText}"
                                       PlaceholderText="Optional"
                                       AutomationProperties.Name="Custom item notes" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" Padding="20,16,20,20"
                    IsVisible="{Binding IsNotesSectionSelected}">
        <StackPanel Spacing="12">

          <!-- Daily Passdown Notes (Part E): full width, comfortable multiline entry. Deliberately
               independent of the persistent-note sections below (Part AA) — selecting/deselecting a
               persistent note never reads or writes this text. -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Daily Passdown Notes" Classes="sectionTitle" Margin="0" VerticalAlignment="Center" />
                <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
              </StackPanel>
              <TextBox spell:SpellCheck.IsEnabled="True"
                       Text="{Binding OperationalNotesText}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="180"
                       Background="{DynamicResource PassdownSurfaceSecondaryBrush}"
                       PlaceholderText="Important operational notes, one line per note"
                       AutomationProperties.Name="Operational notes" />
              <TextBlock Text="Each line prints as its own note. Saved automatically."
                         Classes="fieldHint" Margin="0" />
            </StackPanel>
          </Border>

          <!-- Included Persistent Notes (Phase 11D Part T/V): frozen copies the supervisor has
               explicitly selected for this date — structurally distinct from the manual notes above,
               never merged into that text box. Phase 22D: hairline-separated rows, not a box per note. -->
          <Border Classes="panel">
            <StackPanel Spacing="4">
              <TextBlock Text="Included Persistent Notes" Classes="sectionTitle" Margin="0"
                         AutomationProperties.Name="Included persistent operational notes" />

              <!-- Phase 11E Part H: plain-language explanation that inclusion freezes a copy — shown
                   once for the section, not per row, since it is true for every included note. -->
              <TextBlock Text="Included notes keep the version selected for this passdown."
                         Classes="fieldHint" Margin="0"
                         IsVisible="{Binding HasSelectedOperationalNotes}" />

              <TextBlock Text="No persistent operational notes included."
                         Classes="muted"
                         IsVisible="{Binding !HasSelectedOperationalNotes}" />

              <ItemsControl ItemsSource="{Binding SelectedOperationalNotes}"
                            IsVisible="{Binding HasSelectedOperationalNotes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssociateSelectedOperationalNoteRowViewModel">
                    <Border Classes="listRow" AutomationProperties.Name="{Binding AccessibleSummary}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,0,10,0">
                            <Border Classes="chip" IsVisible="{Binding IsImportant}">
                              <TextBlock Text="Important" Classes="priorityText important" />
                            </Border>
                            <Border Classes="chip">
                              <TextBlock Text="{Binding CategoryLabel}" />
                            </Border>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Body}"
                                       IsVisible="{Binding HasBody}"
                                       Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DateRangeText}" Classes="fieldHint" Margin="0" />
                          </StackPanel>

                          <!-- Remove means "remove from this passdown", never "delete/resolve the source note" (spec Part S) — the automation name spells this out explicitly. -->
                          <Button Grid.Column="2"
                                  Content="Remove"
                                  Classes="secondaryAction"
                                  Command="{Binding RemoveCommand}"
                                  VerticalAlignment="Top"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Remove {0} from this passdown'}" />
                        </Grid>

                        <!-- Source-changed awareness (Phase 11E Parts G-L): informational only — never
                             touches the frozen Title/Body/etc. above unless the supervisor explicitly
                             clicks Replace. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSourceStatus}">
                          <TextBlock Grid.Column="0" Text="{Binding SourceStatusText}" Classes="fieldHint" Margin="0"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="Replace with Current Version"
                                  Classes="secondaryAction"
                                  Command="{Binding ReplaceCommand}"
                                  IsVisible="{Binding ShowReplaceAction}"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Replace {0} with current version'}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Available persistent-note suggestions (Phase 11D Part E/U): relevant for the
               Associate-selected date, minus whatever is already included above. Selecting is
               explicit (Add) — nothing here is ever auto-included. -->
          <Border Classes="panel">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding AvailableOperationalNoteSuggestionsHeading}" Classes="sectionTitle" Margin="0"
                         AutomationProperties.Name="Available persistent operational notes" />

              <TextBlock Text="No persistent operational notes are available for this date."
                         Classes="muted"
                         IsVisible="{Binding !HasAvailableOperationalNoteSuggestions}" />

              <ItemsControl ItemsSource="{Binding AvailableOperationalNoteSuggestions}"
                            IsVisible="{Binding HasAvailableOperationalNoteSuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssociateOperationalNoteSuggestionRowViewModel">
                    <Border Classes="listRow" AutomationProperties.Name="{Binding AccessibleSummary}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,0,10,0">
                          <Border Classes="chip" IsVisible="{Binding IsImportant}">
                            <TextBlock Text="Important" Classes="priorityText important" />
                          </Border>
                          <Border Classes="chip">
                            <TextBlock Text="{Binding CategoryLabel}" />
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DateRangeText}" Classes="fieldHint" Margin="0" />
                          <TextBlock Text="{Binding CarryForwardText}" Classes="fieldHint" Margin="0"
                                     IsVisible="{Binding HasCarryForwardText}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Add"
                                Classes="secondaryAction"
                                Command="{Binding AddCommand}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Title, StringFormat='Add note {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>

  </Grid>
</UserControl>
