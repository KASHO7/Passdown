<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:spell="using:Carowinds.Passdown.Desktop.Spelling"
             xmlns:controls="using:Carowinds.Passdown.Desktop.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:views="using:Carowinds.Passdown.Desktop.Views"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:converters="using:Carowinds.Passdown.Desktop.Converters"
             xmlns:documents="using:Carowinds.Passdown.Documents.Associate"
             xmlns:preferences="using:Carowinds.Passdown.Application.Preferences"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.AssociateView"
             x:DataType="vm:AssociateViewModel">

  <UserControl.Resources>
    <converters:ParkHoursBadgeBrushConverter x:Key="BadgeBrushConverter" />
  </UserControl.Resources>

  <!-- Phase 31C: one compact official deal row, shared by Current, Upcoming, Previously verified and
       Expired. Full terms, inferred-date notes and official links live in the View details dialog. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:DealItemViewModel" x:DataType="vm:DealItemViewModel">
      <Border Classes="productRow" Padding="2,6,2,6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Grid.Column="0" Spacing="1" AutomationProperties.Name="{Binding AccessibleSummary}">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ShortDescription}" IsVisible="{Binding HasShortDescription}"
                       Classes="muted" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ShortDescription}" />
            <TextBlock Text="{Binding NoticeText}" IsVisible="{Binding HasNoticeText}" Classes="fieldWarning" TextWrapping="Wrap" Margin="0,1,0,0" />
            <WrapPanel ItemSpacing="4" Margin="0,1,0,0">
              <TextBlock Text="{Binding MetaText}" IsVisible="{Binding HasMetaText}"
                         FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="View details" Command="{Binding ViewDetailsCommand}" IsVisible="{Binding CanViewDetails}"
                      Classes="linkAction compactLink"
                      AutomationProperties.Name="{Binding ViewDetailsAutomationName}" />
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock Text="{Binding RowPriceText}" IsVisible="{Binding HasRowPriceText}" Classes="officialPrice"
                       HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="220" />
            <TextBlock Text="{Binding RegularPriceText}" IsVisible="{Binding HasRegularPriceText}" Classes="muted"
                       HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Phase 32: one compact Pass Perk row — name, type, one meta line (requirement · confirmed dates ·
         status word when not current) and the small View details link. Status is text, never colour only. -->
    <DataTemplate DataType="vm:PassPerkItemViewModel" x:DataType="vm:PassPerkItemViewModel">
      <Border Classes="productRow" Padding="2,5,2,5">
        <StackPanel Spacing="1" AutomationProperties.Name="{Binding AccessibleSummary}">
          <WrapPanel ItemSpacing="8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Classes.muted="{Binding IsNotCurrent}" />
            <Border Classes="sourceTag" VerticalAlignment="Center"><TextBlock Text="{Binding TypeLabel}" /></Border>
          </WrapPanel>
          <TextBlock Text="{Binding NoticeText}" IsVisible="{Binding HasNoticeText}" Classes="fieldWarning" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="4">
            <TextBlock Text="{Binding MetaText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Content="View details" Command="{Binding ViewDetailsCommand}" IsVisible="{Binding CanViewDetails}"
                    Classes="linkAction compactLink"
                    AutomationProperties.Name="{Binding ViewDetailsAutomationName}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- Phase 31C: small secondary text links inside product and deal rows (View details, Price history).
         The negative left margin lines the link text up with the row text above it. -->
    <Style Selector="Button.compactLink">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="-4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Associate deltas on the shared styles (Themes/PassdownStyles.axaml, Phase 22A): compact,
         single-line labels and slightly smaller inline validation for the dense editor grid. -->
    <Style Selector="TextBlock.subsectionTitle">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.fieldError">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.priorityText">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.copyError">
      <Setter Property="Foreground" Value="{DynamicResource PassdownErrorBrush}" />
    </Style>

    <!-- Phase 13D Part Z/AA/AT: a conspicuous, persistent warning shown near Create PDF whenever the
         most recently generated PDF exceeded one page — deliberately not the small "fieldWarning"
         helper-text style (spec: "do not use a subtle helper-text style"). Text alone states the
         fact (never color-only); the amber border/tint is a supplement. -->
    <Style Selector="Border.multiPageWarning">
      <Setter Property="Background" Value="{DynamicResource PassdownWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusCard}" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.multiPageWarning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Phase 35B (was Phase 21B's outlined date header): ‹ [date ▾] › Today sit inside one quiet grouped bar,
         borderless inside it, one height (30px) so the row reads as one unit. -->
    <Style Selector="Border.dateBar">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Button.dateNavIcon, Button.dateButton, Button.dateTodayButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusSmall}" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Phase 21D: the Daily Feature "∑ Math" picker — a small quiet outlined control, same family as the toolbar. -->
    <Style Selector="Button.mathPicker">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.mathPicker:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.mathPicker:flyout-open /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownSelectedForegroundBrush}" />
    </Style>
    <Style Selector="Button.dateNavIcon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dateButton">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- A minimum width keeps ‹ › still while stepping through dates — only where the toolbar has room for it. In a
         narrower toolbar the date trims instead, so it can never push into Next day or the actions. -->
    <ContainerQuery Name="workspaceToolbar" Query="min-width:1000">
      <Style Selector="Button.dateButton">
        <Setter Property="MinWidth" Value="240" />
      </Style>
    </ContainerQuery>
    <Style Selector="Button.dateTodayButton">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeMetadata}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dateNavIcon:pointerover /template/ ContentPresenter, Button.dateButton:pointerover /template/ ContentPresenter, Button.dateTodayButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.dateNavIcon:pressed /template/ ContentPresenter, Button.dateButton:pressed /template/ ContentPresenter, Button.dateTodayButton:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownPressedBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.dateButton:flyout-open /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Path.navGlyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stroke" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.navGlyph.small">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Path.calendarGlyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stroke" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.selectedDate">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Today/Yesterday/Tomorrow next to the date: the word carries the meaning; "Today" additionally
         gets the accent chip. -->
    <Style Selector="Border.relativeDayChip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.relativeDayChip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.relativeDayChip.today">
      <Setter Property="Background" Value="{DynamicResource PassdownChipAccentBrush}" />
    </Style>
    <Style Selector="Border.relativeDayChip.today TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownChipAccentForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.buttonDetail">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Calendar popup: compact (Fluent's default day text is 20px), selected day
         as a filled accent tile with bold text, today as an accent ring — so the two never rely on
         the same cue, and a selected today shows both. Adjacent-month days stay muted (Fluent). -->
    <Style Selector="FlyoutPresenter.datePopup">
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusPopup}" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar /template/ CalendarItem /template/ Border#BackgroundLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar /template/ CalendarItem /template/ Grid#PART_YearView">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar /template/ CalendarItem /template/ Button#PART_HeaderButton">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton, Calendar.datePopupCalendar CalendarButton">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton">
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton /template/ Border#Root, Calendar.datePopupCalendar CalendarDayButton /template/ Border#Border">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <!-- Phase 22F: adjacent-month days are muted text on the popup surface. Fluent's out-of-scope fill made
         them read as emphasized gray tiles in both themes — the opposite of "muted". -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:inactive /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextMutedBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
    </Style>
    <!-- Today: accent ring + bold accent text (no fill). -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:today /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:today /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:today /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Selected: filled accent tile + bold white text. -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextOnAccentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Selected and today: the fill plus a light inner ring. -->
    <Style Selector="Calendar.datePopupCalendar CalendarDayButton:selected:today /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownFocusBorderBrush}" />
    </Style>
    <Style Selector="Calendar.datePopupCalendar CalendarButton:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- One height for both toolbar actions. -->
    <Style Selector="StackPanel#PassdownActions > Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Phase 35B section tabs (replacing the Phase 10C left rail): Overview / Products & Pricing / Shows / Notes as a
         compact horizontal strip over the editor. In-page section switching only — not a workflow or mode selector
         (Manager remains deferred per CLAUDE.md). Active = accent underline + SemiBold + primary text + "Current section"
         for screen readers (shape and weight, never colour alone); hover = a neutral underline only. -->
    <Style Selector="Border.sectionTabsBar">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="18,0,16,0" />
    </Style>
    <Style Selector="Button.sectionTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.sectionTab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <!-- Phase 22F: the same convention as the sidebar (Button.navItem.active) — screen readers hear which Associate
           section is showing, not only sighted users. -->
      <Setter Property="AutomationProperties.ItemStatus" Value="Current section" />
    </Style>
    <!-- A tab row must not jitter: no Fluent press-scale. -->
    <Style Selector="Button.sectionTab:pressed">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.sectionTab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sectionTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.sectionTab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sectionTab.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <!-- Phase 22D: Notes count — secondary to the label, never the only cue. -->
    <Style Selector="Button.sectionTab TextBlock.tabCount">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.workspaceMeta">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Phase 35B workspace toolbar: one white bar, a compact title. -->
    <Style Selector="Border.workspaceToolbar">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.pageTitle.workspaceTitle">
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="Path.menuChevron">
      <Setter Property="Stroke" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>

    <!-- Phase 35B editor surface: every section scrolls on the neutral workspace; Overview is one white sheet whose
         groups are separated by hairlines (whitespace + one line, not nested boxes). -->
    <Style Selector="ScrollViewer.sectionScroll">
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.editorSheet">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusCard}" />
      <Setter Property="Padding" Value="28,22,28,24" />
      <Setter Property="MaxWidth" Value="1100" />
    </Style>
    <Style Selector="Border.overviewSection">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="0,2,0,22" />
      <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style Selector="Border.overviewSection.last">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2,0,0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.overviewHeading">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="TextBlock.overviewTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.overviewLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.overviewCaption">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.overviewValue">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.hoursHeadline.overviewValue">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TextBlock.overviewValue.ertValue">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="StackPanel.conditionalGroup">
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="Spacing" Value="0" />
    </Style>
    <!-- Official source information: a quiet tinted note, not a card. -->
    <Style Selector="Border.sourceBox">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,18,0,0" />
    </Style>

    <!-- Phase 35B editor | preview divider: a visible track with a grip; hover and keyboard focus tint it. -->
    <Style Selector="GridSplitter.previewDivider">
      <Setter Property="Background" Value="{DynamicResource PassdownDividerBrush}" />
    </Style>
    <Style Selector="GridSplitter.previewDivider:pointerover">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="GridSplitter.previewDivider:focus-visible">
      <Setter Property="Background" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Border.dividerGrip">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource PassdownBorderStrongBrush}" />
    </Style>

    <!-- Phase 22D: where a value comes from, in words. "Official" (from Carowinds sources) uses the
         accent chip; "Entered here" (typed in this passdown) and "Your setting" use the neutral chip.
         The word carries the meaning; the tint only reinforces it. -->
    <Style Selector="Border.sourceTag">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusSmall}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sourceTag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeTableHeader}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.sourceTag.official">
      <Setter Property="Background" Value="{DynamicResource PassdownChipAccentBrush}" />
    </Style>
    <Style Selector="Border.sourceTag.official TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownChipAccentForegroundBrush}" />
    </Style>

    <!-- Group heading inside the Overview panel: small uppercase label + source tag on one line. -->
    <Style Selector="StackPanel.groupHeader">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="StackPanel.groupHeader > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeTableHeader}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!-- Count entry (attendance, pre-solds): right-aligned digits so the two values line up. -->
    <Style Selector="TextBox.countInput">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Official price column on Products: right-aligned so amounts line up down a category. -->
    <Style Selector="TextBlock.officialPrice">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The math preview hangs off the bottom of the Daily Feature editor as one unit. -->
    <Style Selector="controls|DailyFeatureMathPreview.attachedPreview">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,4,4" />
      <Setter Property="Margin" Value="6,0,6,0" />
    </Style>

    <!-- One list row (persistent notes, shows): hairline-separated instead of a boxed card per row. -->
    <Style Selector="Border.listRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="0,8" />
    </Style>

  </UserControl.Styles>

  <!-- Phase 35B (docs/phase35b-passdown-workspace-redesign.md): Ctrl+P prints the latest edits — the same command
       and generated document as Actions → Print and the preview's Print, so it works with the preview hidden. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding Preview.PrintCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <!-- Phase 35B compact workspace toolbar: title, operating date, quiet draft status (left, wrapping), then the one
         primary Create PDF and the Actions menu (right, never pushed off). Every earlier toolbar action is kept:
         Check Online, Print, Save PDF, the three Copy options, PDF style, Show/Hide Preview and Season Price History
         are all in Actions (flat items — nested MenuItems break headless construction). Show Preview also sits on
         the bar while the preview is hidden, so a hidden preview is never hard to get back. Below the bar, one
         feedback stack (Phase 22D) stays visible on every section. -->
    <Border Grid.Row="0" x:Name="PassdownToolbar" Classes="workspaceToolbar"
            Container.Name="workspaceToolbar" Container.Sizing="Width">
      <StackPanel Spacing="8">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <!-- A WrapPanel, as since Phase 15E: at 960×640 or at 125–150% scaling the date or status drops to its own
               line instead of clipping — no horizontal scrolling, no overlap, every control reachable. -->
          <WrapPanel Grid.Column="0" x:Name="AssociateActionBar" Orientation="Horizontal" ItemSpacing="14" LineSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Associate Passdown" Classes="pageTitle workspaceTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <!-- Date navigation: ‹ [date ▾] › Today in one quiet group. Every change goes through AssociateViewModel's one
                 SelectedDate path (flush unsaved edits → local load; never online retrieval on its own). -->
            <!-- A Grid, not a StackPanel: in a narrow window the date text trims instead of pushing the bar into the actions. -->
            <Border x:Name="DateNavigator" Classes="dateBar" VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
                <Button Grid.Column="0" Classes="dateNavIcon" Command="{Binding PreviousDayCommand}"
                        AutomationProperties.Name="Previous day"
                        ToolTip.Tip="Previous day">
                  <Path Classes="navGlyph" Data="M 10,2 L 4,8 L 10,14" />
                </Button>

                <Button Grid.Column="1" x:Name="DateButton" Classes="dateButton"
                        AutomationProperties.Name="Operating date"
                        AutomationProperties.HelpText="{Binding DateNavigation.AutomationText}"
                        ToolTip.Tip="Choose date">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft"
                            Opening="DateFlyout_OnOpening" FlyoutPresenterClasses="datePopup">
                      <StackPanel Spacing="6">
                        <!-- Built-in Calendar: arrow keys move the highlighted day, Page Up/Down change
                             month, and the month heading opens month → year views for fast jumping.
                             Not bound to SelectedDate directly: a day is committed only by a click or
                             Enter/Space (code-behind), so browsing never loads a date and Escape/clicking
                             outside closes without changing anything. -->
                        <Calendar x:Name="DateCalendar" Classes="datePopupCalendar"
                                  SelectionMode="SingleDate"
                                  FirstDayOfWeek="Sunday"
                                  IsTodayHighlighted="{Binding IsCalendarTodayHighlighted}"
                                  AutomationProperties.Name="Choose operating date"
                                  AutomationProperties.HelpText="Arrow keys move between days, Enter selects. Select the month heading to jump to another month or year." />
                        <Grid ColumnDefinitions="Auto,*" Margin="6,0,6,4">
                          <Button Grid.Column="0" x:Name="CalendarTodayButton" Content="Today" Classes="linkAction"
                                  Command="{Binding GoToTodayCommand}" Click="CalendarTodayButton_OnClick"
                                  AutomationProperties.Name="Go to today"
                                  ToolTip.Tip="Jump to today (Eastern time)" />
                          <TextBlock Grid.Column="1" Text="Select the month name to jump" Classes="fieldHint"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                  <!-- Minimum width so stepping through ordinary dates doesn't shift the controls beside it. -->
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Path Grid.Column="0" Classes="calendarGlyph" Data="M 1.5,3.5 H 14.5 V 14.5 H 1.5 Z M 1.5,6.5 H 14.5 M 5,1.5 V 4.5 M 11,1.5 V 4.5" />
                    <TextBlock Grid.Column="1" x:Name="SelectedDateText" Classes="selectedDate" Text="{Binding DateNavigation.DateText}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DateNavigation.DateText}" />
                    <Border Grid.Column="2" Classes="relativeDayChip" Classes.today="{Binding DateNavigation.IsToday}"
                            IsVisible="{Binding DateNavigation.RelativeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding DateNavigation.RelativeText}" />
                    </Border>
                    <Path Grid.Column="3" Classes="navGlyph small" Data="M 2,5 L 8,11 L 14,5" />
                  </Grid>
                </Button>

                <Button Grid.Column="2" Classes="dateNavIcon" Command="{Binding NextDayCommand}"
                        AutomationProperties.Name="Next day"
                        ToolTip.Tip="Next day">
                  <Path Classes="navGlyph" Data="M 6,2 L 12,8 L 6,14" />
                </Button>

                <Button Grid.Column="3" Content="Today" Classes="dateTodayButton"
                        Command="{Binding GoToTodayCommand}"
                        AutomationProperties.Name="Today"
                        AutomationProperties.HelpText="Selects today's date in Eastern time."
                        ToolTip.Tip="Jump to today" />
              </Grid>
            </Border>

            <!-- The one save-state indicator (Unsaved / Saving / Saved on this computer / Save failed), labeled
                 "Draft" so a locally saved draft is never read as verified official data or as synced to another
                 device. Text-first, never color-only. -->
            <WrapPanel x:Name="DraftStatus" Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
              <TextBlock Text="Draft" Classes="muted" VerticalAlignment="Center" />
              <Border x:Name="SaveStatusChip" Classes="chip" VerticalAlignment="Center" AutomationProperties.Name="Save status"
                      AutomationProperties.HelpText="{Binding SaveStatusDetailText}"
                      ToolTip.Tip="{Binding SaveStatusDetailText}">
                <Border.Background>
                  <MultiBinding Converter="{x:Static converters:SaveStatusBrushConverter.Instance}">
                    <Binding Path="AutosaveState" />
                    <Binding Path="ActualThemeVariant" ElementName="SaveStatusChip" />
                  </MultiBinding>
                </Border.Background>
                <TextBlock Text="{Binding SaveStatusText, FallbackValue='Not saved yet'}" TextTrimming="CharacterEllipsis" />
              </Border>
              <!-- Phase 23A: one explicit retry per press after a failed save; hidden otherwise. -->
              <Button x:Name="RetrySaveButton" Content="Retry Save" Classes="secondaryAction" VerticalAlignment="Center"
                      Command="{Binding RetrySaveCommand}"
                      IsVisible="{Binding IsSaveFailed}"
                      AutomationProperties.Name="Retry Save"
                      AutomationProperties.HelpText="{Binding SaveStatusDetailText}"
                      ToolTip.Tip="Try saving the changes on screen again" />
            </WrapPanel>
          </WrapPanel>

          <StackPanel Grid.Column="1" x:Name="PassdownActions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <!-- Phase 33 toggle, now on the bar only while the preview is hidden (Actions → Hide Preview and the
                 preview's own Hide Preview cover the other direction). Same command and saved preference. -->
            <Button x:Name="TogglePreviewButton"
                    Classes="secondaryAction"
                    Content="{Binding Preview.TogglePreviewLabel}"
                    Command="{Binding Preview.TogglePreviewCommand}"
                    AutomationProperties.Name="{Binding Preview.TogglePreviewLabel}"
                    AutomationProperties.HelpText="{Binding Preview.TogglePreviewHelpText}"
                    ToolTip.Tip="{Binding Preview.TogglePreviewHelpText}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="Preview.IsAvailable" />
                  <Binding Path="!Preview.IsPreviewPaneShown" />
                </MultiBinding>
              </Button.IsVisible>
            </Button>

            <!-- The one accent action. The PDF style in use is named in the tooltip and beside the section tabs;
                 it is changed under Actions → PDF Style (same saved preference — never changed silently). -->
            <Button x:Name="CreatePdfButton"
                    Content="Create PDF"
                    Command="{Binding CreatePdfCommand}"
                    Classes="primaryAction"
                    AutomationProperties.Name="Create PDF"
                    AutomationProperties.HelpText="Builds this date's Associate Passdown PDF in the selected PDF style and lets you choose where to save it."
                    ToolTip.Tip="{Binding SelectedTemplateOption.Label, StringFormat='Uses the {0} PDF style (change under Actions)'}" />

            <!-- Actions: every secondary passdown action, each clearly labeled; Enter/Space opens it, arrow keys move
                 between items, nothing is hover-only. Copy only copies what is on screen — never checks online,
                 saves, or changes the date. Nothing destructive lives here (finalization stays automatic, Phase 9). -->
            <Button x:Name="PassdownActionsButton" Classes="secondaryAction"
                    AutomationProperties.Name="Passdown actions"
                    AutomationProperties.HelpText="Print, Save PDF, Copy for Teams, PDF style, preview, Check Online and Season Price History."
                    ToolTip.Tip="Print, save, copy and other passdown actions">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Actions" VerticalAlignment="Center" />
                <Path Classes="navGlyph small menuChevron" Data="M 2,5 L 8,11 L 14,5" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <!-- Phase 33: the same command (and the same generated document) as the preview's Print — works
                       with the preview hidden and always prints the latest edits. -->
                  <MenuItem x:Name="AssociatePrintMenuItem" Header="Print…" InputGesture="Ctrl+P"
                            Command="{Binding Preview.PrintCommand}"
                            AutomationProperties.Name="Print Passdown"
                            AutomationProperties.HelpText="{Binding Preview.PrintHelpText}" />
                  <MenuItem x:Name="AssociateSavePdfMenuItem" Header="Save PDF…"
                            Command="{Binding Preview.SavePdfCommand}"
                            AutomationProperties.Name="Save PDF"
                            AutomationProperties.HelpText="Saves the PDF of what is on screen now. You choose where." />
                  <Separator />
                  <!-- Phase 18F: the three Copy for Teams entries, same command and parameters. -->
                  <MenuItem Header="Copy for Teams: Operations Summary"
                            Command="{Binding CopyForTeamsCommand}"
                            CommandParameter="{x:Static documents:AssociateTeamsCopyKind.OperationsSummary}"
                            AutomationProperties.Name="Copy operations summary"
                            AutomationProperties.HelpText="Copies park hours, gate times, attendance, pre-solds, and Early Ride Time for Microsoft Teams." />
                  <MenuItem Header="Copy for Teams: Today's Pricing"
                            Command="{Binding CopyForTeamsCommand}"
                            CommandParameter="{x:Static documents:AssociateTeamsCopyKind.TodaysPricing}"
                            AutomationProperties.Name="Copy today's pricing"
                            AutomationProperties.HelpText="Copies only the products and sections selected for the PDF." />
                  <MenuItem Header="Copy for Teams: Operations + Pricing"
                            Command="{Binding CopyForTeamsCommand}"
                            CommandParameter="{x:Static documents:AssociateTeamsCopyKind.OperationsAndPricing}"
                            AutomationProperties.Name="Copy operations summary and pricing" />
                  <Separator />
                  <!-- Phase 33: Show / Hide the live PDF preview (remembered on this computer). -->
                  <MenuItem x:Name="TogglePreviewMenuItem"
                            Header="{Binding Preview.TogglePreviewLabel}"
                            Command="{Binding Preview.TogglePreviewCommand}"
                            IsVisible="{Binding Preview.IsAvailable}"
                            AutomationProperties.Name="{Binding Preview.TogglePreviewLabel}"
                            AutomationProperties.HelpText="{Binding Preview.TogglePreviewHelpText}" />
                  <Separator />
                  <MenuItem Header="PDF Style: Classic" ToggleType="Radio" GroupName="PdfStyle"
                            IsChecked="{Binding IsClassicTemplateSelected, Mode=OneWay}"
                            Command="{Binding SelectTemplateCommand}"
                            CommandParameter="{x:Static preferences:AssociatePassdownTemplate.Classic}"
                            AutomationProperties.Name="Classic PDF style"
                            AutomationProperties.HelpText="Uses the Classic template for Create PDF and the next finalized PDF. Never changes passdown data." />
                  <MenuItem Header="PDF Style: Compact" ToggleType="Radio" GroupName="PdfStyle"
                            IsChecked="{Binding IsCompactTemplateSelected, Mode=OneWay}"
                            Command="{Binding SelectTemplateCommand}"
                            CommandParameter="{x:Static preferences:AssociatePassdownTemplate.Compact}"
                            AutomationProperties.Name="Compact PDF style"
                            AutomationProperties.HelpText="Uses the Compact template for Create PDF and the next finalized PDF. Never changes passdown data." />
                  <MenuItem Header="PDF Style: Modern" ToggleType="Radio" GroupName="PdfStyle"
                            IsChecked="{Binding IsModernTemplateSelected, Mode=OneWay}"
                            Command="{Binding SelectTemplateCommand}"
                            CommandParameter="{x:Static preferences:AssociatePassdownTemplate.Modern}"
                            AutomationProperties.Name="Modern PDF style"
                            AutomationProperties.HelpText="Uses the Modern template for Create PDF and the next finalized PDF. Never changes passdown data." />
                  <Separator />
                  <!-- Refresh official information: explicit, never automatic (the quiet auto-check of missing or
                       stale data for this date is separate, Phase 19A). -->
                  <MenuItem Header="Check Online (refresh official information)"
                            Command="{Binding CheckOnlineCommand}"
                            AutomationProperties.Name="Check this date online"
                            AutomationProperties.HelpText="Checks official Carowinds sources for this date. Does not run automatically." />
                  <MenuItem Header="Season Price History…"
                            Command="{Binding OpenPriceHistoryCommand}"
                            AutomationProperties.Name="Open Season Price History"
                            AutomationProperties.HelpText="Opens the read-only Season Price History screen. Does not change this passdown." />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsBusy}" AutomationProperties.Name="Working" />

        <!-- Phase 22D: one feedback stack, visible on every section. Each line is present only while it
             has something to say (hidden lines take no space). Errors and conflicts stay full text in
             the error color; nothing critical is collapsed or hidden. -->
        <StackPanel x:Name="AssociateFeedback" Spacing="6">
          <!-- Phase 13D Part Z/AA/AT: persistent regardless of which section (Overview/Products/Notes)
               is active, and regardless of how many times Create PDF is pressed while content stays
               over one page — it only reflects the real, most recently generated page count, never a
               transient/reset-on-click state. -->
          <Border Classes="multiPageWarning" IsVisible="{Binding HasMultiPagePdfWarning}"
                  AutomationProperties.Name="{Binding MultiPageWarningText}">
            <TextBlock Text="{Binding MultiPageWarningText}" TextWrapping="Wrap" />
          </Border>

          <TextBlock Text="{Binding RefreshStatusMessage}"
                     IsVisible="{Binding RefreshStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes="muted" TextWrapping="Wrap" />

          <!-- A Check Online that could not reach every source (moved here from the Overview strip so it
               is visible on Products and Notes too). -->
          <TextBlock Text="{Binding RefreshResultMessage}"
                     IsVisible="{Binding RefreshHadFailures}"
                     Classes="fieldWarning" Margin="0" TextWrapping="Wrap" />

          <TextBlock Text="{Binding PdfExportMessage}"
                     IsVisible="{Binding PdfExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap" />

          <!-- Phase 33: Print / Save PDF results (from Actions, Ctrl+P or the preview's own buttons). -->
          <TextBlock x:Name="PreviewActionMessageText"
                     Text="{Binding Preview.ActionMessage}"
                     IsVisible="{Binding Preview.ActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.muted="{Binding !Preview.ActionMessageIsError}"
                     Classes.copyError="{Binding Preview.ActionMessageIsError}"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />

          <!-- Phase 18F: subtle Copy feedback — muted on success, error color on a clipboard failure. -->
          <TextBlock Text="{Binding CopyMessage}"
                     IsVisible="{Binding CopyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.muted="{Binding !CopyMessageIsError}"
                     Classes.copyError="{Binding CopyMessageIsError}"
                     AutomationProperties.LiveSetting="Polite" />

          <!-- Phase 23A: what was held back because the edits on screen could not be saved (date change,
               Check Online, a note change, PDF, or closing) — cleared by the next successful save. -->
          <TextBlock x:Name="SaveBlockedMessageText" Text="{Binding SaveBlockedMessage}"
                     IsVisible="{Binding SaveBlockedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PassdownErrorBrush}"
                     AutomationProperties.LiveSetting="Assertive" />

          <TextBlock Text="{Binding LoadErrorMessage}"
                     IsVisible="{Binding LoadErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PassdownErrorBrush}" />

          <!-- Phase 18B REL-004: an edit made here collided with a change from another device. Nothing
               was lost; the associate chooses which version to keep under Personal Sync conflicts. -->
          <TextBlock Text="{Binding SyncConflictMessage}"
                     IsVisible="{Binding SyncConflictMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PassdownErrorBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Phase 33: editor | divider | live PDF preview. The preview column persists across Overview,
         Products, Shows and Notes (only the editor's section body changes, so switching sections never rebuilds
         the preview); widths are applied by the code-behind from Preview's clamped layout, and the divider's final
         width is remembered locally. -->
    <Grid Grid.Row="1" x:Name="AssociateBodyGrid" ColumnDefinitions="*,Auto,Auto">
    <!-- Phase 35B: the section tabs (Overview / Products & Pricing / Shows / Notes) replace the Phase 10C left rail,
         over the editor only — in the narrow preview-first layout the editor and its tabs step aside together. Each
         section keeps its own ScrollViewer alive (IsVisible), so scroll position, focus and unsaved text survive a
         switch. -->
    <Grid Grid.Column="0" x:Name="AssociateEditorPane" RowDefinitions="Auto,*"
          IsVisible="{Binding Preview.IsEditorShown}">

      <Border Grid.Row="0" x:Name="SectionTabsBar" Classes="sectionTabsBar">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
          <!-- Plain Button + a view-model-bound "active" class (the Phase 10C pattern): AssociateViewModel.SelectedSection
               is the single source of truth, so MainViewModel's Dashboard/Calendar "Open Passdown" deep links keep
               working. Not TabControl: it fills its Items during XAML load (needs the dispatcher, breaks headless
               construction tests). -->
          <StackPanel Grid.Column="0" x:Name="SectionTabs" Orientation="Horizontal" Spacing="20"
                      AutomationProperties.Name="Passdown sections">
            <Button Classes="sectionTab" Classes.active="{Binding IsOverviewSectionSelected}"
                    Content="Overview" Command="{Binding ShowOverviewSectionCommand}"
                    AutomationProperties.Name="Overview section" />
            <Button Classes="sectionTab" Classes.active="{Binding IsProductsSectionSelected}"
                    Content="Products &amp; Pricing" Command="{Binding ShowProductsSectionCommand}"
                    AutomationProperties.Name="Products section" />
            <!-- Phase 31E: Shows has its own section (show selection moved off Overview). -->
            <Button Classes="sectionTab" Classes.active="{Binding IsShowsSectionSelected}"
                    Content="Shows" Command="{Binding ShowShowsSectionCommand}"
                    AutomationProperties.Name="Shows section" />
            <!-- Phase 22D: the notes count rides on the tab. -->
            <Button Classes="sectionTab" Classes.active="{Binding IsNotesSectionSelected}"
                    Command="{Binding ShowNotesSectionCommand}"
                    AutomationProperties.Name="Notes section"
                    AutomationProperties.HelpText="{Binding OperationalNotesCount, StringFormat='Operational notes: {0}'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Notes" VerticalAlignment="Center" />
                <TextBlock Classes="tabCount" Text="{Binding OperationalNotesCount}"
                           IsVisible="{Binding HasOperationalNotesCount}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Quiet source information: the PDF style in use, then the shared app-wide official-data freshness line
               (Phase 19A) and a note while this date's missing/stale data is being checked automatically. Neither
               blocks the screen or disables any action; Actions → Check Online stays the explicit way to check now. -->
          <DockPanel Grid.Column="1" x:Name="WorkspaceMeta" HorizontalAlignment="Right" VerticalAlignment="Center" LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" x:Name="PdfStyleText" Classes="workspaceMeta" Margin="12,0,0,0"
                       Text="{Binding SelectedTemplateOption.Label, StringFormat='{}{0} PDF style'}"
                       ToolTip.Tip="Change under Actions → PDF Style" />
            <TextBlock DockPanel.Dock="Right" x:Name="AutoCheckStatusText" Text="Checking online for this date…" Classes="workspaceMeta"
                       Margin="12,0,0,0"
                       IsVisible="{Binding IsAutoCheckingDate}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="AssociateOfficialDataStatusText" Text="{Binding OfficialDataStatus.Presentation.Text}" Classes="workspaceMeta"
                       TextAlignment="Right" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding OfficialDataStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                       AutomationProperties.Name="{Binding OfficialDataStatus.Presentation.AutomationText}"
                       ToolTip.Tip="{Binding OfficialDataStatus.Presentation.DetailText}" />
          </DockPanel>
        </Grid>
      </Border>

      <!-- Phase 35B Overview: one white editing sheet on the neutral workspace, four groups separated by hairlines
           (no nested cards). Each group still says where its values come from: "Official" (Carowinds sources),
           "Entered here" (typed into this passdown) or "Your setting" (Early Ride configuration). Official values
           are read-only text; manual values are input boxes. -->
      <ScrollViewer Grid.Row="1" x:Name="OverviewSectionScroll" Classes="sectionScroll"
                    IsVisible="{Binding IsOverviewSectionSelected}">
        <Border x:Name="OverviewSheet" Classes="editorSheet">
          <StackPanel>

            <!-- Park Hours & Gates (official; gate times, manual hours and private buyout are entered here and flagged). -->
            <Border Classes="overviewSection">
              <StackPanel AutomationProperties.Name="Park hours">
                <StackPanel Classes="overviewHeading">
                  <TextBlock Text="Park Hours &amp; Gates" Classes="overviewTitle" />
                  <Border Classes="sourceTag official"><TextBlock Text="Official" /></Border>
                </StackPanel>

                <Grid x:Name="ParkHoursFields" ColumnDefinitions="1.25*,*,*" ColumnSpacing="20">
                  <!-- Main Park Hours: the official headline (read-only), status dot + badge, waterpark hours,
                       verification and stale notes (each collapses to zero space when absent). -->
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Main Park Hours" Classes="overviewLabel" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                      <Ellipse x:Name="ParkHoursStatusDot" Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Fill>
                          <MultiBinding Converter="{StaticResource BadgeBrushConverter}">
                            <Binding Path="ParkHours.BadgeKind" />
                            <Binding Path="ActualThemeVariant" ElementName="ParkHoursStatusDot" />
                          </MultiBinding>
                        </Ellipse.Fill>
                      </Ellipse>
                      <TextBlock Text="{Binding ParkHours.HeadlineText, FallbackValue='Hours not checked yet'}"
                                 Classes="hoursHeadline overviewValue" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Classes.subtle="{Binding ParkHours.IsHoursUnknown}" />
                      <Border Classes="chip" VerticalAlignment="Center"
                              IsVisible="{Binding ParkHours.BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ParkHours.BadgeText}" />
                      </Border>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ParkHours.HasWaterparkHours}" Margin="0,2,0,0">
                      <TextBlock Text="Carolina Harbor" Classes="muted" />
                      <TextBlock Text="{Binding ParkHours.WaterparkHeadlineText}" FontWeight="Medium"
                                 AutomationProperties.Name="{Binding ParkHours.WaterparkHeadlineText, StringFormat='Carolina Harbor hours: {0}'}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ParkHours.VerificationText}"
                               IsVisible="{Binding ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ParkHours.StaleNoteText}"
                               IsVisible="{Binding ParkHours.StaleNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldWarning" TextWrapping="Wrap" />
                  </StackPanel>

                  <!-- Gates (Phase 18D): each shows its effective time, a subtle "Override" chip while a per-date
                       override is active, a compact override box (blank = calculated default; the default is never
                       copied in) and Reset. -->
                  <StackPanel Grid.Column="1" Spacing="2" AutomationProperties.Name="North Gate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="North Gate" Classes="overviewLabel" />
                      <Border Classes="chip" IsVisible="{Binding NorthGateIsOverridden}" VerticalAlignment="Top" Margin="0,-2,0,0">
                        <TextBlock Text="Override" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ParkHours.NorthGateText, FallbackValue='—'}" Classes="overviewValue"
                               AutomationProperties.Name="{Binding ParkHours.NorthGateText, StringFormat='North Gate opens {0}'}" />
                    <!-- The box fills its column up to 170px and stays left-aligned (a capped star column). -->
                    <Grid ColumnSpacing="8" Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="170" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding NorthGateOverrideText, UpdateSourceTrigger=LostFocus}"
                               PlaceholderText="Override" MinWidth="96"
                               KeyDown="TimeTextBox_OnKeyDown"
                               AutomationProperties.Name="North Gate override time" />
                      <Button Grid.Column="1" Content="Reset" Classes="secondaryAction" VerticalAlignment="Center"
                              IsVisible="{Binding CanResetNorthGateOverride}"
                              Command="{Binding ResetNorthGateOverrideCommand}"
                              AutomationProperties.Name="Reset North Gate to default time" />
                    </Grid>
                    <TextBlock Text="{Binding NorthGateOverrideError}"
                               IsVisible="{Binding NorthGateOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding NorthGateOverrideError}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="2" AutomationProperties.Name="Avenue Entrance">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Avenue Entrance" Classes="overviewLabel" />
                      <Border Classes="chip" IsVisible="{Binding AvenueIsOverridden}" VerticalAlignment="Top" Margin="0,-2,0,0">
                        <TextBlock Text="Override" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ParkHours.AvenueText, FallbackValue='—'}" Classes="overviewValue"
                               AutomationProperties.Name="{Binding ParkHours.AvenueText, StringFormat='Avenue opens {0}'}" />
                    <!-- The box fills its column up to 170px and stays left-aligned (a capped star column). -->
                    <Grid ColumnSpacing="8" Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="170" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding AvenueOverrideText, UpdateSourceTrigger=LostFocus}"
                               PlaceholderText="Override" MinWidth="96"
                               KeyDown="TimeTextBox_OnKeyDown"
                               AutomationProperties.Name="Avenue override time" />
                      <Button Grid.Column="1" Content="Reset" Classes="secondaryAction" VerticalAlignment="Center"
                              IsVisible="{Binding CanResetAvenueOverride}"
                              Command="{Binding ResetAvenueOverrideCommand}"
                              AutomationProperties.Name="Reset Avenue to default time" />
                    </Grid>
                    <TextBlock Text="{Binding AvenueOverrideError}"
                               IsVisible="{Binding AvenueOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding AvenueOverrideError}" />
                  </StackPanel>
                </Grid>

                <!-- Manual hours override + private buyout (Part D/I/J, Phase 13E). The time fields appear only while
                     their checkbox is on. Time entry is a typable TextBox bound with UpdateSourceTrigger=LostFocus so
                     parsing/normalization commits once per Tab/click-away/Enter, not per keystroke (Part O/P). -->
                <StackPanel x:Name="HoursOverridesGroup" Spacing="0" Margin="0,18,0,0" AutomationProperties.Name="Hours overrides">
                  <WrapPanel Orientation="Horizontal" ItemSpacing="28" LineSpacing="6">
                    <CheckBox Content="Manual hours override"
                              IsChecked="{Binding ManualHoursOverrideEnabled}"
                              AutomationProperties.Name="Use a manual hours override" />
                    <CheckBox Content="Private buyout / custom hours"
                              IsChecked="{Binding PrivateBuyoutEnabled}"
                              AutomationProperties.Name="Private buyout or custom hours" />
                    <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                  </WrapPanel>

                  <StackPanel x:Name="ManualHoursFields" Classes="conditionalGroup" IsVisible="{Binding ManualHoursOverrideEnabled}">
                    <TextBlock Text="Manual hours" Classes="overviewLabel" />
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Left">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Open" Classes="overviewCaption" />
                        <TextBox Text="{Binding ManualOpeningTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="9:00 AM" Width="130"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Manual Hours Open" />
                        <TextBlock Text="{Binding ManualOpeningTimeError}" MaxWidth="200"
                                   IsVisible="{Binding ManualOpeningTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding ManualOpeningTimeError}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Close" Classes="overviewCaption" />
                        <TextBox Text="{Binding ManualClosingTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="10:00 PM" Width="130"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Manual Hours Close" />
                        <TextBlock Text="{Binding ManualClosingTimeError}" MaxWidth="200"
                                   IsVisible="{Binding ManualClosingTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding ManualClosingTimeError}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{Binding ManualHoursWarningText}"
                             IsVisible="{Binding ManualHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldWarning" TextWrapping="Wrap" />

                  <StackPanel x:Name="PrivateBuyoutFields" Classes="conditionalGroup" IsVisible="{Binding PrivateBuyoutEnabled}">
                    <TextBlock Text="Private buyout / custom hours" Classes="overviewLabel" />
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Open" Classes="overviewCaption" />
                        <TextBox Text="{Binding PrivateBuyoutOpeningTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="6:00 PM" Width="130"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Private Buyout Open" />
                        <TextBlock Text="{Binding PrivateBuyoutOpeningTimeError}" MaxWidth="200"
                                   IsVisible="{Binding PrivateBuyoutOpeningTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding PrivateBuyoutOpeningTimeError}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Close" Classes="overviewCaption" />
                        <TextBox Text="{Binding PrivateBuyoutClosingTimeText, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="11:00 PM" Width="130"
                                 KeyDown="TimeTextBox_OnKeyDown"
                                 AutomationProperties.Name="Private Buyout Close" />
                        <TextBlock Text="{Binding PrivateBuyoutClosingTimeError}" MaxWidth="200"
                                   IsVisible="{Binding PrivateBuyoutClosingTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding PrivateBuyoutClosingTimeError}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Details" Classes="overviewCaption" />
                        <TextBox spell:SpellCheck.IsEnabled="True"
                                 Text="{Binding PrivateBuyoutDetails}"
                                 PlaceholderText="Group name, contact, or other details"
                                 AutomationProperties.Name="Private buyout details" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{Binding PrivateBuyoutHoursWarningText}"
                             IsVisible="{Binding PrivateBuyoutHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldWarning" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Phase 31: the selected date's official events (from the official Carowinds event schedule, cached;
                     never fetched on date change), with freshness. -->
                <Border x:Name="OfficialEventsBox" Classes="sourceBox" IsVisible="{Binding HasSeasonContext}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding SeasonContext.HeadingText}" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SeasonContext.HeadingText}" />
                    <ItemsControl ItemsSource="{Binding SeasonContext.Events}" IsVisible="{Binding SeasonContext.HasEvents}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:SeasonEventLine">
                          <TextBlock TextWrapping="Wrap" AutomationProperties.Name="{Binding Name}">
                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                            <Run Text=" — " />
                            <Run Text="{Binding DateText}" />
                            <Run Text=" · " />
                            <Run Text="{Binding StatusText}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SeasonContext.NoEventText}" IsVisible="{Binding SeasonContext.HasNoEventText}"
                               Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SeasonContext.RecentlyEndedText}" IsVisible="{Binding SeasonContext.HasRecentlyEndedText}"
                               Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SeasonContext.UpcomingText}" IsVisible="{Binding SeasonContext.HasUpcomingText}"
                               Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SeasonContext.FreshnessText}" FontSize="12" TextWrapping="Wrap"
                               Classes="muted" Classes.fieldWarning="{Binding SeasonContext.IsFreshnessWarning}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Attendance (entered here; Phase 22D: thousands separators once the field loses focus — typing is never
                 rewritten mid-entry) and Early Ride (Phase 17D §2: rides only, one Edit action — never a start time). -->
            <Border Classes="overviewSection">
              <StackPanel>
                <StackPanel Classes="overviewHeading">
                  <TextBlock Text="Attendance &amp; Early Ride Time" Classes="overviewTitle" />
                  <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                </StackPanel>

                <Grid ColumnDefinitions="*,*,1.65*" ColumnSpacing="20">
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="2" AutomationProperties.Name="Attendance">
                    <!-- Each count box fills its column up to 220px, left-aligned (capped star columns). -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="220" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" MaxWidth="220" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Spacing="0">
                        <TextBlock Text="Projected Attendance" Classes="overviewLabel" />
                        <TextBox x:Name="ProjectedAttendanceTextBox" Classes="countInput"
                                 Text="{Binding ProjectedAttendanceText}" PlaceholderText="Not entered"
                                 LostFocus="CountTextBox_OnLostFocus"
                                 AutomationProperties.Name="Projected attendance" />
                        <TextBlock Text="{Binding ProjectedAttendanceError}"
                                   IsVisible="{Binding ProjectedAttendanceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="0">
                        <TextBlock Text="Pre-solds" Classes="overviewLabel" />
                        <TextBox x:Name="PreSoldsTextBox" Classes="countInput"
                                 Text="{Binding PreSoldsText}" PlaceholderText="Not entered"
                                 LostFocus="CountTextBox_OnLostFocus"
                                 AutomationProperties.Name="Pre-solds" />
                        <TextBlock Text="{Binding PreSoldsError}"
                                   IsVisible="{Binding PreSoldsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="fieldError" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="2" AutomationProperties.Name="Early Ride">
                    <!-- Label + tag wrap inside their column, so the Edit link never runs past the sheet. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="8">
                        <TextBlock Text="Early Ride Time" Classes="overviewLabel" />
                        <Border Classes="sourceTag" VerticalAlignment="Top" Margin="0,-1,0,6"><TextBlock Text="Your setting" /></Border>
                      </WrapPanel>
                      <Button Grid.Column="1" Content="Edit Attractions" Classes="linkAction compactLink" VerticalAlignment="Top" Margin="0,-3,0,0"
                              Command="{Binding OpenErtEditorCommand}"
                              AutomationProperties.Name="Edit Attractions for Early Ride Time"
                              ToolTip.Tip="Edit this month's Early Ride Time rides or override them for this date" />
                    </Grid>
                    <TextBlock Text="{Binding EarlyRideTimeStatusText}" Classes="overviewValue ertValue" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding EarlyRideTimeStatusText, StringFormat='Early Ride: {0}'}" />
                  </StackPanel>
                </Grid>

                <!-- Compact Early Ride Time editor (Phase 17D §3) — one panel with the Monthly Default and Date Override
                     sections together, opened by Edit Attractions. No time controls anywhere in this editor. -->
                <Border Classes="inset" Margin="0,14,0,0" IsVisible="{Binding IsErtEditorOpen}"
                        AutomationProperties.Name="Early Ride Time editor">
                  <StackPanel Spacing="8">
                    <TextBlock Text="MONTHLY DEFAULT" Classes="subsectionTitle" Margin="0" />
                    <TextBlock Text="{Binding SelectedMonthLabel}" Classes="fieldLabel" />
                    <CheckBox Content="No ERT this month"
                              IsChecked="{Binding MonthlyErtNoErt}"
                              AutomationProperties.Name="No Early Ride Time this month" />
                    <StackPanel Spacing="0" IsVisible="{Binding !MonthlyErtNoErt}">
                      <TextBox Text="{Binding MonthlyErtRidesText}"
                               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                               PlaceholderText="Participating rides, one per line"
                               AutomationProperties.Name="Monthly Early Ride Time rides" />
                      <TextBlock Text="One ride per line." Classes="fieldHint" />
                    </StackPanel>
                    <TextBox spell:SpellCheck.IsEnabled="True"
                             Text="{Binding MonthlyErtNoteText}"
                             PlaceholderText="Note (optional)"
                             AutomationProperties.Name="Monthly Early Ride Time note" />
                    <TextBlock Text="{Binding MonthlyErtSaveError}"
                               IsVisible="{Binding MonthlyErtSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" TextWrapping="Wrap" />
                    <Button Content="Save Monthly" Classes="primaryAction"
                            Command="{Binding SaveMonthlyErtCommand}"
                            AutomationProperties.Name="Save Monthly Early Ride Time" />

                    <Rectangle Height="1" Fill="{DynamicResource PassdownDividerBrush}" Margin="0,2,0,2" />

                    <TextBlock Text="DATE OVERRIDE" Classes="subsectionTitle" Margin="0" />
                    <CheckBox Content="{Binding UseOverrideForDateLabel}"
                              IsChecked="{Binding ErtUseOverrideForDate}"
                              AutomationProperties.Name="Use an Early Ride Time override for this date" />
                    <StackPanel Spacing="8" IsVisible="{Binding ErtUseOverrideForDate}">
                      <CheckBox Content="No ERT this date"
                                IsChecked="{Binding OverrideNoErt}"
                                AutomationProperties.Name="No Early Ride Time this date" />
                      <StackPanel Spacing="0" IsVisible="{Binding !OverrideNoErt}">
                        <TextBox Text="{Binding OverrideRidesText}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                 PlaceholderText="Override rides, one per line"
                                 AutomationProperties.Name="Early Ride Time override rides" />
                        <TextBlock Text="One ride per line." Classes="fieldHint" />
                      </StackPanel>
                      <TextBox spell:SpellCheck.IsEnabled="True"
                               Text="{Binding OverrideReasonText}"
                               PlaceholderText="Reason (optional) — e.g. maintenance"
                               AutomationProperties.Name="Early Ride Time override reason" />
                      <TextBlock Text="{Binding OverrideSaveError}"
                                 IsVisible="{Binding OverrideSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldError" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save Override" Classes="primaryAction"
                                Command="{Binding SaveOverrideCommand}"
                                AutomationProperties.Name="Save Early Ride Time override" />
                        <Button Content="Remove Override"
                                IsVisible="{Binding EarlyRideTimeIsOverride}"
                                Command="{Binding RemoveOverrideCommand}"
                                AutomationProperties.Name="Remove Early Ride Time override for this date" />
                      </StackPanel>
                    </StackPanel>

                    <Button Content="Close" HorizontalAlignment="Left"
                            Command="{Binding CancelErtEditorCommand}"
                            AutomationProperties.Name="Close Early Ride Time editor" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Daily Feature (entered here). Phase 21D: the editor stays plain source text; "∑ Math" inserts
                 symbols/templates at the caret; the rendered preview appears only when the text contains \( or \[
                 math. The picker shares the type row but is declared after the editor so Tab order stays
                 type → text → Math; the preview hangs directly off the editor. -->
            <Border Classes="overviewSection">
              <StackPanel AutomationProperties.Name="Daily Feature">
                <StackPanel Classes="overviewHeading">
                  <TextBlock Text="Daily Feature" Classes="overviewTitle" />
                  <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="0">
                    <TextBlock Text="Feature type" Classes="overviewLabel" />
                    <ComboBox ItemsSource="{Binding DailyFeatureTypeOptions}"
                              SelectedItem="{Binding SelectedDailyFeatureTypeOption}"
                              HorizontalAlignment="Left" MinWidth="230"
                              AutomationProperties.Name="Daily Feature type">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="presentation:DailyFeatureTypeOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="0">
                    <TextBox x:Name="DailyFeatureTextBox"
                             spell:SpellCheck.ExcludeMath="True"
                             spell:SpellCheck.IsEnabled="True"
                             Text="{Binding DailyFeatureText}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84"
                             PlaceholderText="Enter the question, fact, or quote"
                             AutomationProperties.Name="Daily Feature text" />
                    <controls:DailyFeatureMathPreview Classes="attachedPreview"
                                                      Source="{Binding #DailyFeatureTextBox.Text}" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="Formatting" Classes="overviewCaption" VerticalAlignment="Center" />
                    <controls:MathSymbolPicker Classes="mathPicker" VerticalAlignment="Center"
                                               Target="{Binding #DailyFeatureTextBox}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Passdown Builder section selection (Phase 8A; SCarowinds/Haunt Phase 8B; Shows Phase 31D): Day of week,
                 Date, Park Hours, Attendance and Early Ride Time always print, and the Daily Feature prints whenever text
                 is entered (Phase 18F); none has a checkbox here. These switch whole PDF sections only — which products,
                 shows and persistent notes print is chosen on their own sections. A new date starts from Settings →
                 Passdown Preferences. -->
            <Border x:Name="IncludeInPassdownPanel" Classes="overviewSection last" AutomationProperties.Name="Include in Passdown">
              <StackPanel Spacing="4">
                <StackPanel Classes="overviewHeading">
                  <TextBlock Text="Include in Passdown" Classes="overviewTitle" />
                </StackPanel>
                <TextBlock Text="Day, date, park hours, attendance, Early Ride Time, and the Daily Feature always print. Choose which additional sections appear on the PDF."
                           Classes="muted" TextWrapping="Wrap" Margin="0,-4,0,10" />

                <WrapPanel x:Name="IncludeChoices" ItemWidth="240" ItemSpacing="0" LineSpacing="2" MaxWidth="560" HorizontalAlignment="Left">
                  <CheckBox Content="Daily Admission" IsChecked="{Binding IncludeDailyAdmission}"
                            AutomationProperties.Name="Include Daily Admission in the Passdown" />
                  <CheckBox Content="Fast Lane" IsChecked="{Binding IncludeFastLane}"
                            AutomationProperties.Name="Include Fast Lane in the Passdown" />
                  <CheckBox Content="Promotions" IsChecked="{Binding IncludePromotions}"
                            AutomationProperties.Name="Include Promotions in the Passdown" />
                  <CheckBox Content="Season Passes" IsChecked="{Binding IncludeSeasonPasses}"
                            AutomationProperties.Name="Include Season Passes in the Passdown" />
                  <CheckBox Content="Add-Ons" IsChecked="{Binding IncludeAddOns}"
                            AutomationProperties.Name="Include Add-Ons in the Passdown" />
                  <CheckBox Content="SCarowinds / Haunt" IsChecked="{Binding IncludeHauntedAttractions}"
                            IsVisible="{Binding ShowHauntedOption}"
                            AutomationProperties.Name="Include SCarowinds / Haunt in the Passdown" />
                  <CheckBox Content="Operational Notes" IsChecked="{Binding IncludeOperationalNotes}"
                            AutomationProperties.Name="Include Operational Notes in the Passdown" />
                  <!-- Phase 31D: the Shows section switch. Which shows print is chosen on the Shows section. -->
                  <CheckBox x:Name="IncludeShowsCheckBox" Content="Shows" IsChecked="{Binding IncludeShows}"
                            AutomationProperties.Name="Include Shows in the Passdown"
                            AutomationProperties.HelpText="Prints the shows selected in the Shows panel" />
                </WrapPanel>
                <!-- Phase 31: why the seasonal option is not offered, or why a saved choice no longer applies. -->
                <TextBlock Text="{Binding HauntedSeasonNote}" IsVisible="{Binding HasHauntedSeasonNote}"
                           Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           AutomationProperties.Name="{Binding HauntedSeasonNote}" />
              </StackPanel>
            </Border>

          </StackPanel>
        </Border>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" Classes="sectionScroll"
                    IsVisible="{Binding IsProductsSectionSelected}">
          <StackPanel Spacing="12">

            <!-- Phase 22D: one heading row — whose prices these are, and the entry point to the read-only
                 Season Price History screen (Phase 20A; also the way to reach retired products'
                 history; the same screen is under More). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Classes="groupHeader" VerticalAlignment="Center">
                <TextBlock Text="{Binding DateNavigation.DateText, StringFormat='Prices for {0}'}" />
                <Border Classes="sourceTag official"><TextBlock Text="Official" /></Border>
              </StackPanel>
              <Button Grid.Column="1" Content="Season pass price history"
                      Classes="secondaryAction"
                      Command="{Binding OpenPriceHistoryCommand}"
                      AutomationProperties.Name="Open season pass and add-on price history" />
            </Grid>

            <!-- Phase 21A: a past date shows only prices recorded for that exact date, never today's
                 catalog; this says so, and says plainly when nothing was recorded. -->
            <Border Classes="panel" IsVisible="{Binding HasHistoricalPricingNotice}">
              <TextBlock Text="{Binding HistoricalPricingNotice}" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding HistoricalPricingNotice}" />
            </Border>

            <!-- Phase 31: official deals — current, upcoming, previously verified and expired kept
                 apart, with last-checked/last-error status and an explicit empty state. Read from the
                 cached official deals document (checked with the Promotions refresh). -->
            <Border Classes="panel" IsVisible="{Binding HasDealsPanel}">
              <StackPanel Spacing="4">
                <Border Classes="categoryBand">
                  <TextBlock Text="Current Deals" />
                </Border>
                <TextBlock Text="{Binding DealsStatusText}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,2"
                           Classes="muted" Classes.fieldWarning="{Binding IsDealsStatusWarning}"
                           AutomationProperties.Name="{Binding DealsStatusText}" />
                <TextBlock Text="{Binding DealsEmptyText}" IsVisible="{Binding HasDealsEmptyText}" Margin="2,0,0,4"
                           TextWrapping="Wrap" AutomationProperties.Name="{Binding DealsEmptyText}" />
                <!-- Phase 31C: every deal group uses the view-level compact DealItemViewModel row template
                     (name, price, one short description, confirmed deadline, View details). -->
                <ItemsControl ItemsSource="{Binding CurrentDeals}" IsVisible="{Binding HasCurrentDeals}" />
                <TextBlock Text="Upcoming offers" Classes="subsectionTitle" IsVisible="{Binding HasUpcomingDeals}" Margin="2,10,0,0" />
                <ItemsControl ItemsSource="{Binding UpcomingDeals}" IsVisible="{Binding HasUpcomingDeals}" />
                <Expander Header="{Binding PreviouslyVerifiedDealsHeaderText}" IsVisible="{Binding HasPreviouslyVerifiedDeals}"
                          Classes="disclosure" Margin="0,6,0,0"
                          AutomationProperties.Name="{Binding PreviouslyVerifiedDealsHeaderText}">
                  <ItemsControl ItemsSource="{Binding PreviouslyVerifiedDeals}" />
                </Expander>
                <Expander Header="{Binding ExpiredDealsHeaderText}" IsVisible="{Binding HasExpiredDeals}"
                          Classes="disclosure" Margin="0,6,0,0"
                          AutomationProperties.Name="{Binding ExpiredDealsHeaderText}">
                  <ItemsControl ItemsSource="{Binding ExpiredDeals}" />
                </Expander>
              </StackPanel>
            </Border>

            <!-- Phase 32: official Pass Perks for one month (publicly advertised rewards, not a guest's wallet).
                 Read from the cached official document; the month picker re-formats cached data and never
                 retrieves online. Details open in the shared View details dialog. -->
            <Border Classes="panel" IsVisible="{Binding HasPassPerksPanel}">
              <StackPanel Spacing="4" DataContext="{Binding PassPerks}" x:DataType="vm:PassPerksPanelViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Classes="categoryBand">
                    <TextBlock Text="Pass Perks" />
                  </Border>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}"
                            MinWidth="200" VerticalAlignment="Center"
                            AutomationProperties.Name="Pass Perks month" />
                </Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,2"
                           Classes="muted" Classes.fieldWarning="{Binding IsStatusWarning}"
                           AutomationProperties.Name="{Binding StatusText}" />
                <TextBlock Text="{Binding HistoryNoticeText}" IsVisible="{Binding HasHistoryNoticeText}" Margin="2,0,0,2"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding HistoryNoticeText}" />
                <TextBlock Text="{Binding EmptyStateText}" IsVisible="{Binding HasEmptyStateText}" Margin="2,0,0,4"
                           TextWrapping="Wrap" AutomationProperties.Name="{Binding EmptyStateText}" />
                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}" />
                <WrapPanel ItemSpacing="4" Margin="2,4,0,0">
                  <TextBlock Text="{Binding IndividualPassNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="640"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Content="Program terms" Command="{Binding ViewProgramTermsCommand}" IsVisible="{Binding HasProgramTerms}"
                          Classes="linkAction compactLink"
                          AutomationProperties.Name="View Pass Perks program terms" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Products (Part F): editable, data-driven per-category product sections. No product
                 names or category counts are hard-coded — sections and rows come straight from the
                 composed workspace. Phase 22D: the official price has its own right-aligned column so
                 amounts line up; the display-price box (a manual override) stays in the last column. -->
            <ItemsControl ItemsSource="{Binding ProductSections}"
                          IsVisible="{Binding HasProductSections}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProductCategorySectionViewModel">
                  <Border Classes="panel">
                    <StackPanel Spacing="2">
                      <Border Classes="categoryBand">
                        <TextBlock Text="{Binding CategoryDisplayName}" />
                      </Border>

                      <!-- Category source status (freshness / not published / could not check): one
                           compact block, still never hidden. -->
                      <StackPanel Spacing="1" IsVisible="{Binding HasStatus}" Margin="2,0,0,6">
                        <TextBlock Text="{Binding Status.StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status.DetailText}"
                                   IsVisible="{Binding Status.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>

                      <!-- Phase 25: official-source attribution (Season Passes / Memberships only). -->
                      <TextBlock Text="{Binding SourceNoteText}" IsVisible="{Binding HasSourceNote}"
                                 Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,4"
                                 AutomationProperties.Name="{Binding SourceNoteText}" />

                      <!-- Phase 26: the verified official page, opened in the default browser. A real
                           Button (Tab/Enter/Space, visible focus); its text is the accessible name. -->
                      <StackPanel Spacing="2" IsVisible="{Binding HasSourceLink}" Margin="2,0,0,6">
                        <Button Classes="linkAction" HorizontalAlignment="Left"
                                Content="{Binding SourceLink.Label}"
                                Command="{Binding SourceLink.OpenCommand}"
                                AutomationProperties.Name="{Binding SourceLink.Label}"
                                AutomationProperties.HelpText="{Binding SourceLink.HelpText}"
                                ToolTip.Tip="{Binding SourceLink.HelpText}" />
                        <TextBlock Text="{Binding SourceLink.Message}" IsVisible="{Binding SourceLink.HasMessage}"
                                   Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>

                      <!-- Column headers (Part 4: denser, table-like product presentation). -->
                      <Grid ColumnDefinitions="Auto,*,120,180" IsVisible="{Binding HasProducts}" Margin="0,2,0,2">
                        <TextBlock Grid.Column="1" Text="ITEM" Classes="columnHeader" Margin="28,0,16,0" />
                        <TextBlock Grid.Column="2" Text="OFFICIAL" Classes="columnHeader" HorizontalAlignment="Right" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="DISPLAY PRICE" Classes="columnHeader" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Border Classes="productRow">
                              <Grid ColumnDefinitions="Auto,*,120,180">
                                <!-- Phase 25: a fixed-width slot keeps a non-printable row's text aligned under ITEM. -->
                                <Panel Grid.Column="0" MinWidth="30">
                                  <CheckBox IsChecked="{Binding IncludeOnPdf}"
                                            IsVisible="{Binding CanIncludeOnPdf}"
                                            VerticalAlignment="Top"
                                            Margin="0,2,10,0"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Include {0} on the PDF'}" />
                                </Panel>

                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <!-- Phase 25: pass offers say "Reference price"; renewal offers and initiation
                                       fees are their own labeled amounts, never folded into the headline price. -->
                                  <TextBlock Text="{Binding ComparisonPriceText, StringFormat='Compare at {0}'}"
                                             IsVisible="{Binding HasCompareAtLine}"
                                             Classes="muted" />
                                  <TextBlock Text="{Binding ReferencePriceNoteText}" IsVisible="{Binding HasReferencePriceNote}"
                                             Classes="muted" AutomationProperties.Name="{Binding ReferencePriceNoteText}" />
                                  <TextBlock Text="{Binding RenewalNoteText}" IsVisible="{Binding HasRenewalNote}"
                                             Classes="muted" FontWeight="SemiBold"
                                             AutomationProperties.Name="{Binding RenewalNoteText}" />
                                  <TextBlock Text="{Binding InitiationFeeNoteText}" IsVisible="{Binding HasInitiationFeeNote}"
                                             Classes="muted" FontWeight="SemiBold"
                                             AutomationProperties.Name="{Binding InitiationFeeNoteText}" />
                                  <TextBlock Text="{Binding PriceQualifier}"
                                             IsVisible="{Binding HasPriceQualifier}"
                                             Classes="muted" FontStyle="Italic" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding BundleNoteText}"
                                             IsVisible="{Binding HasBundleNote}"
                                             Classes="muted" FontStyle="Italic" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding VerificationNoteText}"
                                             IsVisible="{Binding VerificationNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Classes="fieldWarning" TextWrapping="Wrap" />
                                  <!-- Phase 31C: one quiet line — a confirmed purchase deadline, then the small View details
                                       link (all official terms open in the in-app dialog) and Price history (Phase 20A). -->
                                  <WrapPanel ItemSpacing="4" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding CompactDeadlineText}" IsVisible="{Binding HasCompactDeadline}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="View details"
                                            Command="{Binding ViewDetailsCommand}"
                                            IsVisible="{Binding HasViewDetails}"
                                            Classes="linkAction compactLink"
                                            AutomationProperties.Name="{Binding ViewDetailsAutomationName}" />
                                    <Button Content="Price history"
                                            Command="{Binding ViewPriceHistoryCommand}"
                                            IsVisible="{Binding HasPriceHistory}"
                                            Classes="linkAction compactLink"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat='View price history for {0}'}" />
                                  </WrapPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding OfficialPriceText}" Classes="officialPrice"
                                           Margin="0,1,16,0" VerticalAlignment="Top"
                                           AutomationProperties.Name="{Binding OfficialPriceText, StringFormat='Official {0}'}" />

                                <TextBlock Grid.Column="3" Text="{Binding NotPrintedNoteText}" IsVisible="{Binding HasNotPrintedNote}"
                                           Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding CanIncludeOnPdf}">
                                  <TextBox Text="{Binding DisplayPriceOverrideText}"
                                           PlaceholderText="{Binding OverridePlaceholderText}"
                                           AutomationProperties.Name="{Binding DisplayName, StringFormat='Display price override for {0}'}" />
                                  <TextBlock Text="{Binding DisplayPriceOverrideError}"
                                             IsVisible="{Binding DisplayPriceOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Classes="fieldError" TextWrapping="Wrap" />
                                  <!-- Phase 22E: an override on a starting-price row still prints "From $x" (PDF semantics). -->
                                  <TextBlock Text="{Binding OverridePrintNoteText}" IsVisible="{Binding HasOverridePrintNote}"
                                             Classes="muted" TextWrapping="Wrap" />
                                  <Button Content="Use official price"
                                          Command="{Binding ResetToOfficialCommand}"
                                          IsVisible="{Binding HasOverride}"
                                          Classes="linkAction"
                                          AutomationProperties.Name="{Binding DisplayName, StringFormat='Use official price for {0}'}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Phase 31: current-catalog event products whose official season has ended and that no
                 official check has listed since — kept for reference (stored records and price history are
                 untouched), never shown as current and never printed. -->
            <Border Classes="panel" IsVisible="{Binding HasPastSeasonProducts}">
              <Expander Header="{Binding PastSeasonHeaderText}" Padding="4,2"
                        AutomationProperties.Name="{Binding PastSeasonHeaderText}">
                <ItemsControl ItemsSource="{Binding PastSeasonProducts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PastSeasonProductViewModel">
                      <Border Classes="productRow">
                        <Grid ColumnDefinitions="*,120">
                          <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding OfficialPriceText}" Classes="muted"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </Border>

            <!-- Custom / internal products (Part F): draft-local only, never backed by an official id;
                 visually distinct from source-verified official products via the "Custom" tag on each row
                 and a neutral (non-brand-blue) accent, since these are internal entries, not verified
                 catalog items. -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="Custom &amp; Internal Items" Classes="sectionTitle" Margin="0" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
                  <Button Grid.Column="3"
                          Content="Add custom item"
                          Classes="secondaryAction"
                          Command="{Binding AddCustomProductCommand}"
                          AutomationProperties.Name="Add a custom or internal product" />
                </Grid>

                <TextBlock Text="Add group rates, buyouts, or other items not sold through the normal ticket site."
                           Classes="muted"
                           IsVisible="{Binding !HasCustomProducts}" />

                <ItemsControl ItemsSource="{Binding CustomProducts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomProductRowViewModel">
                      <Border Classes="inset" Margin="0">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IncludeOnPdf}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Include {0} on the PDF'}" />
                            <Border Grid.Column="1" Classes="chip" Margin="0,0,10,0" VerticalAlignment="Center">
                              <TextBlock Text="Custom" />
                            </Border>
                            <TextBox Grid.Column="2"
                                     Text="{Binding DisplayNameText}"
                                     PlaceholderText="Item name"
                                     AutomationProperties.Name="Custom item name" />
                            <Button Grid.Column="3"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Remove {0}'}" />
                          </Grid>
                          <Grid ColumnDefinitions="200,*">
                            <StackPanel Grid.Column="0" Spacing="0">
                              <TextBlock Text="Price" Classes="fieldLabel" />
                              <TextBox Text="{Binding PriceText}"
                                       PlaceholderText="Optional"
                                       AutomationProperties.Name="Custom item price" />
                              <TextBlock Text="{Binding PriceError}"
                                         IsVisible="{Binding PriceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         Classes="fieldError" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="0" Margin="16,0,0,0">
                              <TextBlock Text="Notes" Classes="fieldLabel" />
                              <TextBox spell:SpellCheck.IsEnabled="True"
                                       Text="{Binding NotesText}"
                                       PlaceholderText="Optional"
                                       AutomationProperties.Name="Custom item notes" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
      </ScrollViewer>

      <!-- Phase 31E: Shows section — the selected date's official shows and the per-show selection
           (moved off Overview). Whether Shows prints is the Shows checkbox under Overview ▸ Include in
           Passdown; this page only chooses which shows print, and says whether the section is on. -->
      <ScrollViewer x:Name="ShowsSectionScroll" Grid.Row="1" Classes="sectionScroll"
                    IsVisible="{Binding IsShowsSectionSelected}">
          <!-- Fills the page up to 960px wide (readable rows; Select all / Clear stay near the names), left-aligned. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="960" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Phase 21C: optional Shows section — the selected date's verified official shows, one
                 checkbox per show (all of a selected show's times print). New shows are never
                 pre-selected; selected shows the schedule no longer carries stay listed with a reason.
                 Phase 22D: compact two-line rows (name; times · venue) separated by hairlines.
                 Phase 31D: the PDF on/off switch moved to Include in Passdown; this panel only picks shows. -->
            <Border x:Name="ShowsPanel" Classes="panel" VerticalAlignment="Top" AutomationProperties.Name="Shows">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock x:Name="ShowsTitle" Grid.Column="0" Text="Shows" Classes="sectionTitle" Margin="0" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="sourceTag official"><TextBlock Text="Official schedule" /></Border>
                  <Button Grid.Column="3" Content="Select all" Classes="linkAction" VerticalAlignment="Center"
                          Command="{Binding SelectAllShowsCommand}"
                          AutomationProperties.Name="Select every show on the official schedule" />
                  <Button Grid.Column="4" Content="Clear" Classes="linkAction" VerticalAlignment="Center"
                          Command="{Binding ClearShowsCommand}"
                          AutomationProperties.Name="Clear the show selection" />
                </Grid>
                <!-- Phase 31D: whether Shows prints is chosen under Include in Passdown; this line keeps
                     "is the section on the PDF" visibly separate from "which shows are selected". -->
                <TextBlock x:Name="ShowsInclusionStatus" Text="{Binding ShowsInclusionText}" TextWrapping="Wrap"
                           Classes="muted" Classes.fieldWarning="{Binding !IncludeShows}"
                           AutomationProperties.Name="{Binding ShowsInclusionText}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding ShowsFreshnessText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasShowsFreshnessText}" />
                <TextBlock Text="{Binding ShowsStatusText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasShowsStatusText}" />
                <ItemsControl ItemsSource="{Binding ShowRows}" IsVisible="{Binding HasShowRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssociateShowRowViewModel">
                      <Border Classes="listRow" Padding="0,6">
                        <StackPanel Spacing="0">
                          <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <WrapPanel Orientation="Horizontal" ItemSpacing="6">
                                <TextBlock Text="{Binding TimesText}" TextWrapping="Wrap" />
                                <TextBlock Text="·" Classes="muted" IsVisible="{Binding HasVenue}" />
                                <TextBlock Text="{Binding Venue}" Classes="muted" IsVisible="{Binding HasVenue}" />
                              </WrapPanel>
                            </StackPanel>
                          </CheckBox>
                          <TextBlock Text="{Binding StateNote}" Classes="fieldWarning" TextWrapping="Wrap" Margin="32,0,0,0"
                                     IsVisible="{Binding HasStateNote}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" Classes="sectionScroll"
                    IsVisible="{Binding IsNotesSectionSelected}">
        <StackPanel Spacing="12">

          <!-- Daily Passdown Notes (Part E): full width, comfortable multiline entry. Deliberately
               independent of the persistent-note sections below (Part AA) — selecting/deselecting a
               persistent note never reads or writes this text. -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Daily Passdown Notes" Classes="sectionTitle" Margin="0" VerticalAlignment="Center" />
                <Border Classes="sourceTag"><TextBlock Text="Entered here" /></Border>
              </StackPanel>
              <TextBox spell:SpellCheck.IsEnabled="True"
                       Text="{Binding OperationalNotesText}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="180"
                       Background="{DynamicResource PassdownSurfaceSecondaryBrush}"
                       PlaceholderText="Important operational notes, one line per note"
                       AutomationProperties.Name="Operational notes" />
              <TextBlock Text="Each line prints as its own note. Saved automatically."
                         Classes="fieldHint" Margin="0" />
            </StackPanel>
          </Border>

          <!-- Included Persistent Notes (Phase 11D Part T/V): frozen copies the supervisor has
               explicitly selected for this date — structurally distinct from the manual notes above,
               never merged into that text box. Phase 22D: hairline-separated rows, not a box per note. -->
          <Border Classes="panel">
            <StackPanel Spacing="4">
              <TextBlock Text="Included Persistent Notes" Classes="sectionTitle" Margin="0"
                         AutomationProperties.Name="Included persistent operational notes" />

              <!-- Phase 11E Part H: plain-language explanation that inclusion freezes a copy — shown
                   once for the section, not per row, since it is true for every included note. -->
              <TextBlock Text="Included notes keep the version selected for this passdown."
                         Classes="fieldHint" Margin="0"
                         IsVisible="{Binding HasSelectedOperationalNotes}" />

              <TextBlock Text="No persistent operational notes included."
                         Classes="muted"
                         IsVisible="{Binding !HasSelectedOperationalNotes}" />

              <ItemsControl ItemsSource="{Binding SelectedOperationalNotes}"
                            IsVisible="{Binding HasSelectedOperationalNotes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssociateSelectedOperationalNoteRowViewModel">
                    <Border Classes="listRow" AutomationProperties.Name="{Binding AccessibleSummary}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,0,10,0">
                            <Border Classes="chip" IsVisible="{Binding IsImportant}">
                              <TextBlock Text="Important" Classes="priorityText important" />
                            </Border>
                            <Border Classes="chip">
                              <TextBlock Text="{Binding CategoryLabel}" />
                            </Border>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Body}"
                                       IsVisible="{Binding HasBody}"
                                       Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DateRangeText}" Classes="fieldHint" Margin="0" />
                          </StackPanel>

                          <!-- Remove means "remove from this passdown", never "delete/resolve the source note" (spec Part S) — the automation name spells this out explicitly. -->
                          <Button Grid.Column="2"
                                  Content="Remove"
                                  Classes="secondaryAction"
                                  Command="{Binding RemoveCommand}"
                                  VerticalAlignment="Top"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Remove {0} from this passdown'}" />
                        </Grid>

                        <!-- Source-changed awareness (Phase 11E Parts G-L): informational only — never
                             touches the frozen Title/Body/etc. above unless the supervisor explicitly
                             clicks Replace. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSourceStatus}">
                          <TextBlock Grid.Column="0" Text="{Binding SourceStatusText}" Classes="fieldHint" Margin="0"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="Replace with Current Version"
                                  Classes="secondaryAction"
                                  Command="{Binding ReplaceCommand}"
                                  IsVisible="{Binding ShowReplaceAction}"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Replace {0} with current version'}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Available persistent-note suggestions (Phase 11D Part E/U): relevant for the
               Associate-selected date, minus whatever is already included above. Selecting is
               explicit (Add) — nothing here is ever auto-included. -->
          <Border Classes="panel">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding AvailableOperationalNoteSuggestionsHeading}" Classes="sectionTitle" Margin="0"
                         AutomationProperties.Name="Available persistent operational notes" />

              <TextBlock Text="No persistent operational notes are available for this date."
                         Classes="muted"
                         IsVisible="{Binding !HasAvailableOperationalNoteSuggestions}" />

              <ItemsControl ItemsSource="{Binding AvailableOperationalNoteSuggestions}"
                            IsVisible="{Binding HasAvailableOperationalNoteSuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssociateOperationalNoteSuggestionRowViewModel">
                    <Border Classes="listRow" AutomationProperties.Name="{Binding AccessibleSummary}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,0,10,0">
                          <Border Classes="chip" IsVisible="{Binding IsImportant}">
                            <TextBlock Text="Important" Classes="priorityText important" />
                          </Border>
                          <Border Classes="chip">
                            <TextBlock Text="{Binding CategoryLabel}" />
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DateRangeText}" Classes="fieldHint" Margin="0" />
                          <TextBlock Text="{Binding CarryForwardText}" Classes="fieldHint" Margin="0"
                                     IsVisible="{Binding HasCarryForwardText}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Add"
                                Classes="secondaryAction"
                                Command="{Binding AddCommand}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Title, StringFormat='Add note {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>

    <!-- Phase 35B: a visible divider track with a centred grip (decorative, not hit-testable); hover and keyboard
         focus tint it. Same splitter, same remembered width (Phase 33). -->
    <GridSplitter Grid.Column="1" x:Name="PreviewSplitter" Classes="previewDivider"
                  Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                  Focusable="True"
                  IsVisible="{Binding Preview.IsSplitLayout}"
                  AutomationProperties.Name="Resize the PDF preview"
                  AutomationProperties.HelpText="Drag, or use the Left and Right arrow keys, to change how much room the preview takes."
                  ToolTip.Tip="Drag to resize the preview" />
    <Border Grid.Column="1" x:Name="PreviewSplitterGrip" Classes="dividerGrip"
            IsHitTestVisible="False" IsVisible="{Binding Preview.IsSplitLayout}" />

    <Panel Grid.Column="2" x:Name="PreviewPaneHost" IsVisible="{Binding Preview.IsPreviewPaneShown}">
      <views:PassdownPdfPreviewView x:Name="PreviewPane" DataContext="{Binding Preview}" />
    </Panel>
    </Grid>

  </Grid>
</UserControl>
