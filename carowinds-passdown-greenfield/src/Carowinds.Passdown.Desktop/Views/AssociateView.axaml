<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:converters="using:Carowinds.Passdown.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.AssociateView"
             x:DataType="vm:AssociateViewModel">

  <UserControl.Resources>
    <converters:ParkHoursBadgeBrushConverter x:Key="BadgeBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- Typography -->
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.subsectionTitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.fieldHint">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.fieldWarning">
      <Setter Property="Foreground" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.fieldError">
      <Setter Property="Foreground" Value="{DynamicResource PassdownErrorBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Phase 13D Part Z/AA/AT: a conspicuous, persistent warning shown near Create PDF whenever the
         most recently generated PDF exceeded one page — deliberately not the small "fieldWarning"
         helper-text style (spec: "do not use a subtle helper-text style"). Text alone states the
         fact (never color-only); the amber border/tint is a supplement. -->
    <Style Selector="Border.multiPageWarning">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.multiPageWarning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Panels: one restrained, brand-tinted container style used everywhere instead of nested cards.
         Phase 17C §4/§32: tightened from the original 18/12px padding as part of the Associate
         density pass — a shared style change (deliberately not a per-view override) so Products/
         Notes/other consumers of the same style stay visually consistent (spec §2's "unless a shared
         style causes an obvious inconsistency"). -->
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceTintBrush}" />
    </Style>
    <!-- The single strongest panel on the page (Park Hours): same surface, with a brand top rule. -->
    <Style Selector="Border.heroPanel">
      <Setter Property="BorderThickness" Value="1,3,1,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource PassdownSubtleSurfaceBrush}" />
    </Style>

    <!-- Compact status chip: text-first, never color-only (spec §10.4/Part G). -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Phase 11D Part V/AS: the Priority text on an included/available persistent-note row —
         restrained accent + weight for Important, never alarm-style color, matching
         OperationalNotesView's/DashboardView's own convention exactly. -->
    <Style Selector="TextBlock.priorityText">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.priorityText.important">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownChipAccentForegroundBrush}" />
    </Style>

    <!-- Primary/secondary action buttons: Check Online is the one obvious primary action on the
         screen; Create PDF stays strong but visually secondary (spec §10.2/Part L). -->
    <Style Selector="Button.primaryAction">
      <Setter Property="Background" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownHeaderForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondaryAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondaryAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
    </Style>

    <!-- Hours headline: large when hours are known, quiet when not (Part D — "Not checked yet" must
         never be a giant headline). Phase 17C §4: reduced from 30px as part of the density pass —
         still the single largest text on Overview, just no longer disproportionate to the rest of
         the merged Day &amp; Operating Hours panel. -->
    <Style Selector="TextBlock.hoursHeadline">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
    <Style Selector="TextBlock.hoursHeadline.subtle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
    </Style>

    <!-- Product category band: a light brand-tinted strip, closer to a rate-sheet section header
         than a plain bold TextBlock. -->
    <Style Selector="Border.categoryBand">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.categoryBand TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>

    <!-- Table-style column headers above each category's product rows (Part 4: denser, more
         table-like product presentation) — labels only, columns line up with productRow below. -->
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Border.productRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="0,7" />
    </Style>

    <!-- Glance-panel column divider (Today at a Glance). -->
    <Style Selector="Rectangle.glanceDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Margin" Value="16,2" />
    </Style>

    <!-- Section rail (Parts 2/3; Phase 10C Part F): a compact left navigation strip so the Associate
         page reads as an app-shell with sections (Overview / Products / Notes) instead of one long
         scrolling form. Only in-page section switching — not a workflow/mode selector (Manager
         remains deferred per CLAUDE.md; MainWindow.axaml). Plain Button + a view-model-bound "active"
         class, the same pattern MainWindow.axaml's own top-level section strip already uses — not
         ToggleButton: AssociateViewModel.SelectedSection is now the single source of truth (so
         MainViewModel can drive a Dashboard "Open Notes" deep link, spec Part F), and a one-way
         Classes binding to Is*SectionSelected can never drift out of sync the way ToggleButton's own
         click-toggled IsChecked required explicit code-behind mutual exclusion to prevent. Not
         TabControl: it eagerly populates its Items collection during XAML load (requires dispatcher
         access, breaks headless construction tests). -->
    <Style Selector="Button.railItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="18,13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.railItem.active">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.railItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSubtleSurfaceBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Action bar (spec §10.2/Part B/C): identity, date navigation, primary actions, and save/refresh
         status all live together as one coherent toolbar instead of a separate floating date bar or a
         developer-style footer. -->
    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceTintBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <StackPanel Spacing="12">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Associate Passdown" Classes="pageTitle" VerticalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="chip" AutomationProperties.Name="Save status"
                    Background="{Binding AutosaveState, Converter={x:Static converters:SaveStatusBrushConverter.Instance}}">
              <TextBlock Text="{Binding SaveStatusText, FallbackValue='Not saved yet'}" />
            </Border>
          </StackPanel>
        </Grid>

        <!-- Phase 15E: WrapPanel, not a fixed Auto,Auto,Auto,Auto,Auto,* Grid — at the documented
             960×640 minimum window size, the six items (date-nav + three actions) no longer all fit on
             one row; the previous Grid layout let the trailing star column start past the window's
             right edge, making Create PDF a zero-width, unreachable control and clipping Export
             Diagnostics. Wrapping to a second line keeps every action reachable at any supported width. -->
        <WrapPanel Orientation="Horizontal">
          <Button Content="◀" Width="34" Margin="0,0,0,6"
                  Command="{Binding PreviousDayCommand}"
                  AutomationProperties.Name="Previous day"
                  ToolTip.Tip="Previous day" />

          <!-- Calendar-based date picker (Part 1 / spec §10.2): click to see a full calendar
               flyout instead of a spinner-style control, with the selected date always shown in a
               friendly long form ("Saturday, August 22, 2026"). Typing a date and arrow-key
               navigation inside the flyout both work natively; selecting a date here never
               triggers online retrieval (spec §6.3) — it goes through the same SelectedDate
               setter as Previous/Next day. -->
          <CalendarDatePicker SelectedDate="{Binding SelectedDateForPicker}"
                               SelectedDateFormat="Custom"
                               CustomDateFormatString="dddd, MMMM d, yyyy"
                               MinWidth="230"
                               Margin="8,0,0,6"
                               AutomationProperties.Name="Operating date"
                               ToolTip.Tip="Choose the operating date" />

          <Button Content="▶" Width="34"
                  Margin="8,0,0,6"
                  Command="{Binding NextDayCommand}"
                  AutomationProperties.Name="Next day"
                  ToolTip.Tip="Next day" />

          <Button Content="Check Online"
                  Margin="16,0,0,6"
                  Command="{Binding CheckOnlineCommand}"
                  Classes="primaryAction"
                  AutomationProperties.Name="Check this date online"
                  AutomationProperties.HelpText="Checks official Carowinds sources for this date. Does not run automatically." />

          <Button Content="Export Diagnostics"
                  Margin="16,0,0,6"
                  Command="{Binding ExportDiagnosticsCommand}"
                  Classes="secondaryAction"
                  AutomationProperties.Name="Export Diagnostics"
                  AutomationProperties.HelpText="Saves a support diagnostic ZIP with version, source status, and recent log information. Contains no drafts or personal data." />

          <!-- Phase 17C §12/§37: PDF Style selector, placed right next to Create PDF since template
               choice is scoped to PDF generation, not an app-wide setting — switching it affects the
               very next Create PDF/finalization, with no separate Settings screen to navigate to. -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="PDF Style" Classes="muted" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding TemplateOptions}"
                      SelectedItem="{Binding SelectedTemplateOption}"
                      MinWidth="110"
                      AutomationProperties.Name="PDF Style"
                      AutomationProperties.HelpText="Chooses the visual template used by Preview PDF and the next finalized PDF. Never changes passdown data.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="presentation:AssociatePassdownTemplateOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Button Content="Create PDF"
                  Margin="8,0,0,6"
                  Command="{Binding CreatePdfCommand}"
                  Classes="secondaryAction"
                  AutomationProperties.Name="Create PDF"
                  AutomationProperties.HelpText="Builds today's Associate Passdown PDF and lets you choose where to save it." />
        </WrapPanel>

        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsBusy}" />

        <!-- Phase 13D Part Z/AA/AT: persistent regardless of which section (Overview/Products/Notes)
             is active, and regardless of how many times Create PDF is pressed while content stays
             over one page — it only reflects the real, most recently generated page count, never a
             transient/reset-on-click state. -->
        <Border Classes="multiPageWarning" IsVisible="{Binding HasMultiPagePdfWarning}"
                AutomationProperties.Name="{Binding MultiPageWarningText}">
          <TextBlock Text="{Binding MultiPageWarningText}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="{Binding RefreshStatusMessage}"
                   IsVisible="{Binding RefreshStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes="muted" />

        <TextBlock Text="{Binding LoadErrorMessage}"
                   IsVisible="{Binding LoadErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource PassdownErrorBrush}" />

        <!-- Phase 18B REL-004: an edit made here collided with a change from another device. Nothing
             was lost; the associate chooses which version to keep under Personal Sync conflicts. -->
        <TextBlock Text="{Binding SyncConflictMessage}"
                   IsVisible="{Binding SyncConflictMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PassdownErrorBrush}" />
      </StackPanel>
    </Border>

    <!-- Main content: a section rail + dashboard body (Parts 2/3) so the most important information
         (Park Hours, Today at a Glance, Status, Notes summary) sits above the fold on "Overview",
         while Products and full Notes editing live in their own sections instead of forcing one long
         page scroll. -->
    <Grid Grid.Row="1" ColumnDefinitions="152,*">

      <Border Grid.Column="0" Background="{DynamicResource PassdownSurfaceTintBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PassdownDividerBrush}">
        <StackPanel>
          <Button Classes="railItem" Classes.active="{Binding IsOverviewSectionSelected}"
                  Content="Overview" Command="{Binding ShowOverviewSectionCommand}"
                  AutomationProperties.Name="Overview section" />
          <Button Classes="railItem" Classes.active="{Binding IsProductsSectionSelected}"
                  Content="Products" Command="{Binding ShowProductsSectionCommand}"
                  AutomationProperties.Name="Products section" />
          <Button Classes="railItem" Classes.active="{Binding IsNotesSectionSelected}"
                  Content="Notes" Command="{Binding ShowNotesSectionCommand}"
                  AutomationProperties.Name="Notes section" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Padding="20,16,20,20"
                    IsVisible="{Binding IsOverviewSectionSelected}">
          <StackPanel Spacing="10">

            <!-- Phase 17D §4: single compact "Day & Operations" panel — replaces the Phase 17C
                 two-column "Day & Operating Hours" / "Today at a Glance" split with one Grid of
                 aligned label/value rows (spec's approved layout direction). No narrow independent
                 vertical columns for Attendance/Early Ride/Daily Feature — every operational field
                 reads as one row within one shared panel. -->
            <Border Classes="panel heroPanel">
            <StackPanel Spacing="10">
              <TextBlock Text="Day &amp; Operations" Classes="sectionTitle" />

              <Grid ColumnDefinitions="110,*,90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

                <!-- Park Hours row. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Park Hours" Classes="fieldLabel" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{Binding ParkHours.BadgeKind, Converter={StaticResource BadgeBrushConverter}}" />
                  <TextBlock Text="{Binding ParkHours.HeadlineText, FallbackValue='Hours not checked yet'}"
                             Classes="hoursHeadline" TextWrapping="Wrap"
                             Classes.subtle="{Binding ParkHours.IsHoursUnknown}" />
                  <Border Classes="chip" IsVisible="{Binding ParkHours.BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ParkHours.BadgeText}" />
                  </Border>
                </StackPanel>

                <!-- Gates row: North Gate | Avenue. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="North Gate" Classes="fieldLabel" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParkHours.NorthGateText, FallbackValue='—'}" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Avenue" Classes="fieldLabel" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ParkHours.AvenueText, FallbackValue='—'}" FontWeight="Medium" VerticalAlignment="Center" />

                <!-- Waterpark hours / verification / stale note — full width, collapses to zero space when absent. -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ParkHours.HasWaterparkHours}">
                    <TextBlock Text="Carolina Harbor" Classes="muted" />
                    <TextBlock Text="{Binding ParkHours.WaterparkHeadlineText}" FontWeight="Medium"
                               AutomationProperties.Name="{Binding ParkHours.WaterparkHeadlineText, StringFormat='Carolina Harbor hours: {0}'}" />
                  </StackPanel>
                  <TextBlock Text="{Binding ParkHours.VerificationText}"
                             IsVisible="{Binding ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="muted" />
                  <TextBlock Text="{Binding ParkHours.StaleNoteText}"
                             IsVisible="{Binding ParkHours.StaleNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldWarning" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Attendance | Pre-solds row. -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Attendance" Classes="fieldLabel" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="0" Margin="0,0,10,0">
                  <TextBox Text="{Binding ProjectedAttendanceText}" PlaceholderText="Not entered"
                           AutomationProperties.Name="Projected attendance" />
                  <TextBlock Text="{Binding ProjectedAttendanceError}"
                             IsVisible="{Binding ProjectedAttendanceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldError" />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Pre-solds" Classes="fieldLabel" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="3" Spacing="0">
                  <TextBox Text="{Binding PreSoldsText}" PlaceholderText="Not entered"
                           AutomationProperties.Name="Pre-solds" />
                  <TextBlock Text="{Binding PreSoldsError}"
                             IsVisible="{Binding PreSoldsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldError" />
                </StackPanel>

                <!-- Early Ride row (Phase 17D §2: rides only, one compact Edit action — never a
                     routine start-time field, never a permanent pair of large buttons). -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Early Ride" Classes="fieldLabel" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EarlyRideTimeStatusText}"
                           FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding EarlyRideTimeStatusText, StringFormat='Early Ride: {0}'}" />
                <Button Grid.Row="4" Grid.Column="3" Content="Edit" Classes="secondaryAction" HorizontalAlignment="Right"
                        Command="{Binding OpenErtEditorCommand}"
                        AutomationProperties.Name="Edit Early Ride Time" />

                <!-- Daily Feature row. -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Daily Feature" Classes="fieldLabel" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Spacing="6">
                  <ComboBox ItemsSource="{Binding DailyFeatureTypeOptions}"
                            SelectedItem="{Binding SelectedDailyFeatureTypeOption}"
                            HorizontalAlignment="Left" MinWidth="220"
                            AutomationProperties.Name="Daily Feature type">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:DailyFeatureTypeOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding DailyFeatureText}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                           PlaceholderText="Enter the question, fact, or quote"
                           AutomationProperties.Name="Daily Feature text" />
                </StackPanel>
              </Grid>

              <!-- Compact Early Ride Time editor (Phase 17D §3) — one panel with the Monthly Default
                   and Date Override sections together, opened by the single [Edit] action above. No
                   time controls anywhere in this editor. -->
              <Border Classes="inset" IsVisible="{Binding IsErtEditorOpen}">
                <StackPanel Spacing="8">
                  <TextBlock Text="MONTHLY DEFAULT" Classes="subsectionTitle" Margin="0" />
                  <TextBlock Text="{Binding SelectedMonthLabel}" Classes="fieldLabel" />
                  <CheckBox Content="No ERT this month"
                            IsChecked="{Binding MonthlyErtNoErt}"
                            AutomationProperties.Name="No Early Ride Time this month" />
                  <StackPanel Spacing="0" IsVisible="{Binding !MonthlyErtNoErt}">
                    <TextBox Text="{Binding MonthlyErtRidesText}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                             PlaceholderText="Participating rides, one per line"
                             AutomationProperties.Name="Monthly Early Ride Time rides" />
                    <TextBlock Text="One ride per line." Classes="fieldHint" />
                  </StackPanel>
                  <TextBox Text="{Binding MonthlyErtNoteText}"
                           PlaceholderText="Note (optional)"
                           AutomationProperties.Name="Monthly Early Ride Time note" />
                  <TextBlock Text="{Binding MonthlyErtSaveError}"
                             IsVisible="{Binding MonthlyErtSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes="fieldError" TextWrapping="Wrap" />
                  <Button Content="Save Monthly" Classes="primaryAction"
                          Command="{Binding SaveMonthlyErtCommand}"
                          AutomationProperties.Name="Save Monthly Early Ride Time" />

                  <Rectangle Height="1" Fill="{DynamicResource PassdownDividerBrush}" Margin="0,2,0,2" />

                  <TextBlock Text="DATE OVERRIDE" Classes="subsectionTitle" Margin="0" />
                  <CheckBox Content="{Binding UseOverrideForDateLabel}"
                            IsChecked="{Binding ErtUseOverrideForDate}"
                            AutomationProperties.Name="Use an Early Ride Time override for this date" />
                  <StackPanel Spacing="8" IsVisible="{Binding ErtUseOverrideForDate}">
                    <CheckBox Content="No ERT this date"
                              IsChecked="{Binding OverrideNoErt}"
                              AutomationProperties.Name="No Early Ride Time this date" />
                    <StackPanel Spacing="0" IsVisible="{Binding !OverrideNoErt}">
                      <TextBox Text="{Binding OverrideRidesText}"
                               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                               PlaceholderText="Override rides, one per line"
                               AutomationProperties.Name="Early Ride Time override rides" />
                      <TextBlock Text="One ride per line." Classes="fieldHint" />
                    </StackPanel>
                    <TextBox Text="{Binding OverrideReasonText}"
                             PlaceholderText="Reason (optional) — e.g. maintenance"
                             AutomationProperties.Name="Early Ride Time override reason" />
                    <TextBlock Text="{Binding OverrideSaveError}"
                               IsVisible="{Binding OverrideSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Classes="fieldError" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save Override" Classes="primaryAction"
                              Command="{Binding SaveOverrideCommand}"
                              AutomationProperties.Name="Save Early Ride Time override" />
                      <Button Content="Remove Override"
                              IsVisible="{Binding EarlyRideTimeIsOverride}"
                              Command="{Binding RemoveOverrideCommand}"
                              AutomationProperties.Name="Remove Early Ride Time override for this date" />
                    </StackPanel>
                  </StackPanel>

                  <Button Content="Close" HorizontalAlignment="Left"
                          Command="{Binding CancelErtEditorCommand}"
                          AutomationProperties.Name="Close Early Ride Time editor" />
                </StackPanel>
              </Border>

              <!-- Manual hours override + private buyout (Part D/I/J, Phase 13E): one shared,
                   compact override area. Time entry is a typable TextBox (Phase 13E — replaces the
                   stock click-and-spin TimePicker) bound with UpdateSourceTrigger=LostFocus so
                   parsing/normalization commits once per Tab/click-away/Enter, not per keystroke
                   (Part O/P). -->
              <Border Classes="inset">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <CheckBox Content="Manual hours override"
                                IsChecked="{Binding ManualHoursOverrideEnabled}"
                                AutomationProperties.Name="Use a manual hours override" />
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2"
                            IsVisible="{Binding ManualHoursOverrideEnabled}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Open" Classes="fieldLabel" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0">
                          <TextBox Text="{Binding ManualOpeningTimeText, UpdateSourceTrigger=LostFocus}"
                                   PlaceholderText="9:00 AM" MinWidth="110" HorizontalAlignment="Left"
                                   KeyDown="TimeTextBox_OnKeyDown"
                                   AutomationProperties.Name="Manual Hours Open" />
                          <TextBlock Text="{Binding ManualOpeningTimeError}"
                                     IsVisible="{Binding ManualOpeningTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="fieldError" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding ManualOpeningTimeError}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Close" Classes="fieldLabel" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                          <TextBox Text="{Binding ManualClosingTimeText, UpdateSourceTrigger=LostFocus}"
                                   PlaceholderText="10:00 PM" MinWidth="110" HorizontalAlignment="Left"
                                   KeyDown="TimeTextBox_OnKeyDown"
                                   AutomationProperties.Name="Manual Hours Close" />
                          <TextBlock Text="{Binding ManualClosingTimeError}"
                                     IsVisible="{Binding ManualClosingTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="fieldError" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding ManualClosingTimeError}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding ManualHoursWarningText}"
                                 IsVisible="{Binding ManualHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldWarning" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="16,0,0,0">
                      <CheckBox Content="Private buyout / custom hours"
                                IsChecked="{Binding PrivateBuyoutEnabled}"
                                AutomationProperties.Name="Private buyout or custom hours" />
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2"
                            IsVisible="{Binding PrivateBuyoutEnabled}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Open" Classes="fieldLabel" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0">
                          <TextBox Text="{Binding PrivateBuyoutOpeningTimeText, UpdateSourceTrigger=LostFocus}"
                                   PlaceholderText="6:00 PM" MinWidth="110" HorizontalAlignment="Left"
                                   KeyDown="TimeTextBox_OnKeyDown"
                                   AutomationProperties.Name="Private Buyout Open" />
                          <TextBlock Text="{Binding PrivateBuyoutOpeningTimeError}"
                                     IsVisible="{Binding PrivateBuyoutOpeningTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="fieldError" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding PrivateBuyoutOpeningTimeError}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Close" Classes="fieldLabel" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0">
                          <TextBox Text="{Binding PrivateBuyoutClosingTimeText, UpdateSourceTrigger=LostFocus}"
                                   PlaceholderText="11:00 PM" MinWidth="110" HorizontalAlignment="Left"
                                   KeyDown="TimeTextBox_OnKeyDown"
                                   AutomationProperties.Name="Private Buyout Close" />
                          <TextBlock Text="{Binding PrivateBuyoutClosingTimeError}"
                                     IsVisible="{Binding PrivateBuyoutClosingTimeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="fieldError" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding PrivateBuyoutClosingTimeError}" />
                        </StackPanel>
                      </Grid>
                      <TextBox Text="{Binding PrivateBuyoutDetails}"
                               IsVisible="{Binding PrivateBuyoutEnabled}"
                               PlaceholderText="Group name, contact, or other details"
                               AutomationProperties.Name="Private buyout details" />
                      <TextBlock Text="{Binding PrivateBuyoutHoursWarningText}"
                                 IsVisible="{Binding PrivateBuyoutHoursWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Classes="fieldWarning" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
            </Border>

            <!-- Phase 17D §5: a single lightweight status strip — "Draft: Saved | Last checked: ... |
                 Notes: N" — replacing the Phase 17C two-column status card. Warnings/errors are the
                 only thing allowed to expand this into more than one line; normal healthy status stays
                 a single compact line, never a large card. -->
            <Border Classes="panel">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Draft: " Classes="muted" />
                <TextBlock Text="{Binding SaveStatusText, FallbackValue='Not saved yet'}" FontWeight="Medium"
                           AutomationProperties.Name="{Binding SaveStatusText, StringFormat='Draft status: {0}'}" />
                <TextBlock Text="   |   " Classes="muted" />
                <TextBlock Text="{Binding ParkHours.VerificationText, FallbackValue='Not checked yet'}" Classes="muted" />
                <TextBlock Text="   |   " Classes="muted" />
                <TextBlock Text="Notes: " Classes="muted" />
                <TextBlock Text="{Binding OperationalNotesCount}" FontWeight="Medium"
                           AutomationProperties.Name="{Binding OperationalNotesCount, StringFormat='Operational notes: {0}'}" />
              </StackPanel>

              <!-- Expands only when attention is needed (spec §5) — a failed Check Online, or a PDF/
                   diagnostics export message. -->
              <TextBlock Text="{Binding RefreshResultMessage}"
                         IsVisible="{Binding RefreshHadFailures}"
                         Classes="fieldWarning" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PdfExportMessage}"
                         IsVisible="{Binding PdfExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding DiagnosticsExportMessage}"
                         IsVisible="{Binding DiagnosticsExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            </Border>

            <!-- Passdown Builder section selection (Phase 8A; SCarowinds/Haunt added Phase 8B): Day
                 of week, Date, Park Hours, Attendance, Early Ride Time, and Daily Feature above
                 always print and have no checkbox here — only these seven sections can be
                 independently shown/hidden. -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Include in Passdown" Classes="sectionTitle" Margin="0,0,0,4" />
                <TextBlock Text="Day, date, park hours, attendance, Early Ride Time, and the Daily Feature always print. Choose which additional sections appear on the PDF."
                           Classes="muted" TextWrapping="Wrap" />
                <WrapPanel>
                  <CheckBox Content="Daily Admission" IsChecked="{Binding IncludeDailyAdmission}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include Daily Admission in the Passdown" />
                  <CheckBox Content="Fast Lane" IsChecked="{Binding IncludeFastLane}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include Fast Lane in the Passdown" />
                  <CheckBox Content="Promotions" IsChecked="{Binding IncludePromotions}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include Promotions in the Passdown" />
                  <CheckBox Content="Season Passes" IsChecked="{Binding IncludeSeasonPasses}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include Season Passes in the Passdown" />
                  <CheckBox Content="Add-Ons" IsChecked="{Binding IncludeAddOns}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include Add-Ons in the Passdown" />
                  <CheckBox Content="SCarowinds / Haunt" IsChecked="{Binding IncludeHauntedAttractions}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include SCarowinds / Haunt in the Passdown" />
                  <CheckBox Content="Operational Notes" IsChecked="{Binding IncludeOperationalNotes}"
                            Margin="0,0,24,4" AutomationProperties.Name="Include Operational Notes in the Passdown" />
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" Padding="24,20,24,24"
                    IsVisible="{Binding IsProductsSectionSelected}">
          <StackPanel Spacing="16">

            <!-- Products (Part F): editable, data-driven per-category product sections. No product
                 names or category counts are hard-coded — sections and rows come straight from the
                 composed workspace. -->
            <ItemsControl ItemsSource="{Binding ProductSections}"
                          IsVisible="{Binding HasProductSections}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProductCategorySectionViewModel">
                  <Border Classes="panel">
                    <StackPanel Spacing="2">
                      <Border Classes="categoryBand">
                        <TextBlock Text="{Binding CategoryDisplayName}" />
                      </Border>

                      <Border Classes="inset" IsVisible="{Binding HasStatus}" Margin="0,0,0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Status.StatusText}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Status.DetailText}"
                                     IsVisible="{Binding Status.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="muted" />
                        </StackPanel>
                      </Border>

                      <!-- Column headers (Part 4: denser, table-like product presentation). -->
                      <Grid ColumnDefinitions="Auto,*,200" IsVisible="{Binding HasProducts}" Margin="0,2,0,2">
                        <TextBlock Grid.Column="1" Text="ITEM" Classes="columnHeader" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="DISPLAY PRICE" Classes="columnHeader" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Border Classes="productRow">
                              <Grid ColumnDefinitions="Auto,*,200">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IncludeOnPdf}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,10,0"
                                          AutomationProperties.Name="{Binding DisplayName, StringFormat='Include {0} on the PDF'}" />

                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding OfficialPriceText, StringFormat='Official {0}'}" Classes="muted" />
                                    <TextBlock Text="{Binding ComparisonPriceText, StringFormat='Compare at {0}'}"
                                               IsVisible="{Binding ComparisonPriceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource PassdownComparePriceBrush}" FontSize="12.5" />
                                  </StackPanel>
                                  <TextBlock Text="{Binding PriceQualifier}"
                                             IsVisible="{Binding HasPriceQualifier}"
                                             Classes="muted" FontStyle="Italic" />
                                  <TextBlock Text="{Binding BundleNoteText}"
                                             IsVisible="{Binding HasBundleNote}"
                                             Classes="muted" FontStyle="Italic" />
                                  <TextBlock Text="{Binding VerificationNoteText}"
                                             IsVisible="{Binding VerificationNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Classes="fieldWarning" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2">
                                  <TextBox Text="{Binding DisplayPriceOverrideText}"
                                           PlaceholderText="{Binding OverridePlaceholderText}"
                                           AutomationProperties.Name="{Binding DisplayName, StringFormat='Display price override for {0}'}" />
                                  <TextBlock Text="{Binding DisplayPriceOverrideError}"
                                             IsVisible="{Binding DisplayPriceOverrideError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             Classes="fieldError" />
                                  <Button Content="Use official price"
                                          Command="{Binding ResetToOfficialCommand}"
                                          IsVisible="{Binding HasOverride}"
                                          Margin="0,2,0,0"
                                          AutomationProperties.Name="{Binding DisplayName, StringFormat='Use official price for {0}'}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom / internal products (Part F): draft-local only, never backed by an official id;
                 visually distinct from source-verified official products via the "Custom" tag on each row
                 and a neutral (non-brand-blue) accent, since these are internal entries, not verified
                 catalog items. -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Custom &amp; Internal Items" Classes="sectionTitle" Margin="0" />
                  <Button Grid.Column="1"
                          Content="Add custom item"
                          Classes="secondaryAction"
                          Command="{Binding AddCustomProductCommand}"
                          AutomationProperties.Name="Add a custom or internal product" />
                </Grid>

                <TextBlock Text="Add group rates, buyouts, or other items not sold through the normal ticket site."
                           Classes="muted"
                           IsVisible="{Binding !HasCustomProducts}" />

                <ItemsControl ItemsSource="{Binding CustomProducts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomProductRowViewModel">
                      <Border Classes="inset" Margin="0">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IncludeOnPdf}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Include {0} on the PDF'}" />
                            <Border Grid.Column="1" Classes="chip" Margin="0,0,10,0" VerticalAlignment="Center">
                              <TextBlock Text="Custom" />
                            </Border>
                            <TextBox Grid.Column="2"
                                     Text="{Binding DisplayNameText}"
                                     PlaceholderText="Item name"
                                     AutomationProperties.Name="Custom item name" />
                            <Button Grid.Column="3"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="{Binding DisplayNameText, StringFormat='Remove {0}'}" />
                          </Grid>
                          <Grid ColumnDefinitions="200,*">
                            <StackPanel Grid.Column="0" Spacing="0">
                              <TextBlock Text="Price" Classes="fieldLabel" />
                              <TextBox Text="{Binding PriceText}"
                                       PlaceholderText="Optional"
                                       AutomationProperties.Name="Custom item price" />
                              <TextBlock Text="{Binding PriceError}"
                                         IsVisible="{Binding PriceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         Classes="fieldError" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="0" Margin="16,0,0,0">
                              <TextBlock Text="Notes" Classes="fieldLabel" />
                              <TextBox Text="{Binding NotesText}"
                                       PlaceholderText="Optional"
                                       AutomationProperties.Name="Custom item notes" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" Padding="24,20,24,24"
                    IsVisible="{Binding IsNotesSectionSelected}">
        <StackPanel Spacing="16">

          <!-- Daily Passdown Notes (Part E): full width, comfortable multiline entry — the actual
               editing surface for the Overview section's read-only summary card. Deliberately
               independent of the persistent-note sections below (Part AA) — selecting/deselecting a
               persistent note never reads or writes this text. -->
          <Border Classes="panel">
            <StackPanel Spacing="8">
              <TextBlock Text="Daily Passdown Notes" Classes="sectionTitle" Margin="0" />
              <TextBox Text="{Binding OperationalNotesText}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="200"
                       Background="{DynamicResource PassdownSubtleSurfaceBrush}"
                       PlaceholderText="Important operational notes, one line per note"
                       AutomationProperties.Name="Operational notes" />
            </StackPanel>
          </Border>

          <!-- Included Persistent Notes (Phase 11D Part T/V): frozen copies the supervisor has
               explicitly selected for this date — structurally distinct from the manual notes above,
               never merged into that text box. -->
          <Border Classes="panel">
            <StackPanel Spacing="8">
              <TextBlock Text="Included Persistent Notes" Classes="sectionTitle" Margin="0"
                         AutomationProperties.Name="Included persistent operational notes" />

              <!-- Phase 11E Part H: plain-language explanation that inclusion freezes a copy — shown
                   once for the section, not per row, since it is true for every included note. -->
              <TextBlock Text="Included notes keep the version selected for this passdown."
                         Classes="fieldHint" Margin="0"
                         IsVisible="{Binding HasSelectedOperationalNotes}" />

              <TextBlock Text="No persistent operational notes included."
                         Classes="muted"
                         IsVisible="{Binding !HasSelectedOperationalNotes}" />

              <ItemsControl ItemsSource="{Binding SelectedOperationalNotes}"
                            IsVisible="{Binding HasSelectedOperationalNotes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssociateSelectedOperationalNoteRowViewModel">
                    <Border Classes="inset" Margin="0" AutomationProperties.Name="{Binding AccessibleSummary}">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,0,10,0">
                            <Border Classes="chip" IsVisible="{Binding IsImportant}">
                              <TextBlock Text="Important" Classes="priorityText important" />
                            </Border>
                            <Border Classes="chip">
                              <TextBlock Text="{Binding CategoryLabel}" />
                            </Border>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Body}"
                                       IsVisible="{Binding HasBody}"
                                       Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DateRangeText}" Classes="fieldHint" Margin="0" />
                          </StackPanel>

                          <!-- Remove means "remove from this passdown", never "delete/resolve the source note" (spec Part S) — the automation name spells this out explicitly. -->
                          <Button Grid.Column="2"
                                  Content="Remove"
                                  Command="{Binding RemoveCommand}"
                                  VerticalAlignment="Top"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Remove {0} from this passdown'}" />
                        </Grid>

                        <!-- Source-changed awareness (Phase 11E Parts G-L): informational only — never
                             touches the frozen Title/Body/etc. above unless the supervisor explicitly
                             clicks Replace. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSourceStatus}">
                          <TextBlock Grid.Column="0" Text="{Binding SourceStatusText}" Classes="fieldHint" Margin="0"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="Replace with Current Version"
                                  Classes="secondaryAction"
                                  Command="{Binding ReplaceCommand}"
                                  IsVisible="{Binding ShowReplaceAction}"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Replace {0} with current version'}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Available persistent-note suggestions (Phase 11D Part E/U): relevant for the
               Associate-selected date, minus whatever is already included above. Selecting is
               explicit (Add) — nothing here is ever auto-included. -->
          <Border Classes="panel">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding AvailableOperationalNoteSuggestionsHeading}" Classes="sectionTitle" Margin="0"
                         AutomationProperties.Name="Available persistent operational notes" />

              <TextBlock Text="No persistent operational notes are available for this date."
                         Classes="muted"
                         IsVisible="{Binding !HasAvailableOperationalNoteSuggestions}" />

              <ItemsControl ItemsSource="{Binding AvailableOperationalNoteSuggestions}"
                            IsVisible="{Binding HasAvailableOperationalNoteSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssociateOperationalNoteSuggestionRowViewModel">
                    <Border Classes="inset" Margin="0" AutomationProperties.Name="{Binding AccessibleSummary}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,0,10,0">
                          <Border Classes="chip" IsVisible="{Binding IsImportant}">
                            <TextBlock Text="Important" Classes="priorityText important" />
                          </Border>
                          <Border Classes="chip">
                            <TextBlock Text="{Binding CategoryLabel}" />
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DateRangeText}" Classes="fieldHint" Margin="0" />
                          <TextBlock Text="{Binding CarryForwardText}" Classes="fieldHint" Margin="0"
                                     IsVisible="{Binding HasCarryForwardText}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Add"
                                Classes="secondaryAction"
                                Command="{Binding AddCommand}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Title, StringFormat='Add note {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>

  </Grid>
</UserControl>
