<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:spell="using:Carowinds.Passdown.Desktop.Spelling"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.OperationalNotesView"
             x:DataType="vm:OperationalNotesViewModel">

  <!-- Phase 11B: the persistent Operational Notes Manager — a supervisor-facing browse/create/edit/
       resolve screen for notes that may span multiple days (spec Phase 11A), distinct from Associate
       Passdown's own daily Notes entry. Nothing here writes into an Associate draft, the Dashboard, or
       finalized History (spec Parts Y/AA/AB) — this screen only calls IOperationalNotesService.

       Phase 35F (approved prototype carowinds_operational_notes_refined_prototype.html): page header with
       the one primary New Note action; a quiet filter bar (search, lifecycle segments, Category, Priority,
       Clear filters); a list card and a detail card; the create/edit form as an in-page dialog over a scrim.
       Same view model, commands, validation and persistence as before — only the presentation changed.
       Shared styles come from Themes/PassdownStyles.axaml; only this screen's deltas live below. -->
  <UserControl.Styles>
    <!-- Divided rows: a hairline under each row, the left 3px reserved for the Important rule. -->
    <Style Selector="ListBox.notesList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
    </Style>
    <!-- Important (a supervisor's explicit priority, never inferred from text): a thin accent rule at the
         row's left edge plus the word "Important" in the metadata line — never a warning box, never color alone. -->
    <Style Selector="Border.importanceRule">
      <Setter Property="Width" Value="3" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.importanceRule.important">
      <Setter Property="Background" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rowExcerpt">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.rowMeta">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeTableHeader}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metaValue">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.noteBody">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.formField > TextBlock.fieldLabel">
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
  </UserControl.Styles>

  <Grid>

    <!-- The page. Disabled while the editor dialog is open, so the list, filters and actions underneath can be
         neither clicked nor tabbed to; the sidebar's existing Notes-editing guard covers navigation. -->
    <Grid x:Name="NotesPage" RowDefinitions="Auto,Auto,*" IsEnabled="{Binding !IsEditing}">

      <!-- Header (spec Part D) -->
      <Border Grid.Row="0" Classes="pageHeader">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Operational Notes" Classes="pageTitle" />
            <TextBlock Text="Persistent supervisor notes for current and upcoming operations. Never added to a daily Passdown automatically."
                       Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="NewNoteButton" Grid.Column="1" Classes="primaryAction" Content="+ New Note"
                  Command="{Binding NewNoteCommand}"
                  VerticalAlignment="Center" Margin="16,0,0,0"
                  AutomationProperties.Name="New Note"
                  AutomationProperties.HelpText="Creates a new persistent operational note." />
        </Grid>
      </Border>

      <!-- Search, lifecycle segments, Category / Priority filters (spec Part G/J, Phase 11E Part A/B/V, Phase 35F search). -->
      <Border Grid.Row="1" Classes="filterBar">
        <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8">
          <TextBox x:Name="NotesSearchBox" Classes="searchBox" Width="300" Text="{Binding SearchText}"
                   PlaceholderText="Search notes" VerticalAlignment="Center"
                   AutomationProperties.Name="Search operational notes"
                   AutomationProperties.HelpText="Shows only notes whose title, text or category contains every word you type.">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource PassdownSearchIconGeometry}" />
            </TextBox.InnerLeftContent>
          </TextBox>

          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                      AutomationProperties.Name="Note status filters">
            <Button Classes="segment" Classes.active="{Binding IsActiveFilterSelected}"
                    Content="Active" Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:OperationalNoteLifecycleFilter.Active}"
                    AutomationProperties.Name="Active notes filter" />
            <Button Classes="segment" Classes.active="{Binding IsAllFilterSelected}"
                    Content="All" Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:OperationalNoteLifecycleFilter.All}"
                    AutomationProperties.Name="All notes filter" />
            <Button Classes="segment" Classes.active="{Binding IsUpcomingFilterSelected}"
                    Content="Upcoming" Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:OperationalNoteLifecycleFilter.Upcoming}"
                    AutomationProperties.Name="Upcoming notes filter" />
            <Button Classes="segment" Classes.active="{Binding IsExpiredFilterSelected}"
                    Content="Expired" Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:OperationalNoteLifecycleFilter.Expired}"
                    AutomationProperties.Name="Expired notes filter" />
            <Button Classes="segment" Classes.active="{Binding IsResolvedFilterSelected}"
                    Content="Resolved" Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static vm:OperationalNoteLifecycleFilter.Resolved}"
                    AutomationProperties.Name="Resolved notes filter" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Category" Classes="muted" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding CategoryFilter}"
                        MinWidth="140" AutomationProperties.Name="Category filter">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="presentation:OperationalNoteCategoryFilterOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Priority" Classes="muted" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding PriorityFilterOptions}" SelectedItem="{Binding PriorityFilter}"
                        MinWidth="110" AutomationProperties.Name="Priority filter">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="presentation:OperationalNotePriorityFilterOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Button Classes="textAction" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                    VerticalAlignment="Center" IsVisible="{Binding HasActiveSecondaryFilters}"
                    AutomationProperties.Name="Clear filters" />
          </StackPanel>
        </WrapPanel>
      </Border>

      <!-- List card + detail card (spec Part D). The list keeps a fixed width; the detail takes the rest. -->
      <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="16" Margin="22,18,22,18">

        <!-- List (spec Part E/F) -->
        <Border Grid.Column="0" Classes="workspaceCard">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Classes="listHeader">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ListHeadingText}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding NoteCountText}" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
              </Grid>
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" AutomationProperties.Name="Loading operational notes" />

            <TextBlock Grid.Row="2" Text="{Binding ListErrorMessage}" Classes="fieldError"
                       Margin="16" TextWrapping="Wrap" VerticalAlignment="Top"
                       IsVisible="{Binding ListErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Spec Part U: no notes at all. -->
            <StackPanel Grid.Row="2" Margin="16" Spacing="10" IsVisible="{Binding ShowEmptyState}">
              <TextBlock Text="No operational notes yet." FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Create a note for information that should remain visible across days." />
              <Button Classes="secondaryAction" Content="+ New Note" Command="{Binding NewNoteCommand}"
                      HorizontalAlignment="Left" AutomationProperties.Name="New Note (empty state)" />
            </StackPanel>

            <!-- Spec Part U: notes exist, but none match the current filter or search. -->
            <TextBlock Grid.Row="2" Margin="16" Text="{Binding FilteredEmptyStateMessage}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding ShowFilteredEmptyState}" AutomationProperties.LiveSetting="Polite" />

            <ListBox Grid.Row="2" Classes="selectableRows notesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                     Background="Transparent" BorderThickness="0"
                     IsVisible="{Binding !ShowEmptyState}"
                     IsEnabled="{Binding !IsEditing}"
                     AutomationProperties.Name="Operational notes list">
              <ListBox.ItemTemplate>
                <!-- Phase 35F: title with its lifecycle pill; a short preview of the note's text; category · priority
                     with the schedule (range and any relative phrase). Every fact the Phase 22E row showed is still here. -->
                <DataTemplate x:DataType="presentation:OperationalNoteRowPresentation">
                  <Grid ColumnDefinitions="Auto,*" AutomationProperties.Name="{Binding AccessibleSummary}">
                    <Border Grid.Column="0" Classes="importanceRule" Classes.important="{Binding IsImportant}" />
                    <StackPanel Grid.Column="1" Spacing="5" Margin="12,11,14,11">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="rowTitle" />
                        <Border Grid.Column="1" Classes="statePill" Classes.resolved="{Binding IsResolvedLifecycle}">
                          <TextBlock Text="{Binding LifecycleLabel}" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding ExcerptText}" Classes="rowExcerpt" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                          <TextBlock Classes="rowMeta" Text="{Binding CategoryLabel}" />
                          <TextBlock Classes="rowMeta" Text="·" />
                          <TextBlock Classes="rowMeta priorityText" Classes.important="{Binding IsImportant}" Text="{Binding PriorityLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ScheduleDetailText}" Classes="rowMeta" TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- Detail -->
        <Border Grid.Column="1" Classes="workspaceCard">
          <Grid>

            <!-- Placeholder (spec Part D): nothing selected. -->
            <TextBlock Text="Select a note from the list, or create a new one." Classes="muted"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" TextWrapping="Wrap"
                       IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNull}}" />

            <!-- Read-only detail (spec Part K's default; Part O for a resolved note). -->
            <ScrollViewer x:Name="NoteDetailScroll" IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="18" Margin="30,26,30,34" MaxWidth="920" HorizontalAlignment="Left">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="7">
                    <TextBlock Text="OPERATIONAL NOTE" Classes="eyebrow" />
                    <TextBlock Text="{Binding SelectedDetail.Title}" Classes="detailTitle" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                      <Border Classes="chip">
                        <TextBlock Text="{Binding SelectedDetail.CategoryLabel}" />
                      </Border>
                      <Border Classes="chipAccent" IsVisible="{Binding SelectedDetail.IsImportant}">
                        <TextBlock Text="Important" />
                      </Border>
                      <Border Classes="chip" IsVisible="{Binding !SelectedDetail.IsImportant}">
                        <TextBlock Text="{Binding SelectedDetail.PriorityLabel, StringFormat='{}{0} priority'}" />
                      </Border>
                      <Border Classes="chip">
                        <TextBlock Text="{Binding SelectedDetail.LifecycleLabel}" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <!-- Action row: Edit / Resolve. Neither control appears for a resolved note (spec Part O). -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top"
                              IsVisible="{Binding !SelectedDetail.IsResolved, FallbackValue=False}">
                    <Button x:Name="EditNoteButton" Content="Edit" Classes="secondaryAction" Command="{Binding EditCommand}"
                            AutomationProperties.Name="Edit" />
                    <Button Content="Resolve" Classes="secondaryAction" Command="{Binding RequestResolveCommand}"
                            AutomationProperties.Name="Resolve"
                            AutomationProperties.HelpText="Marks this note resolved after you confirm. The note is kept, never deleted." />
                  </StackPanel>
                </Grid>

                <!-- Spec Part N: the inline resolve confirmation. -->
                <Border Classes="noticeBox" IsVisible="{Binding IsConfirmingResolve}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Mark this operational note resolved? This preserves the note but removes it from the Active list."
                               FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Yes, Resolve" Classes="warningAction" Command="{Binding ConfirmResolveCommand}"
                              IsEnabled="{Binding !IsResolving}"
                              AutomationProperties.Name="Confirm Resolve" />
                      <Button Content="Cancel" Classes="secondaryAction" Command="{Binding CancelResolveCommand}"
                              AutomationProperties.Name="Cancel Resolve" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding ActionMessage}" Classes="fieldError" TextWrapping="Wrap"
                           IsVisible="{Binding ActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.LiveSetting="Assertive" />

                <Border Classes="divider" Margin="0" />

                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <TextBlock Text="EFFECTIVE FROM" Classes="eyebrow" />
                      <TextBlock Text="{Binding SelectedDetail.EffectiveFromText}" Classes="metaValue" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="EFFECTIVE THROUGH" Classes="eyebrow" />
                      <TextBlock Text="{Binding SelectedDetail.EffectiveThroughText}" Classes="metaValue" />
                    </StackPanel>
                  </Grid>
                  <!-- Spec Part O: a resolved note shows Resolved + its timestamp, and is otherwise read-only for good. -->
                  <StackPanel Spacing="6" IsVisible="{Binding SelectedDetail.IsResolved, FallbackValue=False}">
                    <TextBlock Text="RESOLVED" Classes="eyebrow" />
                    <TextBlock Text="{Binding SelectedDetail.ResolvedAtText}" Classes="metaValue" />
                  </StackPanel>
                  <!-- Carry-forward relevance (Phase 11E Part E/F) — derived only, never a separate record. -->
                  <TextBlock Text="{Binding SelectedDetail.CarryForwardText}" Classes="muted"
                             IsVisible="{Binding SelectedDetail.CarryForwardText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Border Classes="divider" Margin="0" />

                <StackPanel Spacing="10">
                  <TextBlock Text="Note details" Classes="sectionTitle" Margin="0" />
                  <TextBlock Text="{Binding SelectedDetail.Body}" Classes="noteBody"
                             IsVisible="{Binding SelectedDetail.Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="No additional detail entered." Classes="muted"
                             IsVisible="{Binding SelectedDetail.Body, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                </StackPanel>

                <Border Classes="noticeBox">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Persistent operational note" FontWeight="SemiBold" />
                    <TextBlock Text="Notes are never printed in the daily Associate Passdown automatically. A note can be included for a date from the Passdown Notes tab. Resolving a note does not change finalized Passdown records." />
                  </StackPanel>
                </Border>

                <!-- Phase 22E: stored created/updated times (display only; the stored values never change). -->
                <TextBlock Text="{Binding SelectedDetail.RecordTimesText}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedDetail.RecordTimesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Create/edit editor (spec Part J/K/L/M) as an in-page dialog. Escape and × cancel (the editor's values are
         discarded, nothing is saved); Save Note saves through the same command and validation as before. -->
    <Border x:Name="NoteEditorOverlay" Classes="modalScrim" IsVisible="{Binding ShowEditor}">
      <Border x:Name="NoteEditorDialog" Classes="modalDialog" MaxWidth="610" MaxHeight="760" Margin="20"
              VerticalAlignment="Center"
              AutomationProperties.Name="Operational note editor">
        <Border.KeyBindings>
          <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        </Border.KeyBindings>
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}" Padding="22,14,14,14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="New Operational Note" Classes="sectionTitle" FontSize="17" Margin="0"
                         VerticalAlignment="Center" IsVisible="{Binding IsCreating}" />
              <TextBlock Grid.Column="0" Text="Edit Operational Note" Classes="sectionTitle" FontSize="17" Margin="0"
                         VerticalAlignment="Center" IsVisible="{Binding !IsCreating}" />
              <Button Grid.Column="1" Classes="iconAction" Content="×" FontSize="16" Command="{Binding CancelCommand}"
                      ToolTip.Tip="Close without saving"
                      AutomationProperties.Name="Close editor without saving" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14" Margin="22,18,22,18">

              <StackPanel Classes="formField">
                <TextBlock Text="Title" Classes="fieldLabel" />
                <TextBox x:Name="EditorTitleBox" spell:SpellCheck.IsEnabled="True"
                         Text="{Binding EditorTitle}" MaxLength="200"
                         PlaceholderText="e.g. South Gate scanner #3 out of service"
                         AutomationProperties.Name="Note title" />
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Classes="formField">
                  <TextBlock Text="Category" Classes="fieldLabel" />
                  <ComboBox ItemsSource="{Binding EditorCategoryOptions}" SelectedItem="{Binding EditorCategory}"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="Category">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:OperationalNoteCategoryOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="formField">
                  <TextBlock Text="Priority" Classes="fieldLabel" />
                  <ComboBox ItemsSource="{Binding EditorPriorityOptions}" SelectedItem="{Binding EditorPriority}"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="Priority">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="presentation:OperationalNotePriorityOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Classes="formField">
                  <TextBlock Text="Effective from" Classes="fieldLabel" />
                  <CalendarDatePicker SelectedDate="{Binding EditorEffectiveFromForPicker}"
                                      SelectedDateFormat="Custom" CustomDateFormatString="MMM d, yyyy"
                                      PlaceholderText="Choose a date"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Effective From" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="formField">
                  <TextBlock Text="Effective through" Classes="fieldLabel" />
                  <CalendarDatePicker SelectedDate="{Binding EditorEffectiveThroughForPicker}"
                                      SelectedDateFormat="Custom" CustomDateFormatString="MMM d, yyyy"
                                      PlaceholderText="{Binding EditorEffectiveThroughPlaceholder}"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !EditorUntilResolved}"
                                      AutomationProperties.Name="Effective Through" />
                  <CheckBox Content="Until resolved" IsChecked="{Binding EditorUntilResolved}" Margin="0,4,0,0"
                            AutomationProperties.Name="Effective Through is until resolved" />
                </StackPanel>
              </Grid>

              <StackPanel Classes="formField">
                <TextBlock Text="Details (optional)" Classes="fieldLabel" />
                <TextBox spell:SpellCheck.IsEnabled="True"
                         Text="{Binding EditorBody}" MaxLength="4000"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="126"
                         PlaceholderText="Record the observation, context, or follow-up information"
                         AutomationProperties.Name="Note body" />
              </StackPanel>

              <TextBlock Text="{Binding EditorValidationMessage}" Classes="fieldError" TextWrapping="Wrap"
                         IsVisible="{Binding EditorValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PassdownDividerBrush}" Padding="22,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Classes="secondaryAction" Command="{Binding CancelCommand}"
                      AutomationProperties.Name="Cancel" />
              <Button Content="Save Note" Classes="primaryAction" Command="{Binding SaveCommand}"
                      AutomationProperties.Name="Save" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Border>
  </Grid>

</UserControl>
