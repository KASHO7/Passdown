<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             x:Class="Carowinds.Passdown.Desktop.Views.MorningMessageView"
             x:DataType="vm:MorningMessageViewModel">

  <!-- Escape closes only while focus is inside this screen (not a window-wide hot key). -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <!-- Phase 29: the Teams Morning Message composer. Left: message-only inputs and section order; right:
       the message exactly as it will be pasted. Theme colors come only from the Phase 22A tokens, so
       light and dark both work; nothing is hover-only and every control has a screen-reader name. -->
  <Border MaxWidth="1180" MaxHeight="780" Margin="24" Padding="20" CornerRadius="8" BorderThickness="1"
          BorderBrush="{DynamicResource PassdownDividerBrush}"
          Background="{DynamicResource PassdownPopupSurfaceBrush}"
          HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,*,Auto">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Morning Message" Classes="sectionTitle" FontSize="18" Margin="0" />
          <TextBlock Text="{Binding DateText}" Classes="muted" />
          <TextBlock Text="Text typed here is for this message only — it is not saved to the Passdown, PDF or History. Hours, attendance, prices and the Daily Feature come from the Associate screen; edit them there."
                     Classes="fieldHint" TextWrapping="Wrap" />
          <!-- Phase 30: Sync Morning Messages — changes from another computer wait until this window closes. -->
          <TextBlock x:Name="SyncNoticeText" Text="{Binding SyncNotice}" Classes="fieldWarning" Margin="0,4,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding SyncNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button Grid.Column="1" Content="Close" Classes="secondaryAction" VerticalAlignment="Top"
                Command="{Binding CloseCommand}"
                AutomationProperties.Name="Close morning message" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,16,*">

        <!-- Inputs -->
        <ScrollViewer Grid.Column="0">
          <StackPanel Spacing="14" Margin="0,0,8,0">

            <StackPanel Spacing="4">
              <TextBlock Text="Greeting" Classes="fieldLabel" />
              <TextBox x:Name="GreetingBox" Text="{Binding Greeting}" AcceptsReturn="True" TextWrapping="Wrap"
                       PlaceholderText="Good Morning!"
                       AutomationProperties.Name="Greeting"
                       AutomationProperties.HelpText="Your greeting is remembered for every day, and follows you to your other computers when Sync Morning Messages is on." />
            </StackPanel>

            <!-- Section order: Move Up / Move Down buttons (no drag-and-drop) and an include switch per section. -->
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Sections and order" Classes="fieldLabel" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Reset order" Classes="textAction"
                        Command="{Binding ResetLayoutCommand}"
                        AutomationProperties.Name="Reset section order"
                        AutomationProperties.HelpText="Restores the default order with every section included." />
              </Grid>
              <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}"
                            AutomationProperties.Name="Morning message sections">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MorningMessageSectionRowViewModel">
                    <Border Classes="productRow" AutomationProperties.Name="{Binding AutomationName}">
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Position}" Classes="muted" MinWidth="20" VerticalAlignment="Center" />
                          <CheckBox Grid.Column="1" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"
                                    AutomationProperties.Name="{Binding IncludeAutomationName}" />
                          <Button Grid.Column="2" Content="Move Up" Classes="textAction"
                                  Command="{Binding MoveUpCommand}"
                                  AutomationProperties.Name="{Binding MoveUpAutomationName}" />
                          <Button Grid.Column="3" Content="Move Down" Classes="textAction" Margin="12,0,0,0"
                                  Command="{Binding MoveDownCommand}"
                                  AutomationProperties.Name="{Binding MoveDownAutomationName}" />
                        </Grid>
                        <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding HasEmptyText}"
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="20,0,0,0" />
                        <ItemsControl ItemsSource="{Binding Notices}" IsVisible="{Binding HasNotices}" Margin="20,0,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" Classes="fieldWarning" Margin="0" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="DAP / Placement" Classes="fieldLabel" />
              <TextBox Text="{Binding DapPlacement}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                       AutomationProperties.Name="DAP and placement text" />
              <CheckBox Content="Remind me to attach the DAP image in Teams" IsChecked="{Binding DapImageReminder}"
                        AutomationProperties.Name="Remind me to attach the DAP image in Teams" />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Choose image…" Classes="textAction" IsVisible="{Binding CanPickImage}"
                        Command="{Binding ChooseDapImageCommand}"
                        AutomationProperties.Name="Choose a local DAP image file" />
                <Button Content="Copy Image" Classes="textAction"
                        Command="{Binding CopyDapImageCommand}"
                        AutomationProperties.Name="Copy the DAP image to the clipboard"
                        AutomationProperties.HelpText="Copies only the picture. Paste it into Teams separately from the message." />
                <Button Content="Remove image" Classes="textAction"
                        Command="{Binding ClearDapImageCommand}"
                        AutomationProperties.Name="Forget the chosen DAP image" />
              </WrapPanel>
              <TextBlock Text="{Binding DapImageName, StringFormat='Image: {0}'}" IsVisible="{Binding HasDapImage}"
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Reminders" Classes="fieldLabel" />
              <TextBox Text="{Binding Reminders}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                       AutomationProperties.Name="Reminders"
                       AutomationProperties.HelpText="One reminder per line. Start a line with a dash for a bullet; a blank line starts a new paragraph." />
              <CheckBox Content="Show every line as a bullet" IsChecked="{Binding RemindersAsBullets}"
                        AutomationProperties.Name="Show every reminder line as a bullet" />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Reuse last reminders" Classes="textAction"
                        Command="{Binding ReuseLastRemindersCommand}"
                        AutomationProperties.Name="Reuse the most recent earlier reminders" />
              </WrapPanel>
              <!-- Notes are never copied automatically — the user picks one and adds it on purpose. -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasNoteOptions}">
                <ComboBox Grid.Column="0" ItemsSource="{Binding NoteOptions}" SelectedItem="{Binding SelectedNoteOption}"
                          HorizontalAlignment="Stretch" PlaceholderText="Pick a passdown note…"
                          AutomationProperties.Name="Passdown note to add to reminders" />
                <Button Grid.Column="1" Content="Add to Reminders" Classes="textAction"
                        Command="{Binding AddNoteToRemindersCommand}"
                        AutomationProperties.Name="Add the selected note to reminders" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Ticket Prices" Classes="fieldLabel" />
              <TextBlock Text="Official prices only, following this date's product choices on the Products tab."
                         Classes="fieldHint" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding PriceSections}" AutomationProperties.Name="Price sections">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MorningMessagePriceSectionOption">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                              AutomationProperties.Name="{Binding AutomationName}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBox Text="{Binding PriceNote}" AcceptsReturn="True" TextWrapping="Wrap"
                       PlaceholderText="Your note (shown in italics, not an official price)"
                       AutomationProperties.Name="Your note under ticket prices" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Tentative Break Plan" Classes="fieldLabel" />
              <TextBox Text="{Binding BreakPlan}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" MinHeight="96"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                       AutomationProperties.Name="Tentative break plan"
                       AutomationProperties.HelpText="Names, times and coverage. Your spacing and order are kept." />
            </StackPanel>

            <!-- OD Notes are always a separate message, never part of Copy Morning Message. -->
            <Border Classes="inset" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="OD Notes (separate message)" Classes="fieldLabel" />
                <TextBlock Text="Post the morning message first, then copy these into a new Teams message."
                           Classes="fieldHint" TextWrapping="Wrap" />
                <TextBox Text="{Binding OdNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                         AutomationProperties.Name="OD Notes" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Copy OD Notes (Formatted)" Classes="secondaryAction" Margin="0,0,8,0"
                          Command="{Binding CopyOdNotesFormattedCommand}"
                          AutomationProperties.Name="Copy OD Notes formatted" />
                  <Button Content="Copy OD Notes (Plain Text)" Classes="secondaryAction"
                          Command="{Binding CopyOdNotesPlainTextCommand}"
                          AutomationProperties.Name="Copy OD Notes as plain text" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Preview: the exact plain text; the formatted copy has the same words with bold headings and labels. -->
        <DockPanel Grid.Column="2">
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
            <TextBlock Text="Preview" Classes="fieldLabel" />
            <TextBlock Text="{Binding OrderSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding OrderSummary, StringFormat='Section order: {0}'}" />
          </StackPanel>
          <Border Classes="inset" Padding="12">
            <ScrollViewer>
              <SelectableTextBlock x:Name="PreviewBlock" Text="{Binding PreviewText}" TextWrapping="Wrap"
                                   AutomationProperties.Name="Morning message preview" />
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="6" Margin="0,12,0,0">
        <WrapPanel Orientation="Horizontal">
          <Button Content="Copy Formatted" Margin="0,0,8,0"
                  Classes.primaryAction="{Binding UseFormattedByDefault}"
                  Classes.secondaryAction="{Binding IsPlainTextDefault}"
                  Command="{Binding CopyFormattedCommand}"
                  AutomationProperties.Name="Copy morning message formatted"
                  AutomationProperties.HelpText="Copies bold headings and bullets for Teams, with the same plain text alongside." />
          <Button Content="Copy Plain Text" Margin="0,0,16,0"
                  Classes.primaryAction="{Binding IsPlainTextDefault}"
                  Classes.secondaryAction="{Binding UseFormattedByDefault}"
                  Command="{Binding CopyPlainTextCommand}"
                  AutomationProperties.Name="Copy morning message as plain text" />
          <CheckBox Content="Use formatted copy by default" IsChecked="{Binding UseFormattedByDefault}" VerticalAlignment="Center"
                    AutomationProperties.Name="Use formatted copy by default"
                    AutomationProperties.HelpText="Also applies to the Copy menu's Operations Summary, Today's Pricing and OD Notes." />
        </WrapPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes.muted="{Binding !StatusIsError}"
                   Classes.statusError="{Binding StatusIsError}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding AfterCopyReminder}"
                   IsVisible="{Binding AfterCopyReminder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes="fieldWarning" Margin="0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{x:Static vm:MorningMessageViewModel.MentionHint}" Classes="fieldHint" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
