<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.OperationsCalendarView"
             x:DataType="vm:OperationsCalendarViewModel">

  <!-- Phase 12A: the Operations Calendar foundation — a summary/routing surface ("what dates should I
       pay attention to, and where do I go next?"), not a second Associate/Notes/History editor.
       Shared typography, surface, button and status styles
       come from Themes/PassdownStyles.axaml (Phase 22A); only this screen's own deltas live below. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.fieldWarning">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.primaryAction, Button.secondaryAction">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.weekdayHeader">
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- One day cell (spec Part E/I; Phase 12B Part M/V; Phase 13D Part A/B geometry hardening): plain
         Button so it is keyboard-reachable with FluentTheme's default focus ring; today/selected/
         out-of-month are each a distinct border/background treatment (never the only signal — every
         one of them, plus operating state/hours, also has a textual equivalent in
         OperationsCalendarDayViewModel.AutomationName). Deliberately no per-operating-state color
         (spec Part V "avoid one color per operating state ... red for Closed") — the compact text
         labels below are the state signal; today/selected keep their existing border/band treatment
         so the two concerns never visually collide.
         Phase 13D: MinHeight (content could grow the cell taller than its siblings) replaced with a
         fixed Height, uniform for every cell regardless of how many optional indicator lines a given
         date has (notes, Important notes, waterpark hours, staleness) — combined with ClipToBounds and
         single-line/trimmed content below, this is what makes "one date's content must never expand
         only that date's cell" actually structurally impossible rather than merely usually true. -->
    <!-- Phase 15B Part 1/2: root cause of the pre-15B "narrow vertical strip" appearance —
         FluentTheme's default Button ControlTheme sets HorizontalAlignment to a non-Stretch value
         (confirmed empirically via a real headless-windowed layout pass: freshly-constructed Button
         instances report HorizontalAlignment=Stretch at the CLR-default level, but once styled by the
         running app's FluentTheme, the realized value is non-Stretch) — so every day cell sized to its
         own content instead of its UniformGrid column, and content-sparse off-month cells (bare day
         number only) collapsed to a "sliver" while content-heavy in-month cells stayed only somewhat
         wider, leaving the column's remaining width as unused gap. HorizontalAlignment="Stretch" below
         is the actual fix; it only takes effect once paired with the view's real 7-column Grid-per-week
         layout (never UniformGrid — see the month grid below), since a Grid's star columns are the
         part that guarantees "the available column width" exists to stretch into in the first place. -->
    <Style Selector="Button.calendarDay">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Height" Value="132" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <!-- Phase 32A: Stretch (was Left) so every cell's content spans the full cell width. With Left, the
           top row was only as wide as that cell's widest text line, so the Pass Perks markers landed at a
           different distance from the day number in each cell. Text still reads left-aligned. -->
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.calendarDay.outOfMonth">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Phase 12E Part E: Today (not selected) stays outline-only — visible, but deliberately quieter
         than Selected. Selected (not Today) is filled + outlined, so it reads as unmistakable even
         on its own. Today+Selected together (below) gets its own, more deeply tinted combination
         rather than silently collapsing into whichever rule happens to apply last — never relying on
         color alone, since IsToday/IsSelected are both also always present in the cell's own
         AutomationName. -->
    <Style Selector="Button.calendarDay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.calendarDay.today">
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.calendarDay.selected">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.calendarDay.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.calendarDay.today.selected">
      <Setter Property="Background" Value="{DynamicResource PassdownChipAccentBrush}" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>
    <Style Selector="TextBlock.dayIndicator">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Compact operating-state label ("CLOSED"/"CUSTOM"/"BUYOUT"/"NOT PUBLISHED"/"UNAVAILABLE",
         spec Part C/D/E/F/G/H/I) — text only, no per-state color (Part V). -->
    <Style Selector="TextBlock.dayStateLabel">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.3" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Phase 15B Part 4: the strongest line in the cell after the date itself (spec "main park
         hours/status should be visually strongest after the date") — bumped from the pre-15B 10.5px
         now that full-width columns leave room for it, without needing a second font weight/color
         convention. -->
    <!-- Phase 22F: wraps (after the en dash) to at most two lines instead of truncating — at 960 px or at
         125–150% scaling "12 PM–9 PM" was cut to "12 PM–9…". Wider cells still show one line. -->
    <Style Selector="TextBlock.dayHoursLine">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- The shared muted-amber Stale status color ("warning, not error", spec Part J) — never red. -->
    <Style Selector="TextBlock.dayStaleLabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownStaleBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Compact Carolina Harbor line (spec Phase 13D Part F) — same cell as main park hours, never a
         separate badge/card; slightly muted relative to dayHoursLine so the main gate's hours stay
         the visually primary line. -->
    <!-- Phase 22E: one row of the expanded Shows schedule — a hairline above each row, no card. -->
    <Style Selector="Border.calendarShowRow">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="TextBlock.dayWaterparkLine">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Phase 32: Pass Perks marker — small and quiet (secondary text colour), so it never competes with
         the hours line; the count only appears when more than one perk shares the date. -->
    <Style Selector="PathIcon.passPerkMarker">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
    <!-- Phase 32A: count badge in the marker slot's top-right corner (inside the slot, so it never moves the icon). -->
    <Style Selector="Border.passPerkCountBadge">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="1,0" />
      <Setter Property="Background" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>
    <Style Selector="Border.passPerkCountBadge > TextBlock">
      <Setter Property="FontSize" Value="7" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LineHeight" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextOnAccentBrush}" />
    </Style>
    <Style Selector="PathIcon.passPerkLegendIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- Phase 32: one Pass Perk on the selected date — why it is on this date, its name, one meta line and
         the small View details link (the shared in-app dialog). -->
    <DataTemplate DataType="vm:PassPerkItemViewModel" x:DataType="vm:PassPerkItemViewModel">
      <Border Classes="calendarShowRow">
        <StackPanel Spacing="1" AutomationProperties.Name="{Binding AccessibleSummary}">
          <!-- Phase 32A: the marker type first (same icon as the day cell), then what the date means. -->
          <StackPanel Orientation="Horizontal" IsVisible="{Binding HasHeadlineText}">
            <Panel IsVisible="{Binding MarkerKind, Converter={x:Static ObjectConverters.IsNotNull}}">
              <PathIcon Classes="passPerkLegendIcon" Data="{StaticResource PassdownCheckCircleIconGeometry}" IsVisible="{Binding IsQualifyingVisit}"
                        AutomationProperties.AccessibilityView="Raw" />
              <PathIcon Classes="passPerkLegendIcon" Data="{StaticResource PassdownGiftIconGeometry}" IsVisible="{Binding IsRedemption}"
                        AutomationProperties.AccessibilityView="Raw" />
              <PathIcon Classes="passPerkLegendIcon" Data="{StaticResource PassdownClockIconGeometry}" IsVisible="{Binding IsDeadline}"
                        AutomationProperties.AccessibilityView="Raw" />
            </Panel>
            <TextBlock Text="{Binding HeadlineText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PassdownAccentForegroundBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Classes.muted="{Binding IsNotCurrent}" />
          <TextBlock Text="{Binding MetaText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding NoticeText}" IsVisible="{Binding HasNoticeText}" Classes="fieldWarning" FontSize="12" TextWrapping="Wrap" />
          <Button Content="View details" Command="{Binding ViewDetailsCommand}" IsVisible="{Binding CanViewDetails}"
                  Classes="linkAction" FontSize="12" Padding="4,1" MinHeight="0" Margin="-4,0,0,0" HorizontalAlignment="Left"
                  AutomationProperties.Name="{Binding ViewDetailsAutomationName}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="OPERATIONS CALENDAR" Classes="sectionTitle" Margin="0" />
          <TextBlock Text="{Binding DisplayedMonthText}" Classes="pageTitle"
                     AutomationProperties.Name="Displayed month" />
          <!-- Phase 20C: background current-year history status — deliberately small and muted, and
               separate from the operational "Official data checked …" line. -->
          <TextBlock Text="{Binding HistoryStatus.Text}" Classes="muted"
                     IsVisible="{Binding HasHistoryStatus}"
                     ToolTip.Tip="{Binding HistoryStatus.DetailText}"
                     AutomationProperties.Name="{Binding HistoryStatus.AutomationText}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="‹ Prev" Classes="secondaryAction" Command="{Binding PreviousMonthCommand}"
                  AutomationProperties.Name="Previous month" />
          <Button Content="Today" Classes="secondaryAction" Command="{Binding GoToTodayCommand}"
                  AutomationProperties.Name="Go to today" />
          <Button Content="Next ›" Classes="secondaryAction" Command="{Binding NextMonthCommand}"
                  AutomationProperties.Name="Next month" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="24,20,24,24">
      <StackPanel Spacing="16">

        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" AutomationProperties.Name="Loading calendar" />

        <TextBlock Text="{Binding ErrorMessage}" Classes="fieldError" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Grid IsVisible="{Binding HasSnapshot}" ColumnDefinitions="*,320">

          <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">

            <Grid ColumnDefinitions="*,*,*,*,*,*,*" AutomationProperties.Name="Weekday headers">
              <TextBlock Grid.Column="0" Text="Sun" Classes="weekdayHeader" />
              <TextBlock Grid.Column="1" Text="Mon" Classes="weekdayHeader" />
              <TextBlock Grid.Column="2" Text="Tue" Classes="weekdayHeader" />
              <TextBlock Grid.Column="3" Text="Wed" Classes="weekdayHeader" />
              <TextBlock Grid.Column="4" Text="Thu" Classes="weekdayHeader" />
              <TextBlock Grid.Column="5" Text="Fri" Classes="weekdayHeader" />
              <TextBlock Grid.Column="6" Text="Sat" Classes="weekdayHeader" />
            </Grid>

            <!-- Phase 15B Part 1: one real Grid per week (never UniformGrid — see the
                 Button.calendarDay style comment above for why) so the month reads as a true
                 full-width 7-column grid: ColumnDefinitions="*,*,*,*,*,*,*" guarantees each week row's
                 7 columns divide the available width evenly regardless of any day's content, which is
                 what a content-sized panel (UniformGrid, or an ItemsControl whose containers don't
                 stretch) cannot guarantee. The outer ItemsControl (Weeks) only stacks a variable
                 number of week rows (5 or 6, spec's own "no fabricated cells" rule) — each row is
                 itself an inner ItemsControl over that week's 7 days, whose ItemsPanel IS the 7-column
                 Grid. ContentPresenter is the actual container Avalonia generates per item (confirmed
                 empirically), so Grid.Column must be set on it directly — not on the templated Button
                 — via the ItemsControl.Styles setter below, bound to
                 OperationsCalendarDayViewModel.ColumnIndex (Sunday=0 .. Saturday=6, matching the
                 weekday header above). -->
            <ItemsControl ItemsSource="{Binding Weeks}" AutomationProperties.Name="Calendar month grid">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationsCalendarWeekViewModel">
                  <ItemsControl ItemsSource="{Binding Days}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Calendar week row">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                      <Style Selector="ContentPresenter" x:DataType="vm:OperationsCalendarDayViewModel">
                        <Setter Property="Grid.Column" Value="{Binding ColumnIndex}" />
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OperationsCalendarDayViewModel">
                        <Button Classes="calendarDay" Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                                Classes.outOfMonth="{Binding !IsInDisplayedMonth}"
                                Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AutomationName}">
                          <StackPanel Spacing="3">
                            <!-- Phase 32A: a fixed-height top row — the day number pinned top-left and the Pass Perks
                                 markers in a fixed top-right strip. The row is the same height whether or not a
                                 cell has markers, so the number and everything below it sit at the same place in
                                 every cell. Markers keep a fixed order (qualifying visit, redemption, deadline), a
                                 fixed 15×14 slot each and a 3px gap; a count badge sits inside the slot, so a
                                 count never shifts the icon. Tooltip and the cell's AutomationName name each type. -->
                            <Grid ColumnDefinitions="Auto,*" Height="18" Classes="dayTopRow">
                              <TextBlock Grid.Column="0" Text="{Binding DayNumber}" FontWeight="SemiBold" FontSize="14"
                                         VerticalAlignment="Top" LineHeight="18" />
                              <!-- Compact fallback: when a narrow cell can't fit every marker at full size (in practice
                                   only three types on one date at ~960 px), the Viewbox shrinks the whole strip
                                   proportionally (DownOnly) — never clipped, never reordered, still right-aligned. -->
                              <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,2,0,0"
                                       IsVisible="{Binding HasPassPerks}">
                              <ItemsControl ItemsSource="{Binding PassPerkMarkers}" Classes="passPerkMarkers"
                                            ToolTip.Tip="{Binding PassPerkAccessibilityText}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:PassPerkDayMarker">
                                    <Panel Width="15" Height="14" ToolTip.Tip="{Binding AccessibilityText}">
                                      <PathIcon Classes="passPerkMarker" Data="{StaticResource PassdownCheckCircleIconGeometry}"
                                                IsVisible="{Binding IsQualifyingVisit}" AutomationProperties.AccessibilityView="Raw" />
                                      <PathIcon Classes="passPerkMarker" Data="{StaticResource PassdownGiftIconGeometry}"
                                                IsVisible="{Binding IsRedemption}" AutomationProperties.AccessibilityView="Raw" />
                                      <PathIcon Classes="passPerkMarker" Data="{StaticResource PassdownClockIconGeometry}"
                                                IsVisible="{Binding IsDeadline}" AutomationProperties.AccessibilityView="Raw" />
                                      <Border Classes="passPerkCountBadge" IsVisible="{Binding HasCount}">
                                        <TextBlock Text="{Binding CountText}" />
                                      </Border>
                                    </Panel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              </Viewbox>
                            </Grid>

                            <!-- Operating-state/hours/passdown-status/notes overlay (spec Phase 12B
                                 Part C/D/E/F/G/H/I; Phase 12C Part G/H/I): hidden as one unit for
                                 out-of-month cells to avoid clutter (Part I — "day number only"
                                 preserved from 12A/12B), even though those dates still carry real
                                 data. Content-budget priority (Part H; reaffirmed Phase 15B Part 4)
                                 top to bottom: day number (outside this block), operating
                                 state/hours, passdown status, operational-notes summary. -->
                            <StackPanel Spacing="2" IsVisible="{Binding IsInDisplayedMonth}">
                              <TextBlock Text="{Binding OperatingStateLabel}" Classes="dayStateLabel" IsVisible="{Binding HasOperatingStateLabel}" />
                              <TextBlock Text="{Binding EffectiveHoursLineDisplay}" Classes="dayHoursLine" IsVisible="{Binding HasEffectiveHoursLine}" />
                              <!-- Phase 13D Part F: same cell as main park hours, never a separate badge. -->
                              <TextBlock Text="{Binding WaterparkLineDisplay}" Classes="dayWaterparkLine" IsVisible="{Binding HasWaterparkLine}" />
                              <TextBlock Text="Stale" Classes="dayStaleLabel" IsVisible="{Binding IsHoursStale}" />
                              <TextBlock Text="{Binding PassdownStatusLabel}" Classes="dayIndicator" />
                              <!-- Phase 12E Part H: the "Important" clause reuses the app's one
                                   established restrained-accent convention (never a red/alarm badge)
                                   — see TextBlock.priorityText.important above. -->
                              <TextBlock Text="{Binding NotesSummaryText}" Classes="dayIndicator priorityText"
                                         Classes.important="{Binding HasImportantOperationalNotes}"
                                         IsVisible="{Binding HasOperationalNotes}" />
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Phase 32A: a one-line legend for the Pass Perks marker shapes, only while markers are shown and
                 the month has any. Text labels, so the meaning never relies on the icon alone. -->
            <WrapPanel x:Name="PassPerkLegend" ItemSpacing="16" Margin="2,2,0,0" IsVisible="{Binding HasPassPerkLegend}"
                       AutomationProperties.Name="Pass Perks markers: check mark, qualifying visit date; gift, redemption date; clock, booking deadline">
              <TextBlock Text="Pass Perks:" Classes="muted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal">
                <PathIcon Classes="passPerkLegendIcon" Data="{StaticResource PassdownCheckCircleIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Qualifying visit" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <PathIcon Classes="passPerkLegendIcon" Data="{StaticResource PassdownGiftIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Redemption / use" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <PathIcon Classes="passPerkLegendIcon" Data="{StaticResource PassdownClockIconGeometry}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Booking deadline" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </WrapPanel>

          </StackPanel>

          <!-- Phase 12E Part A/Q: "heroPanel" (a 3px accent top rule, same recipe as Dashboard's own
               Today's Operation/Passdown Status panels) marks this as the one panel that anchors the
               screen's secondary hierarchy tier, below the grid itself — reused, not reinvented.
               Phase 22E: each information group is its own tight label/value stack (heading → value 2px)
               with 14px between groups, so headings bind to their values instead of floating evenly. -->
          <Border Grid.Column="1" Classes="panel heroPanel" AutomationProperties.Name="Selected date summary">
            <StackPanel Spacing="14">

              <StackPanel Spacing="6">
                <TextBlock Text="SELECTED DATE" Classes="subsectionTitle" Margin="0" />
                <WrapPanel Orientation="Horizontal">
                  <!-- Phase 22F: bound to the view model's own selected date, so the heading changes the
                       instant a date is chosen rather than when its details finish loading. -->
                  <TextBlock x:Name="SelectedDateHeading" Text="{Binding SelectedDateHeadingText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             AutomationProperties.Name="{Binding SelectedDateHeadingText, StringFormat='Selected date: {0}'}" />
                  <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding SelectedDateIsToday}">
                    <TextBlock Text="Today" />
                  </Border>
                </WrapPanel>
                <!-- Previous/Next Day (Phase 12D Part C): explicit day-stepping alongside the day-cell
                     grid and month navigation — supervisors scanning adjacent days without switching
                     months. Plain Buttons, keyboard-reachable like every other action on this screen.
                     Phase 22E: a WrapPanel, so at 125–150% scaling the pair wraps instead of overflowing the panel. -->
                <WrapPanel Orientation="Horizontal">
                  <Button Content="‹ Prev Day" Classes="secondaryAction" Command="{Binding PreviousDayCommand}" Margin="0,0,8,4"
                          AutomationProperties.Name="Previous day" />
                  <Button Content="Next Day ›" Classes="secondaryAction" Command="{Binding NextDayCommand}" Margin="0,0,0,4"
                          AutomationProperties.Name="Next day" />
                </WrapPanel>
              </StackPanel>

              <!-- Phase 12E Part J/P: a hairline separates day-identity/day-stepping from the
                   informational groups below. -->
              <Border Height="1" Background="{DynamicResource PassdownDividerBrush}" />

              <!-- Phase 22F: while the selected date's details are not loaded (a date change in flight, or a
                   failed local read) one compact line stands in for them — the previous date's hours,
                   pricing, Shows, passdown status and notes are never shown under the new heading. -->
              <TextBlock x:Name="SelectedDetailPlaceholder" Text="{Binding SelectedDetailPlaceholderText}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding !IsSelectedDetailCurrent}"
                         AutomationProperties.LiveSetting="Polite" />

              <StackPanel x:Name="SelectedDateDetails" Spacing="14" IsVisible="{Binding IsSelectedDetailCurrent}">

              <!-- Park Status / Effective Hours (spec Phase 12B Part K) — reuses the same
                   ParkHoursPresentation formatter Associate Overview/Dashboard already use; never a
                   second hours computation. -->
              <StackPanel Spacing="2" AutomationProperties.Name="Park status">
                <TextBlock Text="PARK STATUS" Classes="subsectionTitle" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Presentation.ParkStatusText}" FontWeight="SemiBold"
                           AutomationProperties.Name="{Binding Presentation.ParkStatusText, StringFormat='Park status: {0}'}" />
                <TextBlock Text="{Binding Presentation.EffectiveHoursText}" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.EffectiveHoursText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding Presentation.EffectiveHoursText, StringFormat='Effective hours: {0}'}" />
                <TextBlock Text="{Binding Presentation.ParkHoursVerificationText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.ParkHoursVerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Presentation.ParkHoursStaleNoteText}" Classes="fieldWarning" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.ParkHoursStaleNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Carolina Harbor / waterpark hours (spec Phase 13D Part G) — omitted cleanly (no
                     blank placeholder) whenever not published for the selected date. -->
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" IsVisible="{Binding Presentation.HasWaterparkHours}"
                           AutomationProperties.Name="{Binding Presentation.WaterparkHoursText, StringFormat='Carolina Harbor hours: {0}'}"><Run Text="Carolina Harbor · " Foreground="{DynamicResource PassdownTextSecondaryBrush}" /><Run Text="{Binding Presentation.WaterparkHoursText}" /></TextBlock>
              </StackPanel>

              <!-- Daily Admission pricing (spec Phase 13D Part AH/AK) — deliberately just one compact
                   line, never every Fast Lane option/pass/promotion/bundle; View Date Pricing (below)
                   is the seam to full detail. -->
              <StackPanel Spacing="2">
                <TextBlock Text="DAILY TICKET" Classes="subsectionTitle" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Presentation.DailyAdmissionPriceText}" FontWeight="SemiBold"
                           AutomationProperties.Name="{Binding Presentation.DailyAdmissionPriceText, StringFormat='Daily ticket price: {0}'}" />
              </StackPanel>

              <!-- Phase 22E: compact Shows — one summary line ("6 scheduled shows · 22 performances") and a
                   "View schedule ▾" disclosure (the shared Expander.disclosure: ExpandCollapse automation,
                   Enter/Space, Fluent focus) revealing every official start time and venue. Collapsed by
                   default; the preference survives date changes for the session. Empty, unpublished, closed,
                   failed and past states are words, never "0 shows", and get no empty disclosure.
                   CalendarShows is null while a newly selected date loads, so the previous date's lineup
                   is never shown under it. Expanding never loads anything. -->
              <StackPanel Spacing="2" IsVisible="{Binding CalendarShows, Converter={x:Static ObjectConverters.IsNotNull}}"
                          AutomationProperties.Name="Shows">
                <TextBlock Text="SHOWS" Classes="subsectionTitle" Margin="0,0,0,2" />
                <TextBlock Text="{Binding CalendarShows.SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"
                           IsVisible="{Binding CalendarShows.HasSummary, FallbackValue=False}"
                           AutomationProperties.Name="{Binding CalendarShows.SummaryText, StringFormat='Shows: {0}'}" />
                <TextBlock Text="{Binding CalendarShows.StatusText}" TextWrapping="Wrap"
                           Classes="muted" Classes.statusError="{Binding CalendarShows.IsProblem, FallbackValue=False}"
                           IsVisible="{Binding CalendarShows.HasStatusText, FallbackValue=False}" />
                <Expander x:Name="ShowScheduleExpander" Classes="disclosure" Margin="0,2,0,0"
                          Header="{Binding ShowScheduleToggleText}"
                          IsExpanded="{Binding IsShowScheduleExpanded}"
                          IsVisible="{Binding CalendarShows.HasSchedule, FallbackValue=False}"
                          AutomationProperties.Name="Show schedule">
                  <ItemsControl ItemsSource="{Binding CalendarShows.Rows}" AutomationProperties.Name="Shows for the selected date">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="presentation:CalendarShowRowPresentation">
                        <Border Classes="calendarShowRow" AutomationProperties.Name="{Binding AccessibleText}">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding TimesText}" /><Run Text="{Binding VenueSuffix}" Foreground="{DynamicResource PassdownTextSecondaryBrush}" /></TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
                <TextBlock Text="{Binding CalendarShows.FreshnessText}" Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0"
                           IsVisible="{Binding CalendarShows.HasFreshnessText, FallbackValue=False}" />
              </StackPanel>

              <!-- Phase 32: Pass Perks for the selected date — perks with a confirmed date-specific entry
                   (redemption begins/ends, booking deadline, last qualifying day, short window), then a
                   collapsed "Valid all {month}" summary for month-long perks (never repeated daily
                   markers). Hidden by Settings → Calendar → Show Pass Perks on Calendar. -->
              <StackPanel x:Name="SelectedDatePassPerks" Spacing="2" IsVisible="{Binding HasPassPerksSection}"
                          AutomationProperties.Name="Pass Perks">
                <TextBlock Text="PASS PERKS" Classes="subsectionTitle" Margin="0,0,0,2" />
                <ItemsControl ItemsSource="{Binding SelectedDatePassPerks}" IsVisible="{Binding HasSelectedDatePassPerks}"
                              AutomationProperties.Name="Pass Perks dates on the selected date" />
                <Expander Classes="disclosure" Margin="0,2,0,0" Header="{Binding MonthLongPassPerksHeaderText}"
                          IsVisible="{Binding HasMonthLongPassPerks}"
                          AutomationProperties.Name="{Binding MonthLongPassPerksHeaderText}">
                  <ItemsControl ItemsSource="{Binding MonthLongPassPerks}" />
                </Expander>
              </StackPanel>

              <!-- Passdown Status (spec Phase 12C Part J/Y): No Draft/Draft In Progress/Finalized,
                   reusing OperationsCalendarPassdownPresentation for both the label and its detail
                   note (last-saved/finalized timestamp, or an empty-state sentence). -->
              <StackPanel Spacing="2">
                <TextBlock Text="PASSDOWN STATUS" Classes="subsectionTitle" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Presentation.PassdownStatusText}" FontWeight="SemiBold"
                           AutomationProperties.Name="{Binding Presentation.PassdownStatusText, StringFormat='Passdown status: {0}'}" />
                <TextBlock Text="{Binding Presentation.PassdownDetailNoteText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.PassdownDetailNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <!-- Active Operational Notes (spec Phase 12C Part J/T): the persistent Operational
                   Notes concept, deliberately labeled to avoid confusion with the daily Associate
                   draft's own Notes entry — counts only, never note titles/bodies (Part S).
                   Phase 12E Part H/Q: "Important" reuses TextBlock.priorityText.important (never red). -->
              <StackPanel Spacing="2">
                <TextBlock Text="ACTIVE OPERATIONAL NOTES" Classes="subsectionTitle" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Presentation.OperationalNotesCountText}" FontWeight="SemiBold"
                           AutomationProperties.Name="{Binding Presentation.OperationalNotesCountText, StringFormat='Active operational notes: {0}'}" />
                <TextBlock Text="{Binding Presentation.OperationalNotesImportantText}" Classes="priorityText important" TextWrapping="Wrap"
                           IsVisible="{Binding Presentation.OperationalNotesImportantText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              </StackPanel>

              <!-- Phase 12E Part J/P: a second divider separates the informational groups above from
                   the routing actions below. -->
              <Border Height="1" Background="{DynamicResource PassdownDividerBrush}" />

              <StackPanel Spacing="8">
                <Button Content="Open Passdown" Classes="primaryAction" Command="{Binding OpenAssociateCommand}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open Passdown"
                        AutomationProperties.HelpText="Opens Associate Passdown set to the selected date." />
                <!-- Phase 12E Part S: disabled (not hidden) until Finalized — HelpText is dynamic so a
                     disabled control's explanation stays accurate. -->
                <Button Content="Open History" Classes="secondaryAction" Command="{Binding OpenHistoryCommand}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open History"
                        AutomationProperties.HelpText="{Binding OpenHistoryHelpText}" />
                <!-- Phase 13D Part AI/AJ: local-only navigation to Associate's Products section for the
                     selected date — never triggers Check Online by itself. -->
                <Button Content="View Date Pricing" Classes="secondaryAction" Command="{Binding ViewDatePricingCommand}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="View Date Pricing"
                        AutomationProperties.HelpText="Opens full product pricing for the selected date." />
                <Button Content="Open Operational Notes" Classes="secondaryAction" Command="{Binding OpenOperationalNotesCommand}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open Operational Notes"
                        AutomationProperties.HelpText="Opens the Operational Notes manager." />
              </StackPanel>
            </StackPanel>
          </Border>

        </Grid>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
