<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.PersonalSyncSettingsView"
             x:DataType="vm:PersonalSyncSettingsViewModel">

  <!-- Phase 16B: the smallest configuration surface for the local sync foundation (§4/§14). Phase
       16C adds the one manual "Sync Now" action and a simple result line (§25/§26) — still no
       last-sync-time, automatic cadence, or conflict-resolution controls; those belong to 16D/16F.
       Styles mirror HistoryView's own small, self-contained subset. -->
  <UserControl.Styles>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceTintBrush}" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.secondaryAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondaryAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
    </Style>

    <Style Selector="Button.textAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.conflictRow">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
    </Style>

    <Style Selector="Grid.fieldComparisonRow > TextBlock">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

  </UserControl.Styles>

  <Grid x:Name="PersonalSyncRoot" RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceTintBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <StackPanel Spacing="2">
        <TextBlock Text="Settings" Classes="pageTitle" />
        <TextBlock Text="Local app settings. Personal Sync is optional and off by default."
                   Classes="muted" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="24,20,24,24">
      <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="Personal Sync" Classes="sectionTitle" Margin="0" />

        <Border Classes="panel">
          <StackPanel Spacing="14">

            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="Keep your own Associate drafts, Operational Notes, and finalized History in sync between your own Windows machines, using a folder you choose (typically inside your personal OneDrive). This app never requires OneDrive, and no other user's data is ever involved." />

            <CheckBox Content="Enable Personal Sync" IsChecked="{Binding PersonalSyncEnabled}"
                       IsEnabled="{Binding !IsBusy}"
                       AutomationProperties.Name="Enable Personal Sync" />

            <StackPanel Spacing="4">
              <TextBlock Text="Folder" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SyncRootPath}" TextWrapping="Wrap"
                         IsVisible="{Binding SyncRootPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="No folder chosen yet." Classes="muted"
                         IsVisible="{Binding SyncRootPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{Binding FirstSuggestedRoot, StringFormat='Detected OneDrive folder: {0}'}"
                         IsVisible="{Binding HasSuggestedRoots}" />
            </StackPanel>

            <Button Content="Choose Folder…" Classes="secondaryAction" HorizontalAlignment="Left"
                    Command="{Binding ChooseFolderCommand}"
                    AutomationProperties.Name="Choose Personal Sync Folder" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Status" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Classes="chip">
                <TextBlock Text="{Binding StatusPresentation.Text}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding StatusDetail}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Phase 16F §12/§13/§17: the automatic-sync status this phase adds — layered on top of
                 the readiness chip above, never replacing it. Compact by design (§17): one chip, an
                 optional one-line detail, and a "Last synced" line. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Sync" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Classes="chip">
                <TextBlock Text="{Binding AutomationStatusPresentation.Text}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding AutomationStatusPresentation.DetailText}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding AutomationStatusPresentation.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding LastSyncedText}" Classes="muted"
                       IsVisible="{Binding LastSyncedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Content="Sync Now" Classes="secondaryAction" HorizontalAlignment="Left"
                    Command="{Binding SyncNowCommand}"
                    AutomationProperties.Name="Sync Now" />
            <TextBlock Text="{Binding SyncResultSummary}" TextWrapping="Wrap"
                       IsVisible="{Binding SyncResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Phase 16D §4/§27: a minimal conflict callout — never shown when there is nothing to review. -->
            <StackPanel Spacing="8" IsVisible="{Binding HasConflicts}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Status" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Classes="chip">
                  <TextBlock Text="Conflict attention needed" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding ConflictStatusText}" />
              <Button Content="Review Conflicts" Classes="secondaryAction" HorizontalAlignment="Left"
                      Command="{Binding ReviewConflictsCommand}"
                      AutomationProperties.Name="Review Conflicts" />
            </StackPanel>

          </StackPanel>
        </Border>

        <!-- Phase 16D §4/§5/§6: the conflict list. Selecting a row loads its detail below. -->
        <StackPanel Spacing="16" IsVisible="{Binding IsReviewingConflicts}">
          <TextBlock Text="Conflicts" Classes="sectionTitle" Margin="0" />
          <Border Classes="panel">
            <StackPanel Spacing="10">
              <ItemsControl ItemsSource="{Binding Conflicts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="conflictRow" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" VerticalAlignment="Center" FontWeight="Medium" />
                        <Button Grid.Column="1" Content="Review"
                                Command="{Binding #PersonalSyncRoot.((vm:PersonalSyncSettingsViewModel)DataContext).OpenConflictCommand}"
                                CommandParameter="{Binding}"
                                Classes="secondaryAction" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Close" Classes="textAction" HorizontalAlignment="Left"
                      Command="{Binding CloseConflictsCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Phase 16D §5/§6/§7/§8/§15: the focused local-vs-remote comparison and explicit resolution actions. -->
        <StackPanel Spacing="16" IsVisible="{Binding SelectedConflictDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="Conflict Detail" Classes="sectionTitle" Margin="0" />
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding SelectedConflictDetail.Title}" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="{Binding SelectedConflictDetail.Explanation}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedConflictDetail.RemoteActivityLabel}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedConflictDetail.NewerActivityNote}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding SelectedConflictDetail.NewerActivityNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Field" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="This Device" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Other Device" FontWeight="SemiBold" />
              </Grid>
              <ItemsControl ItemsSource="{Binding SelectedConflictDetail.Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Classes="fieldComparisonRow" ColumnDefinitions="*,*,*">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Medium" />
                      <TextBlock Grid.Column="1" Text="{Binding LocalValue}" />
                      <TextBlock Grid.Column="2" Text="{Binding RemoteValue}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding ConflictActionMessage}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding ConflictActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Keep This Device" Classes="secondaryAction"
                        Command="{Binding KeepLocalCommand}"
                        AutomationProperties.Name="Keep This Device" />
                <Button Content="Use Other Device" Classes="secondaryAction"
                        Command="{Binding UseRemoteCommand}"
                        IsVisible="{Binding !SelectedConflictDetail.IsRemoteDeletion}"
                        AutomationProperties.Name="Use Other Device" />
                <Button Content="Accept Deletion" Classes="secondaryAction"
                        Command="{Binding AcceptDeletionCommand}"
                        IsVisible="{Binding SelectedConflictDetail.IsRemoteDeletion}"
                        AutomationProperties.Name="Accept Deletion" />
                <Button Content="Cancel" Classes="textAction"
                        Command="{Binding CloseConflictDetailCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Text="Device" Classes="sectionTitle" Margin="0" />
        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="This installation's device ID (used only to tell your own devices' changes apart during sync — never shown to anyone else and never derived from your name, email, or computer)." Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" />
          </StackPanel>
        </Border>

        <!-- Phase 18D: identifies the exact running build (docs/support-troubleshooting.md "Which copy
             is running?") — compare the folder with the current release folder to spot a stale copy. -->
        <TextBlock Text="About this build" Classes="sectionTitle" Margin="0" />
        <Border Classes="panel">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="App" Classes="muted" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BuildProductName}" FontWeight="Medium"
                       AutomationProperties.Name="{Binding BuildProductName, StringFormat='App: {0}'}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Classes="muted" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildVersionText}" FontWeight="Medium"
                                 AutomationProperties.Name="{Binding BuildVersionText, StringFormat='Version: {0}'}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Running from" Classes="muted" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildExecutablePathText}" TextWrapping="Wrap"
                                 FontFamily="Consolas,Menlo,monospace" FontSize="12.5"
                                 AutomationProperties.Name="{Binding BuildExecutablePathText, StringFormat='Running from: {0}'}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="If this folder is not the release folder you extracted most recently, Windows opened an older copy." />
          </Grid>
        </Border>

        <!-- Phase 21B: Export Diagnostics lives here (moved from the Associate toolbar — an
             administrative/support action, not part of preparing the passdown). Same export service,
             privacy filtering, ZIP format and save picker as before. -->
        <TextBlock Text="Diagnostics" Classes="sectionTitle" Margin="0" />
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Creates a support bundle with version, data-source status, and recent log information. It never includes notes, the Daily Feature, drafts, sync data, PDFs, or the database." />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Export Diagnostics…" Classes="secondaryAction"
                      Command="{Binding Diagnostics.ExportDiagnosticsCommand}"
                      AutomationProperties.Name="Export Diagnostics"
                      AutomationProperties.HelpText="Saves a support diagnostic ZIP with version, source status, and recent log information. Contains no drafts or personal data." />
              <TextBlock Text="{Binding Diagnostics.DiagnosticsExportMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding Diagnostics.DiagnosticsExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
