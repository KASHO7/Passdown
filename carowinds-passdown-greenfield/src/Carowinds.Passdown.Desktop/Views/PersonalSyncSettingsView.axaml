<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.PersonalSyncSettingsView"
             x:DataType="vm:PersonalSyncSettingsViewModel">

  <!-- Phase 16B: the smallest configuration surface for the local sync foundation (§4/§14) — no
       "Last sync time"/"Sync now"/conflict count/device list; those belong to a later phase. Styles
       mirror HistoryView's own small, self-contained subset. -->
  <UserControl.Styles>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceTintBrush}" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.secondaryAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondaryAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceTintBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <StackPanel Spacing="2">
        <TextBlock Text="Settings" Classes="pageTitle" />
        <TextBlock Text="Local app settings. Personal Sync is optional and off by default."
                   Classes="muted" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="24,20,24,24">
      <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="Personal Sync" Classes="sectionTitle" Margin="0" />

        <Border Classes="panel">
          <StackPanel Spacing="14">

            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="Keep your own Associate drafts, Operational Notes, and finalized History in sync between your own Windows machines, using a folder you choose (typically inside your personal OneDrive). This app never requires OneDrive, and no other user's data is ever involved." />

            <CheckBox Content="Enable Personal Sync" IsChecked="{Binding PersonalSyncEnabled}"
                       IsEnabled="{Binding !IsBusy}"
                       AutomationProperties.Name="Enable Personal Sync" />

            <StackPanel Spacing="4">
              <TextBlock Text="Folder" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SyncRootPath}" TextWrapping="Wrap"
                         IsVisible="{Binding SyncRootPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="No folder chosen yet." Classes="muted"
                         IsVisible="{Binding SyncRootPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{Binding FirstSuggestedRoot, StringFormat='Detected OneDrive folder: {0}'}"
                         IsVisible="{Binding HasSuggestedRoots}" />
            </StackPanel>

            <Button Content="Choose Folder…" Classes="secondaryAction" HorizontalAlignment="Left"
                    Command="{Binding ChooseFolderCommand}"
                    AutomationProperties.Name="Choose Personal Sync Folder" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Status" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Classes="chip">
                <TextBlock Text="{Binding StatusPresentation.Text}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding StatusDetail}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          </StackPanel>
        </Border>

        <TextBlock Text="Device" Classes="sectionTitle" Margin="0" />
        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="This installation's device ID (used only to tell your own devices' changes apart during sync — never shown to anyone else and never derived from your name, email, or computer)." Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
