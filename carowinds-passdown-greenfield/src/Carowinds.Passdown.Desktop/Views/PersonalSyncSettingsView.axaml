<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:updates="using:Carowinds.Passdown.Application.Updates"
             xmlns:converters="using:Carowinds.Passdown.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.PersonalSyncSettingsView"
             x:DataType="vm:PersonalSyncSettingsViewModel">

  <!-- Phase 16B: the configuration surface for the local sync foundation (§4/§14); 16C–16F added Sync Now,
       automatic-sync status and conflict review; Phase 22F organized the page into groups; Phase 23C/23D/31D/32/35A
       added Appearance, Application Updates, Passdown defaults, Calendar and Interface animations.

       Phase 35F (approved prototypes carowinds_settings_original_icon_prototype.html and
       carowinds_settings_motion_prototype.html): a compact section list beside one scrolling page of group cards.
       Each card has a title and a one-line purpose, then setting rows — the label and explanation on the left,
       the control on the right. The section list only scrolls the page; it changes nothing. Every binding, command
       and accessible name of the earlier page is kept; Interface animations, Show Pass Perks and Enable Personal
       Sync are switches bound to the same saved settings as before. Shared styles come from
       Themes/PassdownStyles.axaml; only this screen's deltas live below. -->
  <UserControl.Styles>
    <Style Selector="Border.conflictRow">
      <Setter Property="Padding" Value="{DynamicResource PassdownInsetPadding}" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusCard}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownBorderBrush}" />
    </Style>

    <!-- Section list: a quiet column of text buttons; the current section is tinted, bold, has a left rule and is
         announced as the current section. -->
    <Style Selector="Border.settingsNav">
      <Setter Property="Background" Value="{DynamicResource PassdownNavigationBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="12,20,12,12" />
    </Style>
    <Style Selector="Button.settingsNavItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.settingsNavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.settingsNavItem.active">
      <Setter Property="Background" Value="{DynamicResource PassdownNavigationActiveBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownNavigationActiveIndicatorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="AutomationProperties.ItemStatus" Value="Current section" />
    </Style>
    <Style Selector="Button.settingsNavItem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownNavigationActiveBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownNavigationActiveIndicatorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentForegroundBrush}" />
    </Style>

    <!-- Group cards: the shared panel surface, with the card's own horizontal padding; rows run edge to edge
         between hairlines. -->
    <Style Selector="StackPanel.settingsGroups > Border.panel">
      <Setter Property="Padding" Value="22,0,22,4" />
    </Style>
    <Style Selector="StackPanel.groupHeader">
      <Setter Property="Spacing" Value="5" />
      <Setter Property="Margin" Value="0,18,0,14" />
    </Style>
    <Style Selector="StackPanel.groupHeader > TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.groupHeader > TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.settingRow">
      <Setter Property="ColumnSpacing" Value="20" />
      <Setter Property="Margin" Value="0,15,0,15" />
    </Style>
    <Style Selector="Grid.settingRow > StackPanel.settingText">
      <Setter Property="Spacing" Value="4" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.settingText > TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.settingText > TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.panel Border.divider">
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Label / value rows (Data Refresh, Personal Sync, Application Updates, About). -->
    <Style Selector="Grid.settingsRows">
      <Setter Property="ColumnSpacing" Value="18" />
      <Setter Property="RowSpacing" Value="12" />
      <Setter Property="Margin" Value="0,16,0,16" />
    </Style>
    <Style Selector="Grid.settingsRows > TextBlock.fieldLabel">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.folderPath">
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource PassdownRadiusControl}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="Grid.fieldComparisonRow > TextBlock">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="PersonalSyncRoot" RowDefinitions="Auto,*">

    <Border Grid.Row="0" Classes="pageHeader">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Settings" Classes="pageTitle" />
        <TextBlock Text="Preferences for this computer, Passdown defaults and connection details. Nothing here changes official park data."
                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

      <!-- Section list (presentation only): each item scrolls the page to its group. -->
      <Border Grid.Column="0" Classes="settingsNav" Width="196">
        <StackPanel x:Name="SettingsSectionList" Spacing="2" AutomationProperties.Name="Settings sections">
          <TextBlock Text="SETTINGS" Classes="eyebrow" Margin="13,0,0,12" />
          <Button Classes="settingsNavItem active" Content="Appearance" Tag="AppearanceSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Appearance settings" />
          <Button Classes="settingsNavItem" Content="Passdown Defaults" Tag="PassdownPreferencesSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Passdown Defaults settings" />
          <Button Classes="settingsNavItem" Content="Calendar" Tag="CalendarDisplaySection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Calendar settings" />
          <Button Classes="settingsNavItem" Content="Data Refresh" Tag="DataRefreshSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Data Refresh information" />
          <Button Classes="settingsNavItem" Content="Personal Sync" Tag="PersonalSyncSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Personal Sync settings" />
          <Button Classes="settingsNavItem" Content="Diagnostics" Tag="DiagnosticsSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Diagnostics" />
          <Button Classes="settingsNavItem" Content="Application Updates" Tag="ApplicationUpdatesSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to Application Updates" />
          <Button Classes="settingsNavItem" Content="About" Tag="AboutSection" Click="OnSectionNavClick"
                  AutomationProperties.Name="Go to About this build" />
        </StackPanel>
      </Border>

      <!-- One scroll region for the whole page (no nested ScrollViewer, no tabs, no expanders). -->
      <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" Padding="28,22,28,40" ScrollChanged="OnSettingsScrollChanged">
        <StackPanel x:Name="SettingsGroups" Classes="settingsGroups" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

          <!-- 1. Appearance (Phase 23C / 35A): System / Light / Dark, and Interface animations. Both apply at once and
               are saved on this computer only (never Personal Sync). Windows "Animation effects" off turns motion off
               without changing the saved choice; the note under the switch says so. -->
          <Border x:Name="AppearanceSection" Classes="panel" AutomationProperties.Name="Appearance">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Appearance" Classes="sectionTitle" />
                <TextBlock x:Name="AppearanceIntro" Classes="muted"
                           Text="Choose how Carowinds Operations looks. Saved on this computer only." />
              </StackPanel>
              <Border Classes="divider" />

              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Classes="settingText">
                  <TextBlock Text="Application theme" Classes="fieldLabel" />
                  <TextBlock Classes="muted" Text="Follow Windows or choose a specific appearance for this computer." />
                  <TextBlock Classes="muted" Text="{Binding Appearance.SystemAppearanceText}" />
                </StackPanel>
                <!-- One radio group — exactly one option is checked, Tab reaches the group, arrow keys move between
                     options, Space checks. -->
                <StackPanel x:Name="AppearanceOptions" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Top"
                            KeyboardNavigation.TabNavigation="Once"
                            XYFocus.NavigationModes="Keyboard"
                            GotFocus="OnAppearanceOptionGotFocus"
                            KeyDown="OnRadioGroupKeyDown"
                            AutomationProperties.Name="Appearance"
                            AutomationProperties.HelpText="Choose how Carowinds Operations looks">
                  <RadioButton x:Name="AppearanceSystemOption" GroupName="Appearance"
                               Content="Use Windows setting"
                               IsChecked="{Binding Appearance.IsSystemSelected}"
                               IsCheckedChanged="OnAppearanceOptionCheckedChanged"
                               AutomationProperties.Name="Use Windows setting" />
                  <RadioButton x:Name="AppearanceLightOption" GroupName="Appearance"
                               Content="Light"
                               IsChecked="{Binding Appearance.IsLightSelected}"
                               IsCheckedChanged="OnAppearanceOptionCheckedChanged"
                               AutomationProperties.Name="Light" />
                  <RadioButton x:Name="AppearanceDarkOption" GroupName="Appearance"
                               Content="Dark"
                               IsChecked="{Binding Appearance.IsDarkSelected}"
                               IsCheckedChanged="OnAppearanceOptionCheckedChanged"
                               AutomationProperties.Name="Dark" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="statusError" TextWrapping="Wrap" Margin="0,0,0,12"
                         Text="{Binding Appearance.SaveMessage}"
                         IsVisible="{Binding Appearance.SaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.LiveSetting="Polite" />

              <Border Classes="divider" />
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Classes="settingText">
                  <TextBlock x:Name="InterfaceAnimationsLabel" Text="Interface animations" Classes="fieldLabel" />
                  <TextBlock x:Name="InterfaceAnimationsIntro" Classes="muted"
                             Text="Short, subtle transitions in navigation and controls. Typing, saving, refreshing, previews and printing are never delayed by them. Respects the Windows animation-effects setting. Saved on this computer only." />
                  <TextBlock x:Name="InterfaceAnimationsSystemNote" Classes="muted"
                             Text="{Binding Appearance.MotionSystemText}"
                             IsVisible="{Binding Appearance.MotionSystemText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Classes="statusError" TextWrapping="Wrap"
                             Text="{Binding Appearance.MotionSaveMessage}"
                             IsVisible="{Binding Appearance.MotionSaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ToggleSwitch x:Name="InterfaceAnimationsSwitch" Grid.Column="1" VerticalAlignment="Top"
                              IsChecked="{Binding Appearance.AreAnimationsOn}"
                              AutomationProperties.Name="Interface animations"
                              AutomationProperties.HelpText="Turn short interface transitions on or off on this computer" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 2. Passdown Defaults (Phase 31D): which Include in Passdown sections start checked for a date with no saved
               draft. Each checkbox saves at once on this computer (no Apply button, no Personal Sync). A date that already
               has a saved draft always keeps its own saved selections. -->
          <Border x:Name="PassdownPreferencesSection" Classes="panel" AutomationProperties.Name="Passdown Defaults">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Passdown Defaults" Classes="sectionTitle" />
                <TextBlock x:Name="PassdownPreferencesIntro" Classes="muted"
                           Text="Choose which sections are selected automatically when starting a new Passdown." />
              </StackPanel>
              <Border Classes="divider" />
              <StackPanel Classes="settingText" Margin="0,15,0,10">
                <TextBlock Text="Default included sections" Classes="fieldLabel" />
                <TextBlock Classes="muted" Text="Saved on this computer only. Passdowns you have already started keep their own choices." />
              </StackPanel>
              <UniformGrid x:Name="PassdownPreferencesOptions" Columns="3" Margin="0,0,0,14"
                           AutomationProperties.Name="Sections selected automatically for a new Passdown">
                <CheckBox Content="Daily Admission" IsChecked="{Binding PassdownPreferences.DailyAdmission}"
                          AutomationProperties.Name="Select Daily Admission automatically for a new Passdown" />
                <CheckBox Content="Fast Lane" IsChecked="{Binding PassdownPreferences.FastLane}"
                          AutomationProperties.Name="Select Fast Lane automatically for a new Passdown" />
                <CheckBox Content="Promotions" IsChecked="{Binding PassdownPreferences.Promotions}"
                          AutomationProperties.Name="Select Promotions automatically for a new Passdown" />
                <CheckBox Content="Season Passes" IsChecked="{Binding PassdownPreferences.SeasonPasses}"
                          AutomationProperties.Name="Select Season Passes automatically for a new Passdown" />
                <CheckBox Content="Add-Ons" IsChecked="{Binding PassdownPreferences.AddOns}"
                          AutomationProperties.Name="Select Add-Ons automatically for a new Passdown" />
                <CheckBox Content="Operational Notes" IsChecked="{Binding PassdownPreferences.OperationalNotes}"
                          AutomationProperties.Name="Select Operational Notes automatically for a new Passdown" />
                <CheckBox Content="Shows" IsChecked="{Binding PassdownPreferences.Shows}"
                          AutomationProperties.Name="Select Shows automatically for a new Passdown" />
              </UniformGrid>
              <TextBlock Classes="statusError" TextWrapping="Wrap" Margin="0,0,0,12"
                         Text="{Binding PassdownPreferences.SaveMessage}"
                         IsVisible="{Binding PassdownPreferences.SaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.LiveSetting="Polite" />
              <!-- Phase 37D: the PDF Weather Outlook device preference — the same shared value as Overview → Include in
                   Passdown → Weather Outlook (PassdownWeatherOutlookSettingsViewModel, passdown-weather-outlook.json),
                   never synced and never part of a draft. -->
              <Border Classes="divider" />
              <StackPanel x:Name="WeatherOutlookPreference" Classes="settingText" Margin="0,15,0,12">
                <TextBlock Text="PDF Weather Outlook" Classes="fieldLabel" />
                <CheckBox x:Name="IncludeWeatherOutlookByDefault" Content="Include Weather Outlook by default" Margin="0,6,0,0"
                          IsChecked="{Binding WeatherOutlook.IncludeWeatherOutlook}"
                          AutomationProperties.Name="Include Weather Outlook by default"
                          AutomationProperties.HelpText="Include the Weather Outlook in Passdown PDFs when a valid forecast is available. Saved on this computer only; the same setting as Weather Outlook under Include in Passdown." />
                <TextBlock Classes="muted" Text="Include the Weather Outlook in Passdown PDFs when a valid forecast is available." />
                <TextBlock Classes="muted" Text="Saved on this computer only. It is the same setting as Weather Outlook under Include in Passdown." />
                <TextBlock Classes="statusError" TextWrapping="Wrap"
                           Text="{Binding WeatherOutlook.SaveMessage}"
                           IsVisible="{Binding WeatherOutlook.SaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 3. Calendar display (Phase 32): the same device preference the Calendar's own Show Perks box uses
               (CalendarDisplaySettingsViewModel, calendar-display.json), never synced. Hiding the markers deletes nothing. -->
          <Border x:Name="CalendarDisplaySection" Classes="panel" AutomationProperties.Name="Calendar">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Calendar" Classes="sectionTitle" />
                <TextBlock Classes="muted" Text="Control how date-specific reference information appears in the month view." />
              </StackPanel>
              <Border Classes="divider" />
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Classes="settingText">
                  <TextBlock Text="Show Pass Perks on Calendar" Classes="fieldLabel" />
                  <TextBlock Classes="muted"
                             Text="Marks dates with a confirmed qualifying visit, redemption or use window, or booking deadline. Saved on this computer only; it is the same setting as Show Perks on the Calendar. Turning it off hides the markers; the Pass Perks list under Products is unchanged." />
                  <TextBlock Classes="statusError" TextWrapping="Wrap"
                             Text="{Binding CalendarDisplay.SaveMessage}"
                             IsVisible="{Binding CalendarDisplay.SaveMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ToggleSwitch x:Name="ShowPassPerksOnCalendar" Grid.Column="1" VerticalAlignment="Top"
                              IsChecked="{Binding CalendarDisplay.ShowPassPerks}"
                              AutomationProperties.Name="Show Pass Perks on Calendar" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 4. Data Refresh (information only — the schedule is built in and the 6 AM task is set up outside this
               screen, so nothing here implies it can be changed, and opening Settings refreshes nothing). -->
          <Border x:Name="DataRefreshSection" Classes="panel" AutomationProperties.Name="Data refresh">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Data Refresh" Classes="sectionTitle" />
                <TextBlock Classes="muted"
                           Text="Official Carowinds data refreshes automatically. These are the schedules, not settings; opening this page does not check for new data." />
              </StackPanel>
              <Border Classes="divider" />
              <Grid Classes="settingsRows" ColumnDefinitions="175,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="When the app opens" Classes="fieldLabel" />
                <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Classes="muted"
                           Text="Checks official data, unless it was checked within the last hour." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="While it is open" Classes="fieldLabel" />
                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Classes="muted" Text="Checks again every four hours." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Daily at 6 AM" Classes="fieldLabel" />
                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Classes="muted"
                           Text="A Windows scheduled task runs full maintenance, including park hours about 12 months ahead. It is set up with the app's installation scripts, not from this screen." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Past dates" Classes="fieldLabel" />
                <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Classes="muted"
                           Text="Missing park hours from earlier this season are filled in while Carowinds still publishes them." />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status and Check Online" Classes="fieldLabel" />
                <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Classes="muted"
                           Text="When each source was last verified and any stale or unavailable data are shown under Official Data on the Dashboard. Check Online is on the Dashboard and in the Passdown's Actions menu." />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 5. Personal Sync (Phase 16B–16F, 26). Status badges show the coordinator's real state — never a
               connection claim based only on a configured folder. -->
          <Border x:Name="PersonalSyncSection" Classes="panel" AutomationProperties.Name="Personal Sync">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Personal Sync" Classes="sectionTitle" />
                <TextBlock Classes="muted" Text="Optional folder-based synchronization between your own Windows computers." />
              </StackPanel>
              <Border Classes="divider" />

              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Classes="settingText">
                  <TextBlock Text="Enable Personal Sync" Classes="fieldLabel" />
                  <TextBlock Classes="muted"
                             Text="Optional and off by default. Keeps your own Associate drafts, Operational Notes, finalized History, and verified official price history in sync between your own Windows computers through a folder you choose (typically in your personal OneDrive). Work is always saved on this computer first; OneDrive is never required." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" VerticalAlignment="Top"
                              IsChecked="{Binding PersonalSyncEnabled}"
                              IsEnabled="{Binding !IsBusy}"
                              AutomationProperties.Name="Enable Personal Sync" />
              </Grid>
              <Border Classes="divider" />

              <Grid Classes="settingsRows" ColumnDefinitions="175,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected folder" Classes="fieldLabel" />
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                  <Border Classes="folderPath" IsVisible="{Binding SyncRootPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock Text="{Binding SyncRootPath}" TextWrapping="Wrap"
                                         FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                         AutomationProperties.Name="{Binding SyncRootPath, StringFormat='Sync folder: {0}'}" />
                  </Border>
                  <TextBlock Text="No folder chosen yet." Classes="muted"
                             IsVisible="{Binding SyncRootPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{Binding FirstSuggestedRoot, StringFormat='Detected OneDrive folder: {0}'}"
                             IsVisible="{Binding HasSuggestedRoots}" />
                  <Button Content="Choose Folder…" Classes="secondaryAction" HorizontalAlignment="Left"
                          Command="{Binding ChooseFolderCommand}"
                          AutomationProperties.Name="Choose Personal Sync Folder" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder status" Classes="fieldLabel" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <Border Classes="statusBadge" Classes.error="{Binding StatusPresentation.IsProblem}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StatusPresentation.Text}"
                               AutomationProperties.Name="{Binding StatusPresentation.Text, StringFormat='Folder status: {0}'}" />
                  </Border>
                  <TextBlock Text="{Binding StatusDetail}" Classes="muted" TextWrapping="Wrap"
                             IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Phase 16F §12/§13/§17: the automatic-sync status, layered on top of (never replacing) the folder
                     readiness above. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Automatic sync" Classes="fieldLabel" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                  <Border Classes="statusBadge" Classes.error="{Binding AutomationStatusPresentation.IsProblem}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AutomationStatusPresentation.Text}"
                               AutomationProperties.Name="{Binding AutomationStatusPresentation.Text, StringFormat='Automatic sync: {0}'}" />
                  </Border>
                  <TextBlock Text="{Binding AutomationStatusPresentation.DetailText}" TextWrapping="Wrap"
                             Classes="muted" Classes.statusError="{Binding AutomationStatusPresentation.IsProblem}"
                             IsVisible="{Binding AutomationStatusPresentation.DetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding LastSyncedText}" Classes="muted"
                             IsVisible="{Binding LastSyncedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                  <Button Content="Sync Now" Classes="secondaryAction" HorizontalAlignment="Left"
                          Command="{Binding SyncNowCommand}"
                          AutomationProperties.Name="Sync Now" />
                  <TextBlock Text="{Binding SyncResultSummary}" TextWrapping="Wrap"
                             IsVisible="{Binding SyncResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <!-- Phase 26: official price history rides the same folder, no extra setup. -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Data integrity" Classes="fieldLabel" />
                <TextBlock x:Name="OfficialPriceHistoryNote" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Classes="muted"
                           Text="Official price history is merge-only: verified prices from each computer are combined with their original dates, and nothing is ever removed. Computers on an older app version neither send nor receive it." />
              </Grid>

              <!-- Phase 16D §4/§27: the conflict callout — never shown when there is nothing to review. -->
              <Border x:Name="ConflictCallout" Classes="inset" Margin="0,0,0,14" IsVisible="{Binding HasConflicts}"
                      AutomationProperties.Name="Sync conflicts">
                <StackPanel Spacing="8">
                  <Border Classes="statusBadge warning" HorizontalAlignment="Left">
                    <TextBlock Text="Conflict attention needed" />
                  </Border>
                  <TextBlock Text="{Binding ConflictStatusText}" TextWrapping="Wrap" />
                  <Button Content="Review Conflicts" Classes="secondaryAction" HorizontalAlignment="Left"
                          Command="{Binding ReviewConflictsCommand}"
                          AutomationProperties.Name="Review Conflicts" />
                </StackPanel>
              </Border>

              <!-- Phase 22F: the Phase 21C mixed-version caution, made visible. Information only — the app has no
                   built-in safeguard against an older build re-saving a synced draft. -->
              <TextBlock x:Name="MixedVersionNote" Classes="fieldWarning" TextWrapping="Wrap" Margin="0,0,0,18"
                         Text="Use the same app version on every computer that shares this folder. An older version can drop show selections when it re-saves a synced passdown draft." />
            </StackPanel>
          </Border>

          <!-- Phase 16D §4/§5/§6: the conflict list. Selecting a row loads its detail below. -->
          <Border Classes="panel" IsVisible="{Binding IsReviewingConflicts}">
            <StackPanel Spacing="10" Margin="0,0,0,14">
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Conflicts" Classes="sectionTitle" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Conflicts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="conflictRow" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Review" Margin="12,0,0,0"
                                Command="{Binding #PersonalSyncRoot.((vm:PersonalSyncSettingsViewModel)DataContext).OpenConflictCommand}"
                                CommandParameter="{Binding}"
                                Classes="secondaryAction"
                                AutomationProperties.Name="{Binding DisplayLabel, StringFormat='Review conflict: {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Close" Classes="textAction" HorizontalAlignment="Left"
                      Command="{Binding CloseConflictsCommand}"
                      AutomationProperties.Name="Close conflict list" />
            </StackPanel>
          </Border>

          <!-- Phase 16D §5/§6/§7/§8/§15: the focused local-vs-remote comparison and explicit resolution actions. -->
          <Border Classes="panel" IsVisible="{Binding SelectedConflictDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="12" Margin="0,0,0,14">
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Conflict Detail" Classes="sectionTitle" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedConflictDetail.Title}" FontWeight="SemiBold" FontSize="{DynamicResource PassdownFontSizeSubsection}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedConflictDetail.Explanation}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedConflictDetail.RemoteActivityLabel}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedConflictDetail.NewerActivityNote}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding SelectedConflictDetail.NewerActivityNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Field" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="This Device" Classes="columnHeader" />
                <TextBlock Grid.Column="2" Text="Other Device" Classes="columnHeader" />
              </Grid>
              <ItemsControl ItemsSource="{Binding SelectedConflictDetail.Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Classes="fieldComparisonRow" ColumnDefinitions="*,*,*">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Medium" />
                      <TextBlock Grid.Column="1" Text="{Binding LocalValue}" />
                      <TextBlock Grid.Column="2" Text="{Binding RemoteValue}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Phase 31B: Early Ride Time conflicts can be merged/edited into a final ride list. -->
              <StackPanel Spacing="6" IsVisible="{Binding SelectedConflictDetail.CanEditErtRides}">
                <TextBlock Text="Merge or edit rides" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static presentation:ConflictDetailPresentation.ErtEditHelpText}" Classes="muted" TextWrapping="Wrap" />
                <TextBox Text="{Binding EditedErtRidesText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                         AutomationProperties.Name="Final Early Ride Time rides, one per line" />
                <StackPanel Spacing="2" IsVisible="{Binding SelectedConflictDetail.ShowsErtBaseChoice}">
                  <TextBlock Text="Start time, scheduled state and note differ. Keep them from:" Classes="muted" TextWrapping="Wrap" />
                  <RadioButton GroupName="ErtBase" Content="This Device" IsChecked="{Binding ErtBaseIsThisDevice}"
                               AutomationProperties.Name="Keep start time and note from this device" />
                  <RadioButton GroupName="ErtBase" Content="Other Device" IsChecked="{Binding ErtBaseIsOtherDevice}"
                               AutomationProperties.Name="Keep start time and note from the other device" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Save Edited Rides" Classes="secondaryAction" Margin="0,0,10,4"
                          Command="{Binding SaveEditedErtRidesCommand}"
                          AutomationProperties.Name="Save edited Early Ride Time rides" />
                  <Button Content="Reset to Merged List" Classes="textAction" Margin="0,0,10,4"
                          Command="{Binding UseMergedErtRidesCommand}"
                          AutomationProperties.Name="Reset rides to the merged list" />
                </WrapPanel>
              </StackPanel>

              <TextBlock Text="{Binding ConflictActionMessage}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding ConflictActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.LiveSetting="Polite" />

              <WrapPanel Orientation="Horizontal">
                <Button Content="Keep This Device" Classes="secondaryAction" Margin="0,0,10,4"
                        Command="{Binding KeepLocalCommand}"
                        AutomationProperties.Name="Keep This Device" />
                <Button Content="Use Other Device" Classes="secondaryAction" Margin="0,0,10,4"
                        Command="{Binding UseRemoteCommand}"
                        IsVisible="{Binding !SelectedConflictDetail.IsRemoteDeletion}"
                        AutomationProperties.Name="Use Other Device" />
                <Button Content="Accept Deletion" Classes="secondaryAction" Margin="0,0,10,4"
                        Command="{Binding AcceptDeletionCommand}"
                        IsVisible="{Binding SelectedConflictDetail.IsRemoteDeletion}"
                        AutomationProperties.Name="Accept Deletion" />
                <Button Content="Cancel" Classes="textAction" Margin="0,0,0,4"
                        Command="{Binding CloseConflictDetailCommand}"
                        AutomationProperties.Name="Cancel conflict review" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- 6. Diagnostics. Phase 21B: Export Diagnostics lives here (an administrative/support action). Same export
               service, privacy filtering, ZIP format and save picker as before. -->
          <Border x:Name="DiagnosticsSection" Classes="panel" AutomationProperties.Name="Diagnostics">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Diagnostics" Classes="sectionTitle" />
                <TextBlock Classes="muted" Text="Technical information for troubleshooting, kept here rather than on operational screens." />
              </StackPanel>
              <Border Classes="divider" />
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Classes="settingText">
                  <TextBlock Text="Support file" Classes="fieldLabel" />
                  <TextBlock Classes="muted"
                             Text="Creates a support file with the app version, data-source status, and recent log information. It never includes notes, the Daily Feature, drafts, sync data, PDFs, or the database." />
                  <TextBlock Text="{Binding Diagnostics.DiagnosticsExportMessage}" TextWrapping="Wrap"
                             Classes.statusSuccess="{Binding !Diagnostics.IsDiagnosticsExportProblem}"
                             Classes.statusError="{Binding Diagnostics.IsDiagnosticsExportProblem}"
                             IsVisible="{Binding Diagnostics.DiagnosticsExportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button Grid.Column="1" Content="Export Diagnostics…" Classes="secondaryAction" VerticalAlignment="Top"
                        Command="{Binding Diagnostics.ExportDiagnosticsCommand}"
                        AutomationProperties.Name="Export Diagnostics"
                        AutomationProperties.HelpText="Saves a support diagnostic ZIP with version, source status, and recent log information. Contains no drafts or personal data." />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 7. Application Updates (Phase 23D). Approved updates come from GitHub Releases, verified against the signing
               key bundled in this build. Nothing downloads or installs without a button press; Restart and Install saves
               the Passdown draft first (Phase 23A) and never closes the app if that save fails. In a build without a
               trusted signing key this says "Manual update required" and never contacts GitHub. -->
          <Border x:Name="ApplicationUpdatesSection" Classes="panel" AutomationProperties.Name="Application Updates">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="Application Updates" Classes="sectionTitle" />
                <TextBlock Classes="muted" Text="Signed releases only. Nothing is downloaded or installed until you choose to." />
              </StackPanel>
              <Border Classes="divider" />
              <StackPanel Spacing="10" Margin="0,0,0,16">
                <Grid Classes="settingsRows" ColumnDefinitions="175,*" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Installed version" Classes="fieldLabel" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Updates.InstalledVersionText}" FontWeight="Medium" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding Updates.InstalledVersionText, StringFormat='Installed version: {0}'}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" Classes="fieldLabel" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="UpdateStatusTitle" Text="{Binding Updates.StatusTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Updates.StatusDetail}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding Updates.StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding Updates.LastCheckedText}" Classes="muted"
                               IsVisible="{Binding !Updates.IsManualUpdateRequired}" />
                  </StackPanel>
                </Grid>

                <!-- Update available / downloading / ready: the signed release's own details and notes. -->
                <Border x:Name="UpdateOfferPanel" Classes="inset"
                        IsVisible="{Binding Updates.AvailableVersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        AutomationProperties.Name="Available update">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Updates.ReleaseTitle}" Classes="subsectionTitle" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Updates.ReleasedText}" Classes="muted" Margin="0,0,16,0"
                                 IsVisible="{Binding Updates.ReleasedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding Updates.DownloadSizeText}" Classes="muted" />
                    </WrapPanel>
                    <!-- No nested ScrollViewer: the Settings page is the one scroll region (Phase 22F). Notes are bounded
                         (ReleaseNotesDocument limits) and scroll with the page. -->
                    <ItemsControl ItemsSource="{Binding Updates.ReleaseNotesBlocks}"
                                  AutomationProperties.Name="Release notes for the available update">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="updates:ReleaseNotesBlock">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="•" Margin="4,0,8,0" IsVisible="{Binding IsBullet}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                       FontWeight="{Binding IsHeading, Converter={x:Static converters:ReleaseNotesConverters.HeadingWeight}}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="UpdateReadinessText" Classes="fieldWarning" TextWrapping="Wrap"
                           Text="{Binding Updates.ReadinessText}"
                           IsVisible="{Binding Updates.ReadinessText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Downloading: progress announced politely to screen readers through the text below the bar. -->
                <StackPanel Spacing="4" IsVisible="{Binding Updates.IsDownloading}">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.DownloadPercent}" Height="6"
                               AutomationProperties.Name="Update download progress" />
                  <TextBlock Text="{Binding Updates.ProgressText}" Classes="muted" TextWrapping="Wrap"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <TextBlock Text="{Binding Updates.ErrorText}" Classes="statusError" TextWrapping="Wrap"
                           IsVisible="{Binding Updates.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{Binding Updates.InfoText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding Updates.InfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Updates.PreviousAttemptText}" Classes="fieldWarning" TextWrapping="Wrap"
                           IsVisible="{Binding Updates.PreviousAttemptText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <WrapPanel Orientation="Horizontal">
                  <Button Content="Check for Updates" Classes="secondaryAction" Margin="0,0,10,4"
                          Command="{Binding Updates.CheckForUpdatesCommand}"
                          IsVisible="{Binding Updates.ShowCheckButton}"
                          AutomationProperties.Name="Check for Updates" />
                  <Button Content="Install Update" Classes="primaryAction" Margin="0,0,10,4"
                          Command="{Binding Updates.InstallUpdateCommand}"
                          IsVisible="{Binding Updates.IsUpdateAvailable}"
                          AutomationProperties.Name="Install Update"
                          AutomationProperties.HelpText="Downloads and verifies the update. Nothing is installed until you choose Restart and Install." />
                  <Button Content="Remind Me Later" Classes="textAction" Margin="0,0,10,4"
                          Command="{Binding Updates.RemindMeLaterCommand}"
                          IsVisible="{Binding Updates.IsUpdateAvailable}"
                          AutomationProperties.Name="Remind Me Later" />
                  <Button Content="Cancel Download" Classes="secondaryAction" Margin="0,0,10,4"
                          Command="{Binding Updates.CancelDownloadCommand}"
                          IsVisible="{Binding Updates.IsDownloading}"
                          AutomationProperties.Name="Cancel Download" />
                  <Button Content="Restart and Install" Classes="primaryAction" Margin="0,0,10,4"
                          Command="{Binding Updates.RestartAndInstallCommand}"
                          IsVisible="{Binding Updates.IsReadyToInstall}"
                          AutomationProperties.Name="Restart and Install"
                          AutomationProperties.HelpText="Saves your work, closes Carowinds Operations, installs the update and opens the app again." />
                  <Button Content="Not Now" Classes="textAction" Margin="0,0,10,4"
                          Command="{Binding Updates.NotNowCommand}"
                          IsVisible="{Binding Updates.IsReadyToInstall}"
                          AutomationProperties.Name="Not now, install later" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 8. About. Phase 18D: identifies the exact running build (docs/support-troubleshooting.md "Which copy is
               running?") — compare the folder with the current release folder to spot a stale copy. -->
          <Border x:Name="AboutSection" Classes="panel" AutomationProperties.Name="About this build">
            <StackPanel>
              <StackPanel Classes="groupHeader">
                <TextBlock Text="About this build" Classes="sectionTitle" />
                <TextBlock Classes="muted" Text="Identifies the exact copy of the app that is running." />
              </StackPanel>
              <Border Classes="divider" />
              <Grid Classes="settingsRows" ColumnDefinitions="175,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="App" Classes="fieldLabel" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BuildProductName}" FontWeight="Medium"
                           AutomationProperties.Name="{Binding BuildProductName, StringFormat='App: {0}'}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Classes="fieldLabel" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildVersionText}" FontWeight="Medium" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding BuildVersionText, StringFormat='Version: {0}'}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Running from" Classes="fieldLabel" />
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildExecutablePathText}" TextWrapping="Wrap"
                                     FontFamily="Consolas,Menlo,monospace" FontSize="12.5"
                                     AutomationProperties.Name="{Binding BuildExecutablePathText, StringFormat='Running from: {0}'}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" TextWrapping="Wrap"
                           Text="If this folder is not the release folder you extracted most recently, Windows opened an older copy." />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Device ID" Classes="fieldLabel" />
                <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeviceId}" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding DeviceId, StringFormat='Device ID: {0}'}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Classes="muted" TextWrapping="Wrap"
                           Text="Used only to tell your own computers' changes apart during Personal Sync. Never shown to anyone else and never based on your name, email, or computer." />
                <!-- Phase 23D: the running version's release notes, bundled in the app (works offline). -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Release notes" Classes="fieldLabel" />
                <Button x:Name="WhatsNewButton" Grid.Row="6" Grid.Column="1" Content="What's New" Classes="secondaryAction"
                        HorizontalAlignment="Left" Command="{Binding Updates.ShowWhatsNewCommand}"
                        AutomationProperties.Name="What's New in this version" />
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>

</UserControl>
