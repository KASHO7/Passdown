<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:converters="using:Carowinds.Passdown.Desktop.Converters"
             xmlns:finalization="using:Carowinds.Passdown.Application.Finalization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.HistoryView"
             x:DataType="vm:PassdownHistoryViewModel">

  <!-- Phase 9D: a read-only History screen. Shared typography, surface, button and status styles
       come from Themes/PassdownStyles.axaml (Phase 22A); only this screen's own deltas live below. -->
  <UserControl.Styles>
    <!-- History rows (spec Part W: keyboard selectable, visible focus states) — ListBox already
         provides arrow-key navigation and a focus ring via FluentTheme; hover/selected backgrounds
         come from the shared ListBox.selectableRows style. -->
    <!-- Phase 22E: two-line divided rows (date; finalized · origin) with a compact PDF tag — no chips. -->
    <Style Selector="ListBox.historyList ListBoxItem">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
    </Style>
    <Style Selector="TextBlock.pdfTag">
      <Setter Property="FontSize" Value="{DynamicResource PassdownFontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.pdfTag.missing">
      <Setter Property="Foreground" Value="{DynamicResource PassdownStaleBrush}" />
    </Style>
    <!-- Phase 22E: one summary panel holds the four small snapshot groups (Park Hours, Attendance,
         Daily Feature, Early Ride) instead of four separate cards. -->
    <Style Selector="StackPanel.historyGroup">
      <Setter Property="Spacing" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <StackPanel Spacing="2">
        <TextBlock Text="Passdown History" Classes="pageTitle" />
        <TextBlock Text="Finalized passdowns, newest first. This screen is read-only — it never changes finalized history."
                   Classes="muted" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,*">

      <!-- List column (spec Part B/L): metadata-only rows; selecting one loads its detail on demand. -->
      <Border Grid.Column="0" Background="{DynamicResource PassdownSurfaceBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PassdownDividerBrush}">
        <Grid RowDefinitions="Auto,*">

          <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoadingList}" />

          <TextBlock Grid.Row="1" Text="{Binding ListErrorMessage}" Classes="fieldError"
                     Margin="16" TextWrapping="Wrap"
                     IsVisible="{Binding ListErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Grid.Row="1" Margin="16" Spacing="4" IsVisible="{Binding ShowEmptyState}">
            <TextBlock Text="No finalized passdowns yet." FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Passdowns are automatically finalized after their operating date once the 6:00 AM finalization cutoff has passed." />
          </StackPanel>

          <ListBox Grid.Row="1" Classes="selectableRows historyList" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedItem}"
                   Background="Transparent" BorderThickness="0"
                   IsVisible="{Binding HasHistory}"
                   AutomationProperties.Name="Finalized passdown history">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="presentation:PassdownHistorySummaryPresentation">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" AutomationProperties.Name="{Binding AccessibleSummary}">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ListTitleText}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PdfTagText}" Classes="pdfTag" Classes.missing="{Binding !HasFrozenPdf}"
                             Margin="8,1,0,0" VerticalAlignment="Top" ToolTip.Tip="{Binding PdfAvailabilityText}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ListDetailText}" Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </Grid>
      </Border>

      <!-- Detail column (spec Part C/D/F): resolved entirely from the frozen snapshot, never from
           any current Associate draft or catalog table. Phase 22E: presentation only — the header now
           carries the PDF actions, and the small snapshot groups share one panel. Every pre-22E field
           and binding is still shown; nothing is regenerated, re-resolved or written. -->
      <ScrollViewer Grid.Column="1" Padding="24,20,24,24">

        <StackPanel Spacing="16">

          <!-- Phase 22E: only when there is something to select — the list's own empty state covers "no records". -->
          <TextBlock Text="Select a finalized passdown from the list to view its details." Classes="muted">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!HasSelection" />
                <Binding Path="HasHistory" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>

          <StackPanel Spacing="16" IsVisible="{Binding HasSelection}">

            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoadingDetail}" />

            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="{Binding SelectedItem.PassdownDateText}" Classes="pageTitle" />
                  <TextBlock Text="{Binding SelectedItem.FinalizedText}" Classes="muted" />
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Border Classes="chip">
                      <TextBlock Text="{Binding SelectedItem.OriginText}" />
                    </Border>
                    <Border Classes="chip">
                      <TextBlock Text="{Binding SelectedItem.PdfAvailabilityText}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Classes="readOnlyBadge" VerticalAlignment="Top">
                  <TextBlock Text="Finalized — Read Only" />
                </Border>
              </Grid>

              <!-- PDF actions (spec Part I/J/H): visible whenever a record is selected, regardless of
                   whether its structured snapshot could be read — a pre-9C/unsupported-schema row can
                   still offer its frozen PDF. Phase 22E: moved up beside the record identity (the screen's
                   one primary action is opening the exact frozen PDF); the stored bytes are served as-is. -->
              <WrapPanel Orientation="Horizontal">
                <Button Content="Open Final PDF" Classes="primaryAction" Margin="0,0,10,0"
                        Command="{Binding OpenFinalPdfCommand}"
                        IsVisible="{Binding SelectedDetail.Summary.HasFrozenPdf, FallbackValue=False}"
                        AutomationProperties.Name="Open Final PDF"
                        AutomationProperties.HelpText="Opens the exact frozen PDF stored for this finalized passdown in your default PDF viewer." />
                <Button Content="Save PDF Copy" Classes="secondaryAction" Margin="0,0,10,0"
                        Command="{Binding SavePdfCopyCommand}"
                        IsVisible="{Binding SelectedDetail.Summary.HasFrozenPdf, FallbackValue=False}"
                        AutomationProperties.Name="Save PDF Copy"
                        AutomationProperties.HelpText="Saves a copy of the exact frozen PDF stored for this finalized passdown." />
                <TextBlock Text="Exact historical PDF unavailable" Classes="muted" VerticalAlignment="Center"
                           IsVisible="{Binding !SelectedDetail.Summary.HasFrozenPdf, FallbackValue=False}" />
              </WrapPanel>
              <TextBlock Text="{Binding PdfActionMessage}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding PdfActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <TextBlock Text="{Binding DetailErrorMessage}" Classes="fieldError" TextWrapping="Wrap"
                       IsVisible="{Binding DetailErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="16" IsVisible="{Binding HasSnapshot}">

              <Border Classes="panel" AutomationProperties.Name="Finalized summary">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="16">

                  <StackPanel Grid.Row="0" Grid.Column="0" Classes="historyGroup">
                    <TextBlock Text="PARK HOURS" Classes="subsectionTitle" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.HeadlineText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    <Border Classes="chip" HorizontalAlignment="Left" Margin="0,2"
                            IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.BadgeText}" />
                    </Border>
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.NorthGateText}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.NorthGateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.AvenueText}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.AvenueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.VerificationText}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.PrivateBuyoutDetails}" Classes="fieldWarning" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.PrivateBuyoutDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <StackPanel Grid.Row="0" Grid.Column="1" Classes="historyGroup">
                    <TextBlock Text="ATTENDANCE" Classes="subsectionTitle" Margin="0,0,0,2" />
                    <!-- Phase 22D: grouped counts ("38,500") rendered from the stored integer; the snapshot is unchanged. -->
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.Attendance.ProjectedAttendance, Converter={x:Static converters:OperationalCountTextConverter.Instance}, ConverterParameter='Projected attendance'}" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.Attendance.PreSolds, Converter={x:Static converters:OperationalCountTextConverter.Instance}, ConverterParameter='Pre-solds'}" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="0" Classes="historyGroup">
                    <TextBlock Text="DAILY FEATURE" Classes="subsectionTitle" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.DailyFeature.TypeLabel}"
                               IsVisible="{Binding SelectedDetail.Snapshot.DailyFeature.TypeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.DailyFeature.Text}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.DailyFeature.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="Not set for this date." Classes="muted"
                               IsVisible="{Binding SelectedDetail.Snapshot.DailyFeature.Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="1" Classes="historyGroup">
                    <TextBlock Text="EARLY RIDE TIME" Classes="subsectionTitle" Margin="0,0,0,2" />
                    <TextBlock Text="Not applicable for this date." Classes="muted"
                               IsVisible="{Binding !SelectedDetail.Snapshot.EarlyRideTime.Enabled}" />
                    <StackPanel Spacing="2" IsVisible="{Binding SelectedDetail.Snapshot.EarlyRideTime.Enabled}">
                      <!-- Phase 17B: StartTimeText only exists on a snapshot finalized under the new
                           resolver-driven model (null for a pre-17B row) — additive only, so an older
                           finalized snapshot keeps displaying exactly as it always has via Details/
                           ParticipatingAttractions below. -->
                      <TextBlock Text="{Binding SelectedDetail.Snapshot.EarlyRideTime.StartTimeText, StringFormat='Start: {0}'}"
                                 FontWeight="Medium"
                                 IsVisible="{Binding SelectedDetail.Snapshot.EarlyRideTime.StartTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding SelectedDetail.Snapshot.EarlyRideTime.Details}" TextWrapping="Wrap"
                                 IsVisible="{Binding SelectedDetail.Snapshot.EarlyRideTime.Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.EarlyRideTime.ParticipatingAttractions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="muted" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                </Grid>
              </Border>

              <TextBlock Classes="fieldWarning" TextWrapping="Wrap" IsVisible="{Binding SelectedDetail.Snapshot.HasUnverifiedProductPricing}"
                         Text="Pricing shown below was not recently verified as of finalization time." />

              <!-- Products: the frozen price text exactly as finalized ("$49.99", "From $40.00") — one panel,
                   one category band per section, never re-priced. -->
              <Border Classes="panel" AutomationProperties.Name="Products (as finalized)">
                <StackPanel Spacing="6">
                  <TextBlock Text="Products" Classes="sectionTitle" Margin="0" />
                  <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.ProductCategories}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="finalization:FinalizedProductCategorySnapshot">
                        <StackPanel Spacing="2">
                          <Border Classes="categoryBand">
                            <TextBlock Text="{Binding CategoryName}" />
                          </Border>

                          <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="finalization:FinalizedProductRowSnapshot">
                                <Border Classes="productRow">
                                  <Grid ColumnDefinitions="*,200">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Qualifier}" Classes="muted" FontStyle="Italic"
                                                 IsVisible="{Binding Qualifier, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                      <TextBlock Text="{Binding Notes}" Classes="muted" TextWrapping="Wrap"
                                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                      <TextBlock Text="{Binding EffectivePriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                      <TextBlock Text="{Binding ComparisonPriceText, StringFormat='was {0}'}"
                                                 IsVisible="{Binding ComparisonPriceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Foreground="{DynamicResource PassdownTextMutedBrush}" FontSize="12.5"
                                                 HorizontalAlignment="Right" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Phase 21C: the shows this passdown printed, frozen at finalization (absent for passdowns
                   without a Shows section and for every pre-21C row). -->
              <Border Classes="panel" IsVisible="{Binding SelectedDetail.Snapshot.Shows, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                      AutomationProperties.Name="Shows (as finalized)">
                <StackPanel Spacing="6">
                  <TextBlock Text="Shows" Classes="sectionTitle" Margin="0" />
                  <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.Shows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="finalization:FinalizedShowSnapshot">
                        <StackPanel Spacing="0" Margin="0,0,0,6">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding TimesText}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Venue}" Classes="muted" TextWrapping="Wrap"
                                     IsVisible="{Binding Venue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="6">
                  <TextBlock Text="Operational Notes" Classes="sectionTitle" Margin="0" />
                  <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.OperationalNotes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Phase 22E: an empty frozen list says so instead of leaving a bare heading. -->
                  <TextBlock Text="No operational notes were recorded." Classes="muted"
                             IsVisible="{Binding !SelectedDetail.Snapshot.OperationalNotes.Count, FallbackValue=False}" />
                </StackPanel>
              </Border>

            </StackPanel>

          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>

</UserControl>
