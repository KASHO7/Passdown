<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Carowinds.Passdown.Desktop.ViewModels"
             xmlns:presentation="using:Carowinds.Passdown.Desktop.Presentation"
             xmlns:finalization="using:Carowinds.Passdown.Application.Finalization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
             x:Class="Carowinds.Passdown.Desktop.Views.HistoryView"
             x:DataType="vm:PassdownHistoryViewModel">

  <!-- Phase 9D: a read-only History screen. Every style class below is intentionally a small,
       self-contained subset mirroring AssociateView's own (Avalonia Styles declared inside one
       UserControl are scoped to that UserControl's visual tree, so this view keeps the same visual
       language — spec Part V — without pulling AssociateView's edit-oriented styles like railItem's
       ToggleButton chrome or the TextBox-focused field classes into a screen that has no editable
       controls at all). -->
  <UserControl.Styles>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.fieldWarning">
      <Setter Property="Foreground" Value="{DynamicResource PassdownWarningBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.fieldError">
      <Setter Property="Foreground" Value="{DynamicResource PassdownErrorBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource PassdownSurfaceTintBrush}" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource PassdownChipBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- The "Finalized — Read Only" badge (spec Part E): visually distinct from the neutral
         Scheduled/Recovery/PDF-availability chips so it reads as a status statement, not metadata. -->
    <Style Selector="Border.readOnlyBadge">
      <Setter Property="Background" Value="{DynamicResource PassdownChipAccentBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.readOnlyBadge TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownChipAccentForegroundBrush}" />
    </Style>

    <Style Selector="Border.categoryBand">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.categoryBand TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
    </Style>

    <Style Selector="Border.productRow">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownDividerBrush}" />
      <Setter Property="Padding" Value="0,6" />
    </Style>

    <Style Selector="Button.secondaryAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{DynamicResource PassdownAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.secondaryAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
    </Style>

    <!-- History rows (spec Part W: keyboard selectable, visible focus states) — ListBox already
         provides arrow-key navigation and a focus ring via FluentTheme; only its selected/hover
         backgrounds are re-themed to match the brand palette instead of the default accent. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PassdownBandBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource PassdownSurfaceTintBrush}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PassdownDividerBrush}">
      <StackPanel Spacing="2">
        <TextBlock Text="Passdown History" Classes="pageTitle" />
        <TextBlock Text="Finalized passdowns, newest first. This screen is read-only — it never changes finalized history."
                   Classes="muted" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,*">

      <!-- List column (spec Part B/L): metadata-only rows; selecting one loads its detail on demand. -->
      <Border Grid.Column="0" Background="{DynamicResource PassdownSurfaceTintBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PassdownDividerBrush}">
        <Grid RowDefinitions="Auto,*">

          <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoadingList}" />

          <TextBlock Grid.Row="1" Text="{Binding ListErrorMessage}" Classes="fieldError"
                     Margin="16" TextWrapping="Wrap"
                     IsVisible="{Binding ListErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Grid.Row="1" Margin="18" Spacing="6" IsVisible="{Binding ShowEmptyState}">
            <TextBlock Text="No finalized passdowns yet." FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Passdowns are automatically finalized after their operating date once the 6:00 AM finalization cutoff has passed." />
          </StackPanel>

          <ListBox Grid.Row="1" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedItem}"
                   Background="Transparent" BorderThickness="0"
                   IsVisible="{Binding HasHistory}"
                   AutomationProperties.Name="Finalized passdown history">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="presentation:PassdownHistorySummaryPresentation">
                <StackPanel Spacing="3" AutomationProperties.Name="{Binding PassdownDateText}">
                  <TextBlock Text="{Binding PassdownDateText}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FinalizedText}" Classes="muted" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip">
                      <TextBlock Text="{Binding OriginText}" />
                    </Border>
                    <Border Classes="chip">
                      <TextBlock Text="{Binding PdfAvailabilityText}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </Grid>
      </Border>

      <!-- Detail column (spec Part C/D/F): resolved entirely from the frozen snapshot, never from
           any current Associate draft or catalog table. -->
      <ScrollViewer Grid.Column="1" Padding="24,20,24,24">

        <StackPanel Spacing="16">

          <TextBlock Text="Select a finalized passdown from the list to view its details."
                     Classes="muted" IsVisible="{Binding !HasSelection}" />

          <StackPanel Spacing="16" IsVisible="{Binding HasSelection}">

            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoadingDetail}" />

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding SelectedItem.PassdownDateText}" Classes="pageTitle" />
                <TextBlock Text="{Binding SelectedItem.FinalizedText}" Classes="muted" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                  <Border Classes="chip">
                    <TextBlock Text="{Binding SelectedItem.OriginText}" />
                  </Border>
                  <Border Classes="chip">
                    <TextBlock Text="{Binding SelectedItem.PdfAvailabilityText}" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Classes="readOnlyBadge" VerticalAlignment="Top">
                <TextBlock Text="Finalized — Read Only" />
              </Border>
            </Grid>

            <TextBlock Text="{Binding DetailErrorMessage}" Classes="fieldError" TextWrapping="Wrap"
                       IsVisible="{Binding DetailErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="16" IsVisible="{Binding HasSnapshot}">

              <Border Classes="panel">
                <StackPanel Spacing="4">
                  <TextBlock Text="Park Hours" Classes="sectionTitle" />
                  <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.HeadlineText}" FontSize="18" FontWeight="Bold" />
                  <Border Classes="chip" HorizontalAlignment="Left"
                          IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.BadgeText}" />
                  </Border>
                  <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.NorthGateText}" Classes="muted"
                             IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.NorthGateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.AvenueText}" Classes="muted"
                             IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.AvenueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.VerificationText}" Classes="muted"
                             IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.VerificationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding SelectedDetail.Snapshot.ParkHours.PrivateBuyoutDetails}" Classes="fieldWarning"
                             IsVisible="{Binding SelectedDetail.Snapshot.ParkHours.PrivateBuyoutDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="panel">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Attendance" Classes="sectionTitle" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.Attendance.ProjectedAttendance, StringFormat='Projected attendance: {0}', TargetNullValue='Projected attendance: not recorded'}" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.Attendance.PreSolds, StringFormat='Pre-solds: {0}', TargetNullValue='Pre-solds: not recorded'}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="panel">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Daily Feature" Classes="sectionTitle" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.DailyFeature.TypeLabel}"
                               IsVisible="{Binding SelectedDetail.Snapshot.DailyFeature.TypeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.DailyFeature.Text}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.DailyFeature.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="Not set for this date." Classes="muted"
                               IsVisible="{Binding SelectedDetail.Snapshot.DailyFeature.Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="panel">
                <StackPanel Spacing="4">
                  <TextBlock Text="Early Ride Time" Classes="sectionTitle" />
                  <TextBlock Text="Not applicable for this date." Classes="muted"
                             IsVisible="{Binding !SelectedDetail.Snapshot.EarlyRideTime.Enabled}" />
                  <StackPanel Spacing="4" IsVisible="{Binding SelectedDetail.Snapshot.EarlyRideTime.Enabled}">
                    <TextBlock Text="{Binding SelectedDetail.Snapshot.EarlyRideTime.Details}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedDetail.Snapshot.EarlyRideTime.Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.EarlyRideTime.ParticipatingAttractions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="muted" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" IsVisible="{Binding SelectedDetail.Snapshot.HasUnverifiedProductPricing}">
                <TextBlock Classes="fieldWarning"
                           Text="Pricing shown below was not recently verified as of finalization time." />
              </Border>

              <StackPanel Spacing="16">
                <TextBlock Text="Products" Classes="sectionTitle" Margin="0" />
                <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.ProductCategories}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="finalization:FinalizedProductCategorySnapshot">
                      <Border Classes="panel">
                        <StackPanel Spacing="2">
                          <Border Classes="categoryBand">
                            <TextBlock Text="{Binding CategoryName}" />
                          </Border>

                          <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="finalization:FinalizedProductRowSnapshot">
                                <Border Classes="productRow">
                                  <Grid ColumnDefinitions="*,200">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Qualifier}" Classes="muted" FontStyle="Italic"
                                                 IsVisible="{Binding Qualifier, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                      <TextBlock Text="{Binding Notes}" Classes="muted" TextWrapping="Wrap"
                                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                      <TextBlock Text="{Binding EffectivePriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                      <TextBlock Text="{Binding ComparisonPriceText, StringFormat='was {0}'}"
                                                 IsVisible="{Binding ComparisonPriceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Foreground="{DynamicResource PassdownComparePriceBrush}" FontSize="12.5"
                                                 HorizontalAlignment="Right" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border Classes="panel">
                <StackPanel Spacing="6">
                  <TextBlock Text="Operational Notes" Classes="sectionTitle" Margin="0" />
                  <ItemsControl ItemsSource="{Binding SelectedDetail.Snapshot.OperationalNotes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

            </StackPanel>

            <!-- PDF actions (spec Part I/J/H): visible whenever a record is selected, regardless of
                 whether its structured snapshot could be read — a pre-9C/unsupported-schema row can
                 still offer its frozen PDF. -->
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Open Final PDF" Classes="secondaryAction"
                        Command="{Binding OpenFinalPdfCommand}"
                        IsVisible="{Binding SelectedDetail.Summary.HasFrozenPdf}"
                        AutomationProperties.Name="Open Final PDF"
                        AutomationProperties.HelpText="Opens the exact frozen PDF stored for this finalized passdown in your default PDF viewer." />
                <Button Content="Save PDF Copy" Classes="secondaryAction"
                        Command="{Binding SavePdfCopyCommand}"
                        IsVisible="{Binding SelectedDetail.Summary.HasFrozenPdf}"
                        AutomationProperties.Name="Save PDF Copy"
                        AutomationProperties.HelpText="Saves a copy of the exact frozen PDF stored for this finalized passdown." />
                <TextBlock Text="Exact historical PDF unavailable" Classes="muted" VerticalAlignment="Center"
                           IsVisible="{Binding !SelectedDetail.Summary.HasFrozenPdf}" />
              </StackPanel>
              <TextBlock Text="{Binding PdfActionMessage}" Classes="muted"
                         IsVisible="{Binding PdfActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>

</UserControl>
