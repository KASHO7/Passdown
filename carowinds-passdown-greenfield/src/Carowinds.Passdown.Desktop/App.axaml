<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Carowinds.Passdown.Desktop.App"
             xmlns:local="using:Carowinds.Passdown.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Phase 22A: every shared color/typography/spacing/radius token lives in
         Themes/PassdownTokens.axaml and every shared class style in Themes/PassdownStyles.axaml
         (see docs/phase22a-design-foundation.md). Views reference them by key/class only. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Carowinds.Passdown.Desktop/Themes/PassdownTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Carowinds.Passdown.Desktop/Themes/PassdownStyles.axaml" />
    </Application.Styles>
</Application>
