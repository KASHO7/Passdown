<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Phase 13G: the approved app icon, embedded into the published .exe's icon resource (Windows
         Explorer/taskbar) and reused as the Avalonia window icon (Views/MainWindow.axaml). One
         canonical source asset (Assets/logo.ico), not a separate icon per surface. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Phase 7A release publish target: win-x64, self-contained, normal (non-single-file) publish
    directory. PublishSingleFile/PublishTrimmed/PublishAot are deliberately left at their SDK
    defaults (all false) rather than set explicitly here — Avalonia's reflection-based XAML
    loading, plus native SkiaSharp/HarfBuzzSharp/e_sqlite3 dependencies, make trimming/AOT a real
    correctness risk for no proven benefit, and a normal publish directory is easier to
    troubleshoot on a nontechnical user's machine. See docs/release-strategy.md for the full
    rationale and the exact publish command (packaging/windows/Publish-Windows.ps1).

    Phase 15D: PublishReadyToRun=true is set unconditionally but only takes effect when publishing
    with a RuntimeIdentifier (dotnet build/test/run are unaffected — confirmed no RID is set for
    any of those). Unlike PublishTrimmed/PublishAot, R2R keeps full IL/metadata and reflection
    working exactly as today (it only adds pre-JITted native code alongside the IL as a fast path,
    with normal JIT as the fallback) — it does not carry the trimming risk the paragraph above
    documents. This targets a real, measured cause of "packaged EXE feels slow to open": a
    self-contained, non-R2R publish must JIT Avalonia/Skia/HarfBuzz/the app's own assemblies from
    IL on every cold start, before any composition-root/DB work (which Phase 13A/15D profiling
    both measured at low-single-digit milliseconds) even begins. Verified in this environment: a
    self-contained win-x64 publish with this flag set succeeds (the win-x64 crossgen2
    cross-compilation tool pack restores via NuGet from a non-Windows host) and produces valid
    win-x64 assemblies (~7% larger publish output — Desktop.dll 3.3MB vs 2.2MB unmodified). Actual
    wall-clock time-to-first-window improvement on Windows is NOT verified in this environment (no
    Windows host available) — see docs/phase13-hardening.md's Phase 15D
    section for the full measurement/reasoning and the 15F Windows validation item this leaves
    behind.
  -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Phase 18C (PKG-001 follow-up, found by Test-ReleasePackage.ps1 on the real release build):
    Directory.Build.props' Release PathMap does not reach this assembly. Avalonia's XAML compiler
    (CompileAvaloniaXamlTask) rewrites Carowinds.Passdown.Desktop.dll after csc and records the
    absolute obj/.../Carowinds.Passdown.Desktop.pdb path in the PE debug directory, which leaked
    the build machine's user name and checkout path into the shipped exe's main assembly. Release
    builds of this project therefore emit no debug symbols at all. Nothing is lost for users:
    .pdb files have never shipped (Publish-Windows.ps1 deletes them). Debug builds are unchanged.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Phase 15F: embedded resource rather than a physical Content file copied next to the .exe.
    App.axaml.cs.BuildServiceProvider reads it via Assembly.GetManifestResourceStream, which works
    identically for dotnet build/test/run, the existing multi-file publish, and a true single-file
    publish — a physical-file lookup via AppContext.BaseDirectory would silently miss the file for a
    single-file publish that bundles content via IncludeAllContentForSelfExtract (files are
    extracted to a %TEMP%/.net staging directory, not the directory AppContext.BaseDirectory
    resolves to for the executable itself — see docs/release-strategy.md "Single-file publish").
    Since Storage/Logging are the only two settings this file carries and neither is
    secret/machine-specific, embedding is a strict robustness improvement with no configurability
    lost - it's still an editable JSON file, just compiled into the DLL instead of copied loose.
  -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Carowinds.Passdown.Application\Carowinds.Passdown.Application.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Infrastructure\Carowinds.Passdown.Infrastructure.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Documents\Carowinds.Passdown.Documents.csproj" />
  </ItemGroup>

  <!--
    Phase 15F: Carowinds.Passdown.Documents.csproj now embeds QuestPDF's "Lato" font files as
    resources instead of relying on QuestPDF's own physical-directory auto-discovery (see that
    project's comment), but QuestPDF's buildTransitive/QuestPDF.targets still unconditionally adds
    the original loose *.ttf files as CopyToOutputDirectory content — they're transitively pulled
    into this project's publish output via the Documents ProjectReference regardless, since a
    same-project exclusion in Documents.csproj can't reach items resolved this late in a
    cross-project publish. Filtering the final ResolvedFileToPublish list here (the one place that's
    authoritative for what actually gets copied, no matter which project or package originated an
    item) is what makes this project's publish output — multi-file and single-file alike — not ship
    a now-fully-redundant duplicate of font bytes that already live inside Carowinds.Passdown.Documents.dll.
    OFL.txt (the font's license notice) is deliberately kept - it's not font content, just a
    required third-party attribution file, and Compress/Publish scripts already expect to find and
    ship it.
  -->
  <Target Name="RemoveRedundantLatoFontTtfFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.ttf' and $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('LatoFont'))" />
    </ItemGroup>
  </Target>
</Project>
