<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Phase 13G: the approved app icon, embedded into the published .exe's icon resource (Windows
         Explorer/taskbar) and reused as the Avalonia window icon (Views/MainWindow.axaml). One
         canonical source asset (Assets/logo.ico), not a separate icon per surface. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Phase 7A release publish target: win-x64, self-contained, normal (non-single-file) publish
    directory. PublishSingleFile/PublishTrimmed/PublishAot are deliberately left at their SDK
    defaults (all false) rather than set explicitly here — Avalonia's reflection-based XAML
    loading, plus native SkiaSharp/HarfBuzzSharp/e_sqlite3 dependencies, make trimming/AOT a real
    correctness risk for no proven benefit, and a normal publish directory is easier to
    troubleshoot on a nontechnical user's machine. See docs/release-strategy.md for the full
    rationale and the exact publish command (packaging/windows/Publish-Windows.ps1).

    Phase 15D: PublishReadyToRun=true is set unconditionally but only takes effect when publishing
    with a RuntimeIdentifier (dotnet build/test/run are unaffected — confirmed no RID is set for
    any of those). Unlike PublishTrimmed/PublishAot, R2R keeps full IL/metadata and reflection
    working exactly as today (it only adds pre-JITted native code alongside the IL as a fast path,
    with normal JIT as the fallback) — it does not carry the trimming risk the paragraph above
    documents. This targets a real, measured cause of "packaged EXE feels slow to open": a
    self-contained, non-R2R publish must JIT Avalonia/Skia/HarfBuzz/the app's own assemblies from
    IL on every cold start, before any composition-root/DB work (which Phase 13A/15D profiling
    both measured at low-single-digit milliseconds) even begins. Verified in this environment: a
    self-contained win-x64 publish with this flag set succeeds (the win-x64 crossgen2
    cross-compilation tool pack restores via NuGet from a non-Windows host) and produces valid
    win-x64 assemblies (~7% larger publish output — Desktop.dll 3.3MB vs 2.2MB unmodified). Actual
    wall-clock time-to-first-window improvement on Windows is NOT verified in this environment (no
    Windows host available) — see docs/phase13-hardening.md's Phase 15D
    section for the full measurement/reasoning and the 15F Windows validation item this leaves
    behind.
  -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Carowinds.Passdown.Application\Carowinds.Passdown.Application.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Infrastructure\Carowinds.Passdown.Infrastructure.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Documents\Carowinds.Passdown.Documents.csproj" />
  </ItemGroup>
</Project>
