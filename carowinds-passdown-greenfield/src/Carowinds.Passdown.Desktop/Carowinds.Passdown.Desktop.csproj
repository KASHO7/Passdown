<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Phase 13G: the approved app icon, embedded into the published .exe's icon resource (Windows
         Explorer/taskbar) and reused as the Avalonia window icon (Views/MainWindow.axaml). One
         canonical source asset (Assets/logo.ico), not a separate icon per surface. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Phase 7A release publish target: win-x64, self-contained, normal (non-single-file) publish
    directory. PublishSingleFile/PublishTrimmed/PublishAot are deliberately left at their SDK
    defaults (all false) rather than set explicitly here — Avalonia's reflection-based XAML
    loading, plus native SkiaSharp/HarfBuzzSharp/e_sqlite3 dependencies, make trimming/AOT a real
    correctness risk for no proven benefit, and a normal publish directory is easier to
    troubleshoot on a nontechnical user's machine. See docs/release-strategy.md for the full
    rationale and the exact publish command (packaging/windows/Publish-Windows.ps1).
  -->

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Carowinds.Passdown.Application\Carowinds.Passdown.Application.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Infrastructure\Carowinds.Passdown.Infrastructure.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Documents\Carowinds.Passdown.Documents.csproj" />
  </ItemGroup>
</Project>
