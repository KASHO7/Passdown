<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Carowinds.Passdown.Application\Carowinds.Passdown.Application.csproj" />
    <ProjectReference Include="..\Carowinds.Passdown.Domain\Carowinds.Passdown.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProductCardHtmlParser (Phase 3F1) has no adapter yet to exercise it indirectly through,
         unlike the JSON DTOs other sources keep internal — tests need direct access. -->
    <InternalsVisibleTo Include="Carowinds.Passdown.Infrastructure.Tests" />
  </ItemGroup>
  <!--
    Phase 7B: Microsoft.Playwright was removed (docs/release-strategy.md "Playwright dependency
    decision"). Every currently-implemented source adapter is DirectApi or Html strategy; the
    package contributed no working feature but added ~88 MB of Windows Node driver content to
    every publish (verified via a real dotnet publish in Phase 7A). See
    Retrieval/Browser/UnavailableJobBrowserSession.cs for the IJobBrowserSessionFactory
    replacement that keeps the abstraction/contract intact for a future browser-backed source.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <!--
    Phase 33: PDFium (BSD-3-Clause; NuGet packaging by bblanchon/pdfium-binaries, Apache-2.0) renders
    the application's own generated Passdown PDF bytes for the live preview and for Windows printing.
    Native, offline, no network or web renderer. Only the host RID's native library is copied by a
    RID-specific (win-x64) publish; the macOS/Linux packages exist so tests and local development on
    the Fedora/macOS hosts exercise the same renderer. See docs/phase33-live-pdf-preview-printing.md.
  -->
  <PropertyGroup>
    <PdfiumVersion>159.0.8138</PdfiumVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="$(PdfiumVersion)" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="$(PdfiumVersion)" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="$(PdfiumVersion)" />
  </ItemGroup>
</Project>
